{
  "nodes": [
    "\u07fd\u0b42\u07bb\u02fe\u074a\u066b\u07fe\u0a4c\u07bb\u00a3\u074a\u088f\u07fe\u0366\u07bb\u02ff\u074b\u0a84\u07fe\u09c5\u07bb\u0300\u074c\u05ff\u07ff\u0983\u07bb\u00a3\u074c\u0362\u07ff\u0b3a\u07bb\u0092\u074b\u073f\u07ff\u0703\u07bb\u00ae\u074a\u0ad2\u0816\u02fe\u07bb\u033b\u0749\u0943\u0817\u05ce\u07ba\u0b56\u074a\u035e\u0818\u081f\u07ba\u0b58\u0749\u09b4\u0818\u0344\u07ba\u09c8\u0749*\u0818\u08f5\u07ba\u09c9\u0748\u0616\u0819\u06df\u07ba\u0aa9\u0748\u00b0\u0819\u073b\u07ba\u0a7d\u0748\u08ce\u0818\u0ac5\u07ba\u0a3a\u0749\u034d\u0818\u0a51\u07bb\u0338\u074a\u0a4e\u0819\u08cd\u07bb\u02fa\u074a\u0957\u0819\u085a\u07bb\u02fa\u0749\u0a81\u081b\u09cd\u07ba\u0b4f\u0749\u0a3f\u081b\u0982\u07ba\u0b55\u0748\u0a3e\u0819\u083d\u07ba\u0826\u0749\u0b70",
    "\u081b\u02e7\u07ba\u0826\u0749\u0ba1\u081b\u0089\u07ba\u08d6\u074b\u09e3\u081c\u0311\u07ba\u09c3\u074b\u088e\u081c\u0311\u07ba\u0b4f\u074a\u089a\u081c\u09d2\u07ba\u0b4f\u0749\u09cf\u081d\u0a3d\u07ba\u0b4f\u0749\u09e4\u081d\u09e5\u07ba\u0b55\u0748\u09e2\u081c\u09cb\u07bb\u0300\u0748\u09d5\u081e\u0afd\u07ba\u0a7d\u0748\u08f5\u081e\u0ad6\u07ba\u0826\u0749\u0b70\u081e\u05c6\u07ba\u0826\u074a:\u081e\u0613\u07ba\u08d6\u074b\u0a34\u081d\u05eb\u07ba\u09d8\u074b\u09b4\u081c\u09c3\u07ba\u09e2\u074c\u0738\u081b\u0b02\u07ba\u09c3\u074c\u0963\u081c\u0342\u07ba\u09c3\u07a6\u05f3\u081c\u05c1\u07ba\u0b4f\u07a7\u0530\u081d\u033c\u07ba\u0b4f\u07a7\u0325\u081d\u05c0\u07ba\u09c3\u07a6\u05a3\u081c\u0983\u07ba\u09c3\u07a6\u0589\u081d\u074a\u07ba\u09c3\u074c\u088b",
    "\u081d\u036a\u07ba\u0b4f\u074a\u0749\u081c\u09cb\u07ba\u0b42\u07a7\u0b50\u081b\u0a0d\u07ba\u0b4f\u07a7\u00a0\u081b]\u07ba\u09c3\u07a6\u087c\u0819\u0957\u07ba\u094f\u07a7\u05b3\u081b\u0b48\u07ba\u0836\u07a7\u0b52\u081c\u05b8\u07ba\u0826\u07a7\u0884\u081d\u05f4\u07ba\u0826\u07a7\u0991\u081d\u0891\u07ba\u083c\u07a7\u0b4c\u081e\u089f\u07ba\u0962\u07a6\u0afc\u081e\u0380\u07ba\u09c3\u07a6\u0883\u081d\u08f6\u07ba\u0b4f\u07a7\u031c\u081e\u088e\u07ba\u09c3\u07a6\u0326\u081f\u030b\u07ba\u08e8\u074c\u0317\u081f\u055d\u07ba\u0956\u07a7]\u081f\u0878\u07ba\u0a54\u07a6\u094a\u081f\u0ae5\u07ba\u0ac9\u07a7\u034a\u081f\u0981\u07ba\u0a83\u074c\u08d3\u0820\u058a\u07ba\u0aba\u074c\u03a2\u081f\u0982\u07bb\u0339\u074a\u09db\u081e\u0b4e\u07bb\u02fb\u074a\u08fb",
    "\u081e\u0b7b\u07bb\u02fa\u0749\u0af0\u0820\u0300\u07ba\u09c7\u0748\u087d\u0820\u0883\u07ba\u0b44\u0749\u088e\u081f\u0bc7\u07ba\u0b53\u0749\u0944\u081f\u0657\u07ba\u0a37\u0748\u09be\u0821\u05c3\u07ba\u0b78\u074a\u0488\u0822\u05a3\u07bb\u032b\u0749\u08ef\u0822\u0817\u07bb\u0353\u074a\u05f9\u0823\u0590\u07bb\u009e\u074a\u0b44\u0825\u0872\u07bb\u0301\u074a\u05ee\u0825\u0363\u07bb\u0300\u074b\u0889\u0823\u09e5\u07bb\u0302\u074c\u05fb\u0822\u0a80\u07bb\u00a3\u074c\u058c\u0822\u0363\u07bb\u0081\u07a6\u0605\u0821\u0820\u07bb\u0086\u07a6\u0321\u0820\u09cd\u07bb\u0088\u07a6\u055f\u0820\u05f4\u07bb\u02dd\u07a6\u0b59\u0821\u05ec\u07ba\u0a8e\u074b\u0b4c\u0820\u0b80\u07ba\u0ad6\u074b\u07bc\u0820\u0332\u07bb\u0088\u074b\u08d3\u0821\u059f\u07ba\u0b5a\u074a\u0bce",
    "\u0822\u065d\u07ba\u0bbd\u074b\u083a\u0816\u0355\u07bb\u0081\u07a6\u0613\u0816\u0b7a\u07bb\u0087\u07a6\u02f1\u0816\u0bca\u07ba\u0a92\u074b\u0a58\u0817\u0355\u07ba\u0b53\u074b)\u0817\u094d\u07bb\u0087\u07a6\u05ab\u0818\u0099\u07bb\u02e9\u07a6\u0b55\u0818\u05a0\u07bb\u0095\u074b\u0831\u0818\u0357\u07ba\u0a84\u074c\u06dc\u0819\u0091\u07ba\u09d2\u074c\u0654\u0819\u0a4c\u07ba\u08d8\u074c\u07fb\u0818\u0ad8\u07ba\u0ac1\u07a6\u065c\u0818\u0878\u07ba\u0acd\u07a7\u0652\u0817\u0b46\u07ba\u0af5\u07a7\u06d9\u07b4\u0b50\u07bc\u0afc\u07b5\u05cb\u07b3\u0336\u07bc\u0af7\u07b4\u0af1\u07b0\u0a5f\u07bc\u0ae2\u07b5\u02f7\u07b0\u05bb\u07bc\u087f\u07b6\u064f\u07b2\u0315\u07bc\u0880\u07b6\u0abe\u07b3\u05b5\u07bc\u087f\u07b6\u00bf\u07b5\u030a\u07bc\u0b01\u07b6\u0314",
    "\u07b5\u05cb\u07bc\u0ae5\u07b6\u0bbf\u07b5\u0a54\u07bc\u0ae5\u07b7\u008e\u07b5\u0ac8\u07bc\u0ae5\u07b7\u08ce\u07b3\u0bc6\u07bc\u0881\u07b6\u0894\u07b2\u0ada\u07bc\u0941\u07b7\u0364\u07b3\u0303\u07bc\u0941\u07b7\u0a47\u07b0\u064b\u07bc\u07b3\u07b7\u061a\u07b0\u0084\u07bc\u07af\u07b8\u009b\u07b0|\u07bc\u0941\u07b8\u0965\u07b0\u07b6\u07bc\u0941\u07b8\u0a50\u07b0\u0600\u07bc\u0a3a\u07bb\u0488\u07b2\u0333\u07bc\u09fd\u07bb\u0bce\u07b2\u09c5\u07bc\u0a12\u07bc\u08f3\u07b3\u0089\u07bc\u09fd\u07bb\u0bcb\u07b2\u09c9\u07bc\u0a12\u07bb\u060e\u07b0\u05cf\u07bc\u0a3b\u07bc\u0add\u07af\u0965\u07bc\u0a3a\u07bc\u00a4\u07af\u0a45\u07bc\u0a3a\u07bb\u086b\u07b0\u02f9\u07bc\u0a47\u07bb\u0bbf\u07b0\u09c0\u07bb\u0bce\u07bc\u0085\u07b4\u030c\u07bc:\u07bc]",
    "\u07b4\u0328\u07bc:\u07bb\u0611\u07b5\u0318\u07bc:\u07bb\u060d\u07b5\u0314\u07bc:\u07bc\u081f\u07b4\u0362\u07bc:\u07bc\u0880\u07b4\u0348\u07bc\u0346\u07ba\u088e\u07b5\u0826\u07bc\u07af\u07ba\u060e\u07b6\u05f5\u07bc\u07af\u07ba\u0bca\u07b6\u05fd\u07bc\u07af\u07ba\u05c6\u07b6\u09b3\u07bc\u07af\u07ba\u038b\u07b6\u08e2\u07bc\u07af\u07b9\u0618\u07b5\u06d8\u07bc\u07af\u07b9\u058e\u07b5\u0604\u07bc\u07af\u07b9\u0a4d\u07b3\u05a4\u07bc\u07af\u07b9\u0a00\u07b3\u0483\u07bc\u07af\u07b8\u070a\u07b2\u07a9\u07bc\u07af\u07b8\u0a3b\u07b2\u086b\u07bc\u07af\u07b9\u0a76\u07b2\u060e\u07bc\u0651\u07ba\u088e\u07b2\u06d8\u07bc\u05a3\u07bb\u05c4\u07b0\u0612\u07bb\u0bce\u07bb\u05b4\u07b0\u060b\u07bb\u0bce\u07bb\u0a12\u07b0\u02d5\u07bc\u0a47\u07bc\u0093",
    "\u07b0\u0650\u07bb\u0bce\u07bc\u0383\u07b0~\u07bc\u0a3a\u07bb\u0b7e\u07b5\u07fe\u07bc\u087f\u07b8\u0353\u07b6\u05b9\u07bc\u0941\u07b8\u055d\u07b6\u0593\u07bc\u0bbd\u07b9\u03f6\u07b4\u05a0\u07bc\u087f\u07b7\u0bc0\u07b2\u0558\u07bc\u07af\u07b9\u037e\u07b2\u0385\u07bc\u09d9\u07b9\u0ac9\u07b0\u0833\u07bc\u0a3b\u07b9\u0bc2\u07b0\u07a8\u07bc\u0a3b\u07be\u02f7\u07b2\u05a3\u07bc\u09d9\u07be\u0316\u07b2\u0593\u07bc\u07af\u07be\u0a12\u07b0\u07be\u07bc\u0941\u07bf\u034f\u07b2\u05b7\u07bc\u07af\u07bf\u03a2\u07b3\u03a2\u07bc\u07af\u07bf\u059e\u07b3\u034d\u07bc\u07af\u07be\u034a\u07b2\u085a\u07bc\u07af\u07be\u060a\u07b5\u05f6\u07bc\u07af\u07be\u033c\u07b5\u07ab\u07bc\u07af\u07bd\u07ae\u07b4\u05aa\u07bc\u0346\u07bd\u061a\u07b3\u009e\u07bc\u0651\u07bd\u082e",
    "\u07b2\u0654\u07bc\u0651\u07bd\u07f1\u07b2\u06e0\u07bc\u05a3\u07bc\u0902\u07b0\u0748\u07bb\u0bcd\u07bc\u09c5\u07b3\u0357\u07bc\u0651\u07ba\u0874\u07b6\u05a8\u07bc\u0829\u07bb\u0bbb\u07b4\u08f6\u07bc\u082b\u07bb\u0bd2\u07b6\u0599\u07bc\u07af\u07bd\u008f\u07b6\u06df\u07bc\u07af\u07bd\u0981\u07b6\u0ac1\u07bc\u07af\u07be\u0329\u07b6\u0337\u07bc\u07af\u07be\u09b4\u07b5\u06e0\u07bc\u07af\u07be\u09c1\u07b5\u0707\u07bc\u087f\u07bf\u0947\u07b6\u05b2\u07bc\u0941\u07bf\u093a\u07b6\u05ed\u07bc\u0bbd\u07be\u0ac8\u07b4\u02c5\u07bc\u087f\u07eb\u00ab\u07b4\u0314\u07bc\u0880\u07ec\u0a11\u07b2\u0ab1\u07bc\u0941\u07eb\u0957\u07b3\u02f0\u07bc\u0941\u07eb\u0354\u07b5\u0321\u07bc\u0aff\u07ec\u0ab1\u07b4\u0ad3\u07bc\u0af7\u07ed\u0ac7\u07b3\u0385\u07bc\u0af5\u07ee\u0314",
    "\u07b0\u0a63\u07bc\u0ade\u07ee\u034e\u07b0\u05bd\u07bc\u087f\u07ec\u0885\u07b2\u0096\u07bc\u0881\u07ec\u0322\u07b0\u0610\u07bc\u07af\u07eb\u0619\u07b0 \u07bc\u07af\u07bf\u0af3\u07b0\u0095\u07bc\u0941\u07bf\u0366\u07b3\u05a0\u07bc\u087f\u07ec\u0ac5\u07b5\u05a7\u07bc\u0ae5\u07ec\u00b1\u07b5\u0a65\u07bc\u0ae5\u07eb\u0b40\u07b5\u0ad7\u07bc\u0ae5\u07eb\u05ac\u07b6\u05be\u07bb\u0bc6\u07bc\u08e3\u07b6\u08ff\u07bb\u0bd5\u07bc \u07b7\u0366\u07bb\u0b29\u07bc#\u07b6\u05f5\u07bb\u0bbf\u07bb\u0657\u07b6\u0605\u07bc \u07ba\u0a11\u07b7\u0837\u07bc\u02dc\u07ba\u0902\u07b7\u070b\u07bc\u05a3\u07b9\u0abb\u07b6\u09d3\u07bc\u07af\u07b9\u0ac8\u07fc\u0882\u07eb\u07f1\u07f8\u09c0\u07fe\u07fe\u07eb\u05ce\u07f8\u008e\u07ff\u02fc\u07eb\u05cf\u07f7\u09cf",
    "\u07ff\u0613\u07eb\u05bb\u07f8\u0097\u07ff\u0a62\u07eb\u055e\u07f7\u0a44\u07ff\u08f5\u07eb\u055e\u07f7\u055f\u07ff\u08d7\u07eb\u055e\u07f6\u0953\u0816\u0acc\u07eb\u08f0\u07f6\u0384\u0817\u058d\u07eb\u08ef\u07f7\u05ec\u0816\u083d\u07eb\u073b\u07f7\u08f5\u0816\u0a3c\u07eb\u073b\u07f8\u0378\u0817\u07fb\u07eb\u055c\u07f8\u0087\u0817\u09be\u07eb\u055f\u07f9\u06dd\u0818\u008a\u07eb\u0483\u07f7\u0954\u0818\u061a\u07eb\u00a3\u07f9\u0351\u0818\u082c\u07eb\u00b4\u07f9\u0a49\u0819\u0731\u07eb\u058e\u07f9\u0a57\u081b\u05c7\u07eb\u058e\u07fb\u0899\u081c\u07aa\u07eb\u058e\u07f9\u0a01\u081d\u06d8\u07eb\u009f\u07f9\u0946\u081e\u05cd\u07bf\u0b9b\u07fb\u09d5\u0820\u02f5\u07eb\u034e\u07fb\u09c9\u081f\u0bac\u07eb\u0333\u07fc\u05c8\u081f\u008e\u07eb\u060b\u07fc\u037e",
    "\u081e\u09de\u07eb\u060b\u07fc\u09e2\u081d\u0a34\u07eb\u0330\u07fc\u0a54\u081c\u0a76\u07bf\u0bbc\u07fd\u070e\u081b\u0602\u07eb\u00ab\u07fd\u06ed\u081b\u065c\u07eb\u032b\u07fc\u09b5\u0819\u0ad6\u07eb\u032c\u07fc\u05f8\u081b\u0a5f\u07eb\u032c\u07fc\u0385\u0818\u085a\u07bf\u0bbb\u07fc\u0383\u0819\u00a2\u07bf\u0bbb\u07fd\u05ce\u0817\u0b97\u07eb\u0330\u07fc\u0ae4\u0816\u0a0e\u07eb\u060b\u07fc\u09b3\u0816\u088a\u07eb\u060b\u07fc\u036c\u07ff\u08d2\u07eb\u0336\u07fc\u05b9\u07fd\u09b3\u07eb\u055c\u07fc\u06da\u07fb\u0b9d\u07eb\u0711\u07fc\u05bd\u07fb\u0b55\u07eb\u06d8\u07fb\u00ab\u07fc\u02f7\u07eb\u07ab\u07f8\u0bce\u07fc\u0ad3\u07eb\u073b\u07f9\u06d6\u07fd`\u07eb\u05eb\u07f9\u0b9b\u07fd\u0b34\u07eb\u0379\u07f9\u0adb\u07fd\u088e\u07eb\u05c1\u07f8\u0601",
    "\u07ff\u0082\u07eb\u0484\u07f8\u0b9b\u07ff\u0832\u07eb\u0384\u07f9)\u0816.\u07eb\u073b\u07fb!\u0816\u0901\u07eb\u073e\u07f9\u09f2\u0816\u0ae2\u07eb\u060b\u07fb\u09e3\u0817\u0380\u07eb\u073b\u07f9\u0873\u07ff\u088d\u07eb\u058b\u07f8\u089a\u0817\u09da\u07eb\u02d9\u07f6\u0ae5\u0816\u0ad3\u07eb\u02fc\u07f6\u0a52\u0819\u034b\u07bf\u0bba\u07f6\u07b2\u0819\u03f6\u07bf\u0bba\u07f7\u0657\u0819\u05ab\u07bf\u0bba\u07f6\u0095\u0819\u0ac7\u07bf\u0bba\u07f6\u0300\u081b\u065d\u07eb\u0082\u07f6\u09c1\u081c\u02fb\u07bf\u0bba\u07f6\u02c3\u081c\u0821\u07bf\u0bba\u07f6\u02e6\u081c\u083e\u07bf\u0bba\u07f6\u085a\u081d\u088f\u07eb\u00b1\u07f6\u083d\u081e\u070c\u07eb\u02f9\u07f7\u02e5\u081e\u0a61\u07eb\u02f9\u07f6\u0a44\u0820\u02ff\u07eb\u055c\u07f7\u0601",
    "\u0820(\u07eb\u055c\u07f7\u0b43\u0820\u0732\u07eb\u05b5\u07f8\u00a9\u081f\u0b8b\u07eb\u055c\u07f6\u0970\u081e\u0b01\u07eb\u08ee\u07f6\u0595\u081e\u073e\u07eb\u08ef\u07f7\u0601\u081f\u0334\u07eb\u073b\u07f7\u08f6\u081e\u0ba1\u07eb\u073b\u07f8\u0349\u081e\u035f\u07eb\u058a\u07f8\u02e7\u081e,\u07eb\u055f\u07f9\u05c2\u081d\u0970\u07eb\u0484\u07f7\u0b3c\u0820\u0bd1\u07eb\u065e\u07f7\u08de\u0821\u05b2\u07eb\u05c9\u07f8\u00ab\u0820\u070e\u07eb\u0384\u07f8\u0b3f\u081e\u0827\u07eb\u073b\u07f9\u0837\u081f\u02d8\u07eb\u073c\u07f9\u0a3e\u081e\u0b3e\u07eb\u060b\u07fb\u0a63\u081f\u09d7\u07eb\u073b\u07fb\u0086\u0820\u0094\u07eb\u0558\u07f9@\u0820\u0946\u07eb\u036e\u07f9\u0b47\u0821\u0bbd\u07eb\u055d\u07fc\u0384\u0822\u09b4\u07eb\u05b0\u07fc\u081b",
