rule: "99  hero ultimate adjustments"
Event.OngoingPlayer
Team.Team1
if (IsUsingUltimate(EventPlayer()) == true)
{
    if (HeroOf(EventPlayer()) == Hero.Ashe)
    {
        SetDamageDealt(EventPlayer(), 300);
        Wait(10, WaitBehavior.IgnoreCondition);
        SetDamageDealt(EventPlayer(), 100);
    }
    else if (HeroOf(EventPlayer()) == Hero.Widowmaker)
    {
        SetDamageDealt(AllPlayers(Team.Team1), 300);
        Wait(12.5, WaitBehavior.IgnoreCondition);
        SetDamageDealt(AllPlayers(Team.Team1), 100);
    }
    else if (HeroOf(EventPlayer()) == Hero.Symmetra)
    {
        AddHealthPoolToPlayer(AllLivingPlayers(Team.Team1), HealthType.Health, 200, false, true);
        Wait(12.5, WaitBehavior.IgnoreCondition);
        RemoveHealthPoolFromPlayer(LastCreatedHealthPool());
    }
    else if (HeroOf(EventPlayer()) == Hero.Junkrat)
    {
        SetStatus(EventPlayer(), null, Status.PhasedOut, 10);
    }
    else if (HeroOf(EventPlayer()) == Hero.Mercy)
    {
        Resurrect(AllDeadPlayers(Team.Team1));
    }
    else if (HeroOf(EventPlayer()) == Hero.Zenyatta)
    {
        SetStatus(EventPlayer(), null, Status.PhasedOut, 6);
    }
    else if (HeroOf(EventPlayer()) == Hero.Cassidy)
    {
        SetGravity(EventPlayer(), 0);
        WaitUntil(false, 7);
        SetGravity(EventPlayer(), 100);
    }
    else if (HeroOf(EventPlayer()) == Hero.Lucio)
    {
        AddHealthPoolToPlayer(AllLivingPlayers(Team.Team1), HealthType.Health, 500, false, false);
        Wait(10, WaitBehavior.IgnoreCondition);
        RemoveAllHealthPoolsFromPlayer(AllLivingPlayers(Team.Team1));
    }
}

