rule: "enable/toggle fall damage regular"
Event.OngoingPlayer
if (IsInAir(EventPlayer()) == true)
if (IsUsingAbility1(EventPlayer()) == false)
if (IsUsingAbility2(EventPlayer()) == false)
if (IsUsingUltimate(EventPlayer()) == false)
