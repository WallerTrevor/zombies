rule: "Initial Player"
Event.OngoingPlayer
{
    filterpos = false;
    lastsavedpos = false;
    closestbodypos = false;
    fullbodypos = false;
    prevpos_intersection = false;
    active_wall = [];
    closestwall = [];
}

rule: "Collision Logic"
Event.OngoingPlayer
Team.Team1
if (IsAlive(EventPlayer()) == true)
if (start == 1)
if (IsDummyBot(EventPlayer()) == false)
if (IsTrueForAny(firstpos, [DistanceBetween(ArrayElement(), EventPlayer()) < 10]) == true)
{
    if (teleporterused == 1)
    {
        WaitUntil(teleporterused == 0, 999999995904);
        Wait(1.5, WaitBehavior.IgnoreCondition);
    }
    if (outofpsawn == 0)
    {
        WaitUntil(outofpsawn == 1, 999999995904);
        Wait(1.5, WaitBehavior.IgnoreCondition);
    }
    lastsavedpos = (EyePosition(EventPlayer()) + PositionOf(EventPlayer())) / 2;
    Wait(0.16 + 0.32 * ServerLoadPeak() / 255 + SlotOf(EventPlayer()) * 0.016, WaitBehavior.IgnoreCondition);
    WaitUntil(Max(ServerLoadAverage(), ServerLoad()) < 245, 0.5);
    closestwall = FilteredArray(AllPos, DistanceBetween(AllPos[CurrentArrayIndex()], EventPlayer()) <= DistanceBetween(AllPos[CurrentArrayIndex()], firstpos[CurrentArrayIndex()]) || active_wall[CurrentArrayIndex()] == 1 || DotProduct(DirectionTowards(ArrayElement(), lastsavedpos), AllDir[CurrentArrayIndex()]) > 0 != DotProduct(DirectionTowards(ArrayElement(), EventPlayer()), AllDir[CurrentArrayIndex()]) > 0);
    for (x_ = 0; CountOf(closestwall); 1)
    {
        if (Wall_ID[z] == WallState.Open)
        {
            active_wall[z] = 0;
            # needs to use gamemode wide movement speed, when player gets perks
            SetMoveSpeed(EventPlayer(), 100);
        }
        z = IndexOfArrayValue(AllPos, closestwall[x_]);
        if (Wall_ID[z] == WallState.Closed)
        {
            if (YOf(firstpos[z]) >= YOf(PositionOf(EventPlayer())) && YOf(firstpos[z]) <= YOf(EyePosition(EventPlayer()) + Vector(0, 0.2, 0)))
            {
                closestbodypos = firstpos[z];
            }
            else if (YOf(secondpos[z]) >= YOf(PositionOf(EventPlayer())) && YOf(secondpos[z]) <= YOf(EyePosition(EventPlayer()) + Vector(0, 0.2, 0)))
            {
                closestbodypos = secondpos[z];
            }
            else
            {
                closestbodypos = PositionOf(EventPlayer());
            }
            fullbodypos = Vector(XOf(EyePosition(EventPlayer())), YOf(closestbodypos), ZOf(EyePosition(EventPlayer())));
            filterpos = fullbodypos + AllDir[z] * DotProduct(AllPos[z] - fullbodypos, AllDir[z]) / DotProduct(AllDir[z], AllDir[z]);
            if (DotProduct(DirectionTowards(AllPos[z], lastsavedpos), AllDir[z]) > 0 != DotProduct(DirectionTowards(AllPos[z], fullbodypos), AllDir[z]) > 0)
            {
                intersection_length = DotProduct(AllPos[z] - fullbodypos, AllDir[z]) / DotProduct(DirectionTowards(lastsavedpos, fullbodypos), AllDir[z]);
                prevpos_intersection = fullbodypos + DirectionTowards(lastsavedpos, fullbodypos) * Vector(1, 1, 1) * intersection_length;
                if (DotProduct(DirectionTowards(firstpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(firstpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(firstpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(secondpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(secondpos[z], prevpos_intersection)) >= 0)
                {
                    CancelPrimaryAction(EventPlayer());
                    Teleport(EventPlayer(), prevpos_intersection + DirectionTowards(prevpos_intersection, lastsavedpos) * Vector(1, 0, 1) * 2);
                }
            }
            if (DistanceBetween(fullbodypos, filterpos) <= 4 && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(firstpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(firstpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(secondpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(secondpos[z], filterpos)) >= 0)
            {
                if (active_wall[z] == false)
                {
                    active_wall[z] = 1;
                    if (is_Grounded == false)
                    {
                        SetGravity(EventPlayer(), 100);
                    }
                }
                ApplyImpulse(EventPlayer(), DirectionTowards(filterpos, fullbodypos) * Vector(1, 0, 1), 1, Relative.ToWorld, ContraryMotion.Cancel);
                if (doorNotif == 0)
                {
                    doorNotif = 1;
                }
                if (IsButtonHeld(EventPlayer(), Button.Interact) && points >= 1000 * costmultiplier - creditcardlimit)
                {
                    PlayEffect(AllPlayers(Team.All), PlayEffect.GoodExplosion, Color.White, AllPos[z], 50);
                    PlayEffect(AllPlayers(Team.All), PlayEffect.LucioSoundBarrierCastSound, Color.White, AllPos[z], 100);
                    points -= RoundToInteger(1000 * costmultiplier * cashback, Rounding.Nearest);
                    doorsToOpen = zoneDoors[currentZone];
                    for (i = 0; CountOf(doorsToOpen); 1)
                    {
                        z = doorsToOpen[i];
                        if (Wall_ID[z] == WallState.Closed)
                        {
                            DestroyDoorEffects(z);
                            Wall_ID[z] = WallState.Open;
                            active_wall[z] = 0;
                        }
                    }
                    SmallMessage(EventPlayer(), "Zone bought!");
                    doorNotif = 0;
                    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
                    MinWait();
                    SetMoveSpeed(EventPlayer(), 100);
                }
                SetMoveSpeed(EventPlayer(), 100 - DotProduct(DirectionTowards(EyePosition(EventPlayer()), EyePosition(EventPlayer()) + WorldVectorOf(ThrottleOf(EventPlayer()), EventPlayer(), LocalVector.Rotation)), DirectionTowards(filterpos, fullbodypos) * -1) * 100);
            }
            else
            {
                active_wall[z] = 0;
                # needs to use gamemode wide movement speed, when player gets perks
                SetMoveSpeed(EventPlayer(), 100);
            }
        }
    }
    LoopIfConditionIsTrue();
}

rule: "Make door arrays"
if (start == 1)
if (doormade == 0)
{
    i = 0;
    Wait(5, WaitBehavior.IgnoreCondition);
    looping = 0;
    doorParams = FirstOf(twoDnumbersArray2);
    Beameffectdoors = [];
    while (i < CountOf(doorVectors))
    {
        if (!(i % 2))
        {
            MinWait();
        }
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, doorVectors[i]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping] + Up() * doorParams[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, doorVectors[i] + Up() * doorParams[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping]);
        # if boolean is false, then use infinite height
        if (doorParams[looping + 3] == 0 || doorParams[looping + 3] == 1)
        {
            ModifyVariable(firstpos, Operation.AppendToArray, doorVectors[i]);
            if (doorParams[looping + 3] == 0)
            {
                ModifyVariable(secondpos, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping] + Vector(0, 50, 0));
                ModifyVariable(firstpoint2, Operation.AppendToArray, doorVectors[i] + Vector(0, 50, 0));
                ModifyVariable(secondpoint2, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping]);
            }
            else
            {
                ModifyVariable(secondpos, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping + 4] + Up() * doorParams[looping + 5]);
                ModifyVariable(firstpoint2, Operation.AppendToArray, doorVectors[i] + Up() * doorParams[looping + 5]);
                ModifyVariable(secondpoint2, Operation.AppendToArray, doorVectors[i] + DirectionFromAngles(doorParams[looping + 2] - 90, 0) * doorParams[looping + 4]);
            }
            ModifyVariable(AllPos, Operation.AppendToArray, (firstpos[i] + secondpos[i]) / 2);
            ModifyVariable(AllDir, Operation.AppendToArray, DirectionFromAngles(doorParams[looping + 2] + 180, 0));
        }
        if (doorParams[looping + 3] == 1)
        {
            looping += 6;
        }
        else
        {
            looping += 4;
        }
        i += 1;
    }
    # for i in range(len(firstpos)):
    doormade = 1;
}

rule: "Reset door notif"
Event.OngoingPlayer
if (doorNotif == 1)
{
    SmallMessage(EventPlayer(), <"Hold <0> to buy zone - cost: <1>", InputBindingString(Button.Interact), RoundToInteger(1000 * costmultiplier, Rounding.Nearest)>);
    Wait(4, WaitBehavior.IgnoreCondition);
    doorNotif = 0;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "destroy all door effects on teleporter use"
