    MinWait();
    # Cannon 3
    CreateDummyBot(Hero.WreckingBall, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
    Wait(1, WaitBehavior.IgnoreCondition);
    AttachPlayers(LastCreatedEntity(), FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Vector(-2.15, 5.4, 1));
    LastCreatedEntity().Part = "Cannon";
    StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
    MinWait();
    # Machine gun 1
    CreateDummyBot(Hero.Bastion, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
    Wait(1, WaitBehavior.IgnoreCondition);
    AttachPlayers(LastCreatedEntity(), FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Vector(2, 3, 1));
    LastCreatedEntity().Part = "Machine gun";
    StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
    MinWait();
    # Machine gun 2
    CreateDummyBot(Hero.Bastion, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
    Wait(1, WaitBehavior.IgnoreCondition);
    AttachPlayers(LastCreatedEntity(), FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Vector(-2, 3, 1));
    LastCreatedEntity().Part = "Machine gun";
    AddHealthPoolToPlayer(EventPlayer(), HealthType.Armor, 9999, true, true);
    StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
    WaitUntil(IsDead(EventPlayer()), 99999);
    RemoveAllHealthPoolsFromPlayer(EventPlayer());
}

