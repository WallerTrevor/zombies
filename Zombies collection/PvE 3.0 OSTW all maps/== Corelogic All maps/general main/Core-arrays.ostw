    Wait(0.25, WaitBehavior.IgnoreCondition);
    heroDamageHeroes = [Hero.Anran, Hero.Ashe, Hero.Bastion, Hero.Cassidy, Hero.Echo, Hero.Emre, Hero.Freja, Hero.Genji, Hero.Hanzo, Hero.Junkrat, Hero.Mei, Hero.Pharah, Hero.Reaper, Hero.Sojourn, Hero.Soldier76, Hero.Sombra, Hero.Symmetra, Hero.Torbjorn, Hero.Tracer, Hero.Vendetta, Hero.Venture, Hero.Widowmaker];
    Wait(0.25, WaitBehavior.IgnoreCondition);
    herotankHeroes = [Hero.Domina, Hero.Dva, Hero.Doomfist, Hero.Hazard, Hero.JunkerQueen, Hero.Mauga, Hero.Orisa, Hero.Ramattra, Hero.Reinhardt, Hero.Roadhog, Hero.Sigma, Hero.Winston, Hero.WreckingBall, Hero.Zarya];
    Wait(0.25, WaitBehavior.IgnoreCondition);
    heroSupportHeroes = [Hero.Ana, Hero.Baptiste, Hero.Brigitte, Hero.Illari, Hero.JetpackCat, Hero.Juno, Hero.Kiriko, Hero.Lifeweaver, Hero.Lucio, Hero.Mercy, Hero.Mizuki, Hero.Moira, Hero.Wuyang, Hero.Zenyatta];
    Wait(0.25, WaitBehavior.IgnoreCondition);

    WaitUntil(mapDataLoaded == true && pfMapReady == true && zoneLoading == false, 90);
    WaitUntil(mapDataLoaded == true, 60);

    infoDecoding = true;
    decodeIn = import("Core-compressed.json").texts.infoText.data;
    decompressTextSub();
    infoText = decodeOut;
    infoDecoding = false;
    decodeIn = import("Core-compressed.json").texts.tipstrings.data;
    decompressTextSub();
    tipstrings = decodeOut;
    decodeIn = import("Core-compressed.json").texts.diedphrase.data;
    decompressTextSub();
    diedphrase = decodeOut;
    decodeIn = import("Core-compressed.json").texts.diedtext.data;
    decompressTextSub();
    diedtext = decodeOut;
    decodeIn = import("Core-compressed.json").texts.noammostrings.data;
    decompressTextSub();
    noammostrings = decodeOut;
    decodeIn = import("Core-compressed.json").texts.followerbuyMsg.data;
    decompressTextSub();
    followerbuyMsg = decodeOut;

    decodeIn = import("Core-compressed.json").texts.herobuymessages.data;
    decompressTextSub();
    herobuymessages = decodeOut;

    decodeIn = import("Core-compressed.json").texts.dialogueLines.data;
    decompressTextSub();
    dialogueLines = decodeOut;
    decodeIn = import("Core-compressed.json").texts.aprilQuoteLines.data;
    decompressTextSub();
    aprilQuoteLines = decodeOut;

    decodeIn = import("Core-compressed.json").texts.settingsText.data;
    decompressTextSub();
    settingsText = decodeOut;

    textListsLoaded = true;
}
