if (IsGameInProgress() == true)# needs a 3, for directors cut version, where each hero is on for 5 rounds then changes using a loop
{
    switch (spawntype)
    {
        case false:
            g = false;
            # needs a lot more types as well, since there will be the new addition, random, and legacy from 1.0
            bossSpawn = [null];
            # needs a way to make it so more than 1 wave boss can be spawned at once as well
            bot1spawn = [Hero.Brigitte];
            # need to make it so wave boss doesnt respawn after being killed
            bot2spawn = [Hero.Brigitte];
            # and need wave boss to spawn a 2nd or 3rd one if players are doing well
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 1:
            g = false;
            Wait(0.25, WaitBehavior.IgnoreCondition);
            bossSpawn = [null];
            bot1spawn = [Hero.Torbjorn];
            bot2spawn = [Hero.Torbjorn];
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 2:
            g = false;
            Wait(0.25, WaitBehavior.IgnoreCondition);
            if (roundnumber < 5)
            {
                bossSpawn = null;
                bot1spawn = hero[RandomInteger(0, 37)];
                bot2spawn = hero[RandomInteger(0, 37)];
                Wait(0.25, WaitBehavior.IgnoreCondition);
                wavespawn();
            }
            else if (roundnumber >= 5)
            {
                bossSpawn = hero[RandomInteger(0, 37)];
                bot1spawn = hero[RandomInteger(0, 37)];
                bot2spawn = hero[RandomInteger(0, 37)];
                Wait(0.25, WaitBehavior.IgnoreCondition);
                wavespawn();
            }
            break;

        case 3:
            bossSpawn = [null, Hero.Doomfist, Hero.Torbjorn, Hero.Reinhardt, Hero.Winston, Hero.Roadhog, Hero.JunkerQueen, Hero.Zenyatta, Hero.Mauga, Hero.Sombra, Hero.Mei, Hero.Reaper, Hero.Ramattra];
            bot1spawn = [Hero.Brigitte, Hero.Torbjorn, Hero.Torbjorn, Hero.Moira, Hero.Lucio, Hero.Torbjorn, Hero.Roadhog, Hero.Moira, Hero.Lucio, Hero.Mercy, Hero.JunkerQueen, Hero.Tracer, Hero.Doomfist];
            bot2spawn = [Hero.Brigitte, Hero.Brigitte, Hero.Reinhardt, Hero.Winston, Hero.Genji, Hero.Winston, Hero.Genji, Hero.Brigitte, Hero.Hanzo, Hero.Mauga, Hero.Dva, Hero.Echo, Hero.Sombra];
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 4:
            Wait(0.25, WaitBehavior.IgnoreCondition);
            totalrandomspawn();
            break;
    }
}

