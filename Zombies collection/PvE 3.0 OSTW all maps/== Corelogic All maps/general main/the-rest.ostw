rule: "48 WORKSHOP SETTINGS"
Event.OngoingPlayer
Team.Team1
if (HasSpawned(EventPlayer()) == true)
{
    Wait(3, WaitBehavior.IgnoreCondition);
    walljumpers = WorkshopSettingToggle("difficulty", "zombies jump with no colision", true, 0);
    healvariable = WorkshopSettingInteger("difficulty", "healing dealt", 25, 0, 500, 0);
    SetGravity(EventPlayer(), WorkshopSettingReal("fun", "gravity", 100, 25, 200, 0));
    Wait(3, WaitBehavior.IgnoreCondition);
    SetHealingDealt(EventPlayer(), healvariable);
    zombspeed = WorkshopSettingToggle("difficulty", "zombies speed varies", true, 0);
    zombstrafe = WorkshopSettingInteger("difficulty", "zombies strafe", 1, 0, 1, 0);
    zombjump = WorkshopSettingInteger("difficulty", "zombies jump", 1, 0, 1, 0);
    experiencesystem = WorkshopSettingToggle("fun", "experience system", false, 0);
    SkipIf(experiencesystem == false, 4);
    SetSecondaryFireEnabled(EventPlayer(), false);
    SetAbility1Enabled(EventPlayer(), false);
    SetAbility2Enabled(EventPlayer(), false);
    SetUltimateAbilityEnabled(EventPlayer(), false);
    idlebots = WorkshopSettingToggle("stability", "idle bots", false, 0);
    SetProjectileGravity(AllPlayers(Team.Team1), WorkshopSettingInteger("fun", "projectile gravity team 1", 100, 25, 500, 0));
    SetProjectileSpeed(AllPlayers(Team.Team1), WorkshopSettingInteger("fun", "projectile speed team 1", 100, 25, 500, 0));
    SetProjectileGravity(AllPlayers(Team.Team2), WorkshopSettingInteger("fun", "projectile gravity team 2", 75, 25, 500, 0));
    SetProjectileSpeed(AllPlayers(Team.Team2), WorkshopSettingInteger("fun", "projectile speed team 2", 50, 25, 500, 0));
    spawntype = WorkshopSettingInteger("difficulty", "brig=0 torb=1 random=2 directed=3 totalrng=4", 3, 0, 5, 0);
}

