
rule: "137  bots too far away"
Event.OngoingPlayer
Team.Team2
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(p_T < 2 ? AllLivingPlayers(Team.Team1) : [], ArrayElement()))) > 90)
{
    # good to keep but might need bigger radius when implementing pathfinding\ngood to make this 5+ seconds for teleporter maps
    Wait(6 + SlotOf(EventPlayer()) * 0.032, WaitBehavior.AbortWhenFalse);
    Teleport(EventPlayer(), NearestWalkablePosition(DirectionFromAngles(RandomReal(0, 360), RandomReal(-3, 3)) * RandomReal(20, 35) + PositionOf(FirstOf(AllLivingPlayers(Team.Team1)))));
}

rule: "402 Omnic movespeed + health"
Event.OngoingPlayer
Team.Team2
if (HasSpawned(EventPlayer()) == true)
{
    SetMaxHealth(EventPlayer(), 15 * roundnumber);
    SetMoveSpeed(EventPlayer(), roundnumber <= 6 ? 80 + 8 * roundnumber : 128);
}

rule: "17 Bots Under Player"
Event.OngoingPlayer
Team.Team2
if (VerticalFacingAngleOf(EventPlayer()) < -10)
if (pfDestination == null)
{
    Wait(0.25, WaitBehavior.AbortWhenFalse);
    pfDestination = PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))));
    Wait(3.5 + SlotOf(EventPlayer()) * 0.032, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "force no pathfinding when close"
Event.OngoingPlayer
Team.Team2
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 20)
if (IsInLineOfSight(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))), BarrierLOS.NoBarriersBlock) == true)
{
    # @Condition eventPlayer.pfIsPathfinding == false
    Wait(0.25, WaitBehavior.AbortWhenFalse);
    if (pfIsPathfinding == true)
    {
        pfIsPathfinding = false;
    }
    pfDestination = null;
    pfSavedTarget = null;
    pfPath = [];
    pfWait = null;
    pfWasBroadcasted = false;
    pfIsPathfinding = false;
    pfCurrentNodeIndex = -1;
    pfActiveNode = -1;
    pfWalkingToPosition = null;
    pfWalkingFromPosition = null;
    pfStartTime = 0;
    pfAttributes = [];
    pfopen = [];
    pfscores_gScore = [];
    pfscores_fScore = [];
    pfscores_parent = [];
    pfscores_nodeIndex = [];
    pfiter = 0;
    pfcurrent = -1;
    pfgoal = -1;
    pfStuckOnNode = -1;
    pfIsStuck = false;
    StopThrottleInDirection(EventPlayer());
    StopForcingThrottle(EventPlayer());
    Wait(0.1, WaitBehavior.IgnoreCondition);
    StartThrottleInDirection(EventPlayer(), DirectionTowards(PositionOf(EventPlayer()), PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))))), 1, Relative.ToWorld, ThrottleBehavior.ReplaceExistingThrottle, ThrottleRev.DirectionAndMagnitude);
}

rule: "use pathfinding"
Event.OngoingPlayer
Team.Team2
if (pfIsPathfinding == false)
if ((DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) >= 20 || !IsInLineOfSight(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))), BarrierLOS.NoBarriersBlock)) == true)
if ((pfDestination == null || DistanceBetween(pfDestination, PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))))) > 4) == true)
{
    Wait(0.25, WaitBehavior.AbortWhenFalse);
    StopForcingThrottle(EventPlayer());
    pfDestination = PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))));
    Wait(2.5 + SlotOf(EventPlayer()) * 0.032, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "use pathfinding if on wall"
Event.OngoingPlayer
Team.Team2
if (pfIsPathfinding == false)
if (SpeedOf(EventPlayer()) <= 0.7)
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) > 2)
if ((pfDestination == null || DistanceBetween(pfDestination, PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))))) > 4) == true)
{
    Wait(0.25, WaitBehavior.AbortWhenFalse);
    StopForcingThrottle(EventPlayer());
    pfDestination = PositionOf(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer()))));
    Wait(2.5 + SlotOf(EventPlayer()) * 0.032, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}


rule: "ã€PF Coreã€‘Prepare loaded map"
if (pfLoadedMap_nodes == true)
if (pfIterationsThisTick != -99)
{
    for (pfI1 = 0; CountOf(pfLoadedMap_nodes); 1)
    {
        pfLoadedMap_nodes[pfI1] = Vector(XOf(pfLoadedMap_nodes[pfI1]), RoundToInteger(YOf(pfLoadedMap_nodes[pfI1]), Rounding.Down) + pfI1 / 1000 * (YOf(pfLoadedMap_nodes[pfI1]) < 0 ? -1 : 1), ZOf(pfLoadedMap_nodes[pfI1]));
    }
}

rule: "ã€PF Coreã€‘Select next pathfinder"
if ((!EntityExists(pfExecOwner) || pfExecOwner == null) == true)
if (IsTrueForAny(AllPlayers(Team.All), IsAlive(ArrayElement()) && ArrayElement().pfWait) == true)
{
    pfExecOwner = FirstOf(SortedArray(FilteredArray(AllPlayers(Team.All), ArrayElement().pfWait), ArrayElement().pfWait));
    MinWait();
    LoopIfConditionIsTrue();
}

rule: "ã€PF Coreã€‘Update & Execute"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfDestination != null)
if (pfIsPathfinding == false)
if ((!pfSavedTarget || DistanceBetween(pfDestination, pfSavedTarget) > 5) == true)
{
    # Ensure that a map is loaded.
    if (!pfLoadedMap_nodes)
    {
        LogToInspector(<"Error: Attempted to pathfind player <0> without a loaded map.", EventPlayer()>);
        Abort();
    }
    pfWait = TotalTimeElapsed();
    pfWasBroadcasted = false;
    WaitUntil(pfExecOwner == EventPlayer() || pfWasBroadcasted, 99999);
    # Update saved destination
    pfSavedTarget = pfDestination;
    if (!pfWasBroadcasted)
    {
        pfgoal = RoundToInteger(AbsoluteValue(YOf(FirstOf(SortedArray(ArraySlice(SortedArray(pfLoadedMap_nodes, DistanceBetween(ArrayElement(), pfSavedTarget)), 0, 5), !IsInLineOfSight(ArrayElement() + Vector(0, 2, 0), pfSavedTarget + Vector(0, 2, 0), BarrierLOS.NoBarriersBlock))))) * 1000 % 1000, Rounding.Down);
        pfTick();
        if (pfIsPathfinding && pfCurrentNodeIndex != -1)
        {
            pfActiveNode = pfCurrentNodeIndex;
        }
        else
        {
            pfActiveNode = RoundToInteger(AbsoluteValue(YOf(FirstOf(SortedArray(ArraySlice(SortedArray(pfLoadedMap_nodes, DistanceBetween(ArrayElement(), PositionOf(EventPlayer()))), 0, 5), !IsInLineOfSight(ArrayElement() + Vector(0, 2, 0), PositionOf(EventPlayer()) + Vector(0, 2, 0), BarrierLOS.NoBarriersBlock))))) * 1000 % 1000, Rounding.Down);
            pfTick();
        }
        pfscores_gScore = [0];
        pfscores_fScore = [0];
        pfscores_parent = [-1];
        pfscores_nodeIndex = [pfgoal];
        pfopen = [0];
        pfcheckedNode = pfActiveNode;
        pfiter = 0;
        while (CountOf(pfopen) || pfiter > 30)
        {
            # The index of the current node in `scores`.
            pfcurrent = FirstOf(SortedArray(pfopen, pfscores_fScore[ArrayElement()]));
            if (pfcheckedNode != pfActiveNode)
            {
                pfcheckedNode = IndexOfArrayValue(pfscores_nodeIndex, pfActiveNode);
                if (pfcheckedNode != -1)
                {
                    pfcurrent = pfcheckedNode;
                    pfcheckedNode = -2;
                }
                else
                {
                    pfcheckedNode = pfActiveNode;
                }
            }
            pfcurrentInExistingPath = IndexOfArrayValue(pfPath, pfscores_nodeIndex[pfcurrent]);
            # If the goal was found, reconstruct the path.
            if (pfscores_nodeIndex[pfcurrent] == pfActiveNode || pfcheckedNode == -2 || pfcurrentInExistingPath != -1)
            {
                if (pfcurrentInExistingPath == -1)
                {
                    pfPath = [];
                }
                else
                {
                    pfPath = ArraySlice(pfPath, 0, pfcurrentInExistingPath);
                }
                while (pfcurrent != -1)
                {
                    ModifyVariable(pfPath, Operation.AppendToArray, pfscores_nodeIndex[pfcurrent]);
                    pfcurrent = pfscores_parent[pfcurrent];
                }
                ModifyVariable(pfPath, Operation.AppendToArray, [-1]);
                pfbroadcastTo = FilteredArray(PlayersWithinRadius(PositionOf(EventPlayer()) + Up(), 4, Team.All, RadiusLOS.Off), ArrayElement() != EventPlayer() && ArrayElement().pfWait && DistanceBetween(ArrayElement().pfDestination, pfDestination) < 4 && ArrayElement().pfPlayerAttributes == pfPlayerAttributes);
                pfbroadcastTo.pfPath = pfPath;
                pfbroadcastTo.pfWasBroadcasted = true;
                Skip(27);
            }
            ModifyVariable(pfopen, Operation.RemoveFromArrayByValue, pfcurrent);
            # Check each neighbor to the current node.
            for (pfneighbor = 0; CountOf(pfLoadedMap_neighbors[pfscores_nodeIndex[pfcurrent]]); 1)
            {
                # The neighbor index to be used like `pfLoadedMap.nodes[neighborI]`.
                pfneighborI = FirstOf(pfLoadedMap_neighbors[pfscores_nodeIndex[pfcurrent]][pfneighbor]);
                pfscoreIndex = IndexOfArrayValue(pfscores_nodeIndex, pfneighborI);
                # Ensure that the path to the neighbor is enabled.
                if (CountOf(pfLoadedMap_neighbors[pfscores_nodeIndex[pfcurrent]][pfneighbor][1]) == 0 || IsTrueForAny(pfLoadedMap_neighbors[pfscores_nodeIndex[pfcurrent]][pfneighbor][1], ArrayContains(pfPlayerAttributes, ArrayElement())))
                {
                    pfscore = pfscores_gScore[pfcurrent] + DistanceBetween(pfLoadedMap_nodes[pfscores_nodeIndex[pfcurrent]], pfLoadedMap_nodes[pfneighborI]);
                    # Get neighbor index in scores.\nIf -1, the neighbor was not added to the score list yet.
                    if (pfscoreIndex == -1)
                    {
                        ModifyVariable(pfopen, Operation.AppendToArray, CountOf(pfscores_gScore));
                        ModifyVariable(pfscores_gScore, Operation.AppendToArray, pfscore);
                        ModifyVariable(pfscores_fScore, Operation.AppendToArray, pfscore + DistanceBetween(pfLoadedMap_nodes[pfneighborI], pfLoadedMap_nodes[pfActiveNode]) * 20);
                        ModifyVariable(pfscores_parent, Operation.AppendToArray, pfcurrent);
                        ModifyVariable(pfscores_nodeIndex, Operation.AppendToArray, pfneighborI);
                    }
                    else if (pfscore < pfscores_gScore[pfscoreIndex])
                    {
                        pfscores_gScore[pfscoreIndex] = pfscore;
                        pfscores_fScore[pfscoreIndex] = pfscore + DistanceBetween(pfLoadedMap_nodes[pfneighborI], pfLoadedMap_nodes[pfActiveNode]) * 20;
                        pfscores_parent[pfscoreIndex] = pfcurrent;
                        pfscores_nodeIndex[pfscoreIndex] = pfneighborI;
                        if (!ArrayContains(pfopen, pfscoreIndex))
                        {
                            ModifyVariable(pfopen, Operation.AppendToArray, pfscoreIndex);
                        }
                    }
                }
                pfTick();
            }
            pfiter += 1;
        }
        pfExecOwner = null;
    }
    if (CountOf(pfPath))
    {
        pfIsPathfinding = true;
        pfCurrentNodeIndex = FirstOf(pfPath);
        pfWalkingToPosition = pfLoadedMap_nodes[pfCurrentNodeIndex];
        pfUpdateNodeMeta();
        pfWalkToDestination();
    }
    pfWait = null;
    Wait(2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "ã€PF Coreã€‘Node reached"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfIsPathfinding == true)
if (pfWalkingToPosition == true)
# Horizontal distance to current position is less than 0.4.
if (DistanceBetween(PositionOf(EventPlayer()) * Vector(1, 0, 1), pfWalkingToPosition * Vector(1, 0, 1)) <= 0.4)
# Vertical distance to current position is less than 1.5.
if (AbsoluteValue(YOf(PositionOf(EventPlayer())) - YOf(pfWalkingToPosition)) <= 1.5)
if (CountOf(pfPath) > 0)
if (pfCurrentNodeIndex != -1)
{
    pfProgressEventPlayer();
    Wait(0.2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "ã€PF Coreã€‘Stop pathfinding when the bot dies"
Event.OngoingPlayer
if (IsDead(EventPlayer()) == true)
if (pfIsPathfinding == true)
{
    StopThrottleInDirection(EventPlayer());
    pfIsPathfinding = false;
    pfSavedTarget = null;
    pfWait = null;
    pfWalkingToPosition = null;
}

rule: "ã€PF Coreã€‘Stop throttle when pfDestination is reset"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfIsPathfinding == true)
if (pfDestination == null)
{
    StopThrottleInDirection(EventPlayer());
    pfIsPathfinding = false;
    pfSavedTarget = null;
}

rule: "ã€PF Coreã€‘Insurance"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfIsPathfinding == true)
if (pfWalkingToPosition == true)
{
    # Smooth step
    if (CountOf(pfPath) == 2 && DistanceBetween(EventPlayer(), pfSavedTarget) < DistanceBetween(pfWalkingToPosition, pfSavedTarget) && IsInLineOfSight(PositionOf(EventPlayer()) + Vector(0, 0.25, 0), pfSavedTarget + Vector(0, 0.25, 0), BarrierLOS.NoBarriersBlock))
    {
        pfProgressEventPlayer();
    }
    else if (pfWalkingToPosition != pfDestination && pfCurrentNodeIndex == -1 && DistanceBetween(pfSavedTarget, pfDestination) < 5 && IsInLineOfSight(pfSavedTarget + Up(), pfDestination + Up(), BarrierLOS.NoBarriersBlock))
    {
        pfWalkingToPosition = pfDestination;
    }
    else if (DistanceBetween(EventPlayer(), pfWalkingToPosition) > 0.4 && !(!pfSavedTarget || DistanceBetween(pfDestination, pfSavedTarget) > 5) && (pfIsStuck || DistanceBetween(pfWalkingFromPosition, pfWalkingToPosition) - 4.95 * (TotalTimeElapsed() - pfStartTime) < 0) && !HasStatus(EventPlayer(), Status.Rooted) && !HasStatus(EventPlayer(), Status.Frozen) && !HasStatus(EventPlayer(), Status.Asleep) && !HasStatus(EventPlayer(), Status.KnockedDown) && !HasStatus(EventPlayer(), Status.Stunned))
    {
        if (pfStuckOnNode - 2 == pfCurrentNodeIndex)
        {
            LogToInspector(<"Pathfinder <0> struggled to reach node <1> at <2>. Try adjusting your map in the editor.", EventPlayer(), pfCurrentNodeIndex, pfLoadedMap_nodes[pfCurrentNodeIndex]>);
            Teleport(EventPlayer(), pfWalkingToPosition);
        }
        else
        {
            pfStuckOnNode = pfCurrentNodeIndex + 2;
            pfRecalibrate();
        }
    }
    Wait(2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "ã€PF Coreã€‘Recalibrate when off path"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfIsPathfinding == true)
if (pfWalkingToPosition == true)
if (DistanceBetween((pfWalkingFromPosition + pfWalkingToPosition) / 2, EventPlayer()) > (DistanceBetween(pfWalkingFromPosition, pfWalkingToPosition) + 4) * 1.2)
{
    pfRecalibrate();
}

rule: "ã€PF Coreã€‘Check throttle"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (pfIsPathfinding == true)
if (MagnitudeOf(VelocityOf(EventPlayer())) < 3)
{
    Wait(2.1, WaitBehavior.AbortWhenFalse);
    pfIsStuck = true;
    WaitUntil(!(pfWalkingToPosition && pfIsPathfinding) || MagnitudeOf(VelocityOf(EventPlayer())) >= 3, 99999);
    pfIsStuck = false;
}

