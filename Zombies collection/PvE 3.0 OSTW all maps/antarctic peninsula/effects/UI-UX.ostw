rule: "info UI cancel"
Event.OngoingPlayer
Team.Team1
if (extraVar[3] > 0)
{
    SkipIf(CountOf(InfoUI) == false, 5);
    DestroyHudText(InfoUI[CountOf(InfoUI) - 1]);
    ModifyVariable(InfoUI, Operation.RemoveFromArrayByIndex, CountOf(InfoUI) - 1);
    MinWait();
    LoopIf(CountOf(InfoUI) != 0);
    InfoCooldown = TotalTimeElapsed() + 5;
    Abort();
}

