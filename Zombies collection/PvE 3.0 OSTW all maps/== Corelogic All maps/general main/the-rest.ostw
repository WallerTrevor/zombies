rule: "Make door arrays"
if (extraVar[3] == 1)
if (doormade == 0)
{
    i = 0;
    Wait(5, WaitBehavior.IgnoreCondition);
    looping = 0;
    Beameffectdoors = [];
    while (i < CountOf(twoDvectorsArray[4]))
    {
        if (!(i % 2))
        {
            MinWait();
        }
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping] + Up() * FirstOf(twoDnumbersArray2)[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + Up() * FirstOf(twoDnumbersArray2)[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping]);
        # if boolean is false, then use infinite height
        if (FirstOf(twoDnumbersArray2)[looping + 3] == 0)
        {
            ModifyVariable(firstpos, Operation.AppendToArray, twoDvectorsArray[4][i]);
            ModifyVariable(secondpos, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping] + Vector(0, 50, 0));
            ModifyVariable(firstpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + Vector(0, 50, 0));
            ModifyVariable(secondpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping]);
            ModifyVariable(AllPos, Operation.AppendToArray, (firstpos[i] + secondpos[i]) / 2);
            ModifyVariable(AllDir, Operation.AppendToArray, DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] + 180, 0));
        }
        else if (FirstOf(twoDnumbersArray2)[looping + 3] == 1)
        {
            ModifyVariable(firstpos, Operation.AppendToArray, twoDvectorsArray[4][i]);
            ModifyVariable(secondpos, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping + 4] + Up() * FirstOf(twoDnumbersArray2)[looping + 5]);
            ModifyVariable(firstpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + Up() * FirstOf(twoDnumbersArray2)[looping + 5]);
            ModifyVariable(secondpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping + 4]);
            ModifyVariable(AllPos, Operation.AppendToArray, (firstpos[i] + secondpos[i]) / 2);
            ModifyVariable(AllDir, Operation.AppendToArray, DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] + 180, 0));
        }
        if (FirstOf(twoDnumbersArray2)[looping + 3] == 1)
        {
            looping += 6;
        }
        else
        {
            looping += 4;
        }
        i += 1;
    }
    # for i in range(len(firstpos)):
    doormade = 1;
}

