    Wait(2, WaitBehavior.IgnoreCondition);
    bankPoints += AllPlayers(Team.Team1).points * 0.75;
    outofpsawn = false;
    extraVar[0] = 0;
    extraVar[3] = false;
    romanNcounter = 1;
    extraVar[28] = 0;
    AllPlayers(Team.Team1).points = 0;
    extraVar[4] = false;
    AllPlayers(Team.Team1).creditcardlimit = 0;
    AllPlayers(Team.Team1).creditTier = 0;
    costmultiplier = 1;
    for (forindex = 0; 90; 1)
    {
        Wall_ID[forindex] = 1;
    }
}

