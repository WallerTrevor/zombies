rule: "teleporter numbers"
{
    extraVar[33] = 0;
    extraVar[34] = 37;
    extraVar[35] = 38;
    extraVar[36] = 71;
    extraVar[37] = 72;
    extraVar[38] = 110;
}

rule: "73 Headshot maniac Perk add damage"
Event.OnDamageDealt
Team.Team1
if (perk[3] == 1)
if (EventWasCriticalHit() == true)
if (damagevariable < 391)
{
    damagevariable += 10;
    SetDamageDealt(EventPlayer(), damagevariable);
}

rule: "74 headshot maniac Perk remove damage"
Event.OnDamageDealt
Team.Team1
# make it so this plays nicely with pack a punch
if (EventWasCriticalHit() == false)
if (damagevariable >= 55)
if (perk[3] == 1)
{
    damagevariable -= 2.5;
    SetDamageDealt(EventPlayer(), damagevariable);
}

rule: "jugg tier 2 and 3"
Event.OnDamageTaken
Team.Team1
if (perk[1] > 0)
{
    if (perk[1] == 2)
    {
        Wait(10, WaitBehavior.RestartWhenTrue);
        # need to make sure this doesnt stack infinitely
        AddHealthPoolToPlayer(EventPlayer(), HealthType.Health, 25, false, false);
    }
    else if (perk[1] == 3)
    {
        Wait(10, WaitBehavior.RestartWhenTrue);
        AddHealthPoolToPlayer(EventPlayer(), HealthType.Health, 50, false, false);
    }
}

rule: "give juggernaut perk max health"
Event.OngoingPlayer
Team.Team1
if (perk[1] == 1)
{
    SetMaxHealth(EventPlayer(), 200);
}

rule: "109 PERK player hit speed boost sprint burst"
Event.OnDamageTaken
Team.Team1
if (EventDamage() == true)
if (perk[2] == 1)
{
    if (perk[1] == 1)
    {
        SetMoveSpeed(EventPlayer(), 180);
        Wait(1, WaitBehavior.IgnoreCondition);
        SetMoveSpeed(EventPlayer(), 105);
    }
    else if (perk[1] == 2)
    {
        SetMoveSpeed(EventPlayer(), 200);
        Wait(1, WaitBehavior.IgnoreCondition);
        SetMoveSpeed(EventPlayer(), 107);
    }
    else if (perk[1] == 3)
    {
        SetMoveSpeed(EventPlayer(), 220);
        Wait(1, WaitBehavior.IgnoreCondition);
        SetMoveSpeed(EventPlayer(), 110);
    }
}

rule: "79 player died with maniac"
Event.OnDeath
Team.Team1
if (perk[3] == 1)
{
    Died[SlotOf(EventPlayer())] = NearestWalkablePosition(EventPlayer());
    BigMessage(AllPlayers(Team.All), <"<0> <1>", EventPlayer(), RandomValueInArray(etcArray[1])>);
    E[SlotOf(EventPlayer())] = true;
    SetMaxHealth(EventPlayer(), 100);
    StopForcingHero(EventPlayer());
    MinWait();
    perk[1] = false;
    MinWait();
    healthmax = 50;
    perk[3] = false;
    MinWait();
    SetDamageDealt(EventPlayer(), 100);
    damagevariable = 100;
    MinWait();
    healvariable = 100;
    SetHealingDealt(EventPlayer(), 100);
    perk[5] = false;
    Wait(0.1, WaitBehavior.IgnoreCondition);
    perk[2] = false;
    SetAllowedHeroes(EventPlayer(), allowedheroes);
}

rule: "77 multiplayer extra life Perk"
Event.OnDeath
Team.Team1
if (perk[4] == 1)
{
    # should set this to be a quick revive perk
    SetStatus(EventPlayer(), null, Status.KnockedDown, 2);
    Resurrect(EventPlayer());
    SetStatus(EventPlayer(), null, Status.Invincible, 10);
    perk[4] = 0;
}

rule: "pack a punch ability"
Event.OngoingPlayer
Team.Team1
if (FirstOf(perk) > 0)
{
    if (FirstOf(perk) == 1)
    {
        SetDamageDealt(EventPlayer(), 250);
        damagevariable = 250;
    }
    else if (FirstOf(perk) == 2)
    {
        SetDamageDealt(EventPlayer(), 500);
        damagevariable = 500;
    }
    else if (FirstOf(perk) == 3)
    {
        SetDamageDealt(EventPlayer(), 1000);
        damagevariable = 1000;
    }
}

rule: "all the effects"
if (extraVar[3] == 1)
{
    # @Condition outofpsawn == 1\nset all this to be array elements for each perk name, so it can easily be swapped with each map file
    for (forindex = 0; 3; 1)
    {
        CreateEffect(LocalPlayer(), Effect.GoodAura, teleportercolor, twoDvectorsArray[5][extraVar[12]], EvaluateOnce(twoDnumbersArray2[1][forindex]), EffectRev.VisibleToPositionRadiusAndColor);
        CreateEffect(LocalPlayer(), Effect.Sparkles, teleportercolor, twoDvectorsArray[5][extraVar[12]], EvaluateOnce(twoDnumbersArray2[1][forindex]), EffectRev.VisibleToPositionRadiusAndColor);
        CreateEffect(LocalPlayer(), Effect.Ring, Color.White, twoDvectorsArray[5][extraVar[12]], EvaluateOnce(twoDnumbersArray2[1][forindex]), EffectRev.VisibleToPositionRadiusAndColor);
    }
    Wait(1, WaitBehavior.IgnoreCondition);
    # this can be created on the spot instead of always present
    for (forindex = 0; 3; 1)
    {
        CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, Died[EvaluateOnce(forindex)], 4, EffectRev.VisibleToPositionAndRadius);
        CreateEffect(LocalPlayer(), Effect.Sphere, Color.White, Died[EvaluateOnce(forindex)], PlayersInSlot(EvaluateOnce(forindex), Team.Team1).sea, EffectRev.VisibleToPositionAndRadius);
        CreateInWorldText(LocalPlayer(), <"<0>", RandomValueInArray(etcArray[2])>, Died[EvaluateOnce(forindex)], 3, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    }
    # mystery box
    CreateEffect(LocalPlayer(), Effect.Ring, Color.Purple, extraVar[25], 2, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 10, 0) + extraVar[25], 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 25, 0) + extraVar[25], 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 40, 0) + extraVar[25], 1, EffectRev.VisibleToPositionAndRadius);
    CreateInWorldText(LocalPlayer(), IconString(Icon.QuestionMark), Vector(0, 2, 0) + extraVar[25], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Purple, Spectators.DefaultVisibility);
    CreateEffect(LocalPlayer(), Effect.Sparkles, Color.Yellow, extraVar[25], 2, EffectRev.VisibleToPositionAndRadius);
    CreateProjectileEffect(LocalPlayer(), ProjectileType.SymmetraPhotonProjector, null, Up() + extraVar[25], Up(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
    powerconnected[0] = LastCreatedEntity();
    CreateIcon(AllLivingPlayers(Team.Team1), Vector(0, 2, 0) + twoDvectorsArray[3][6], Icon.Bolt, IconRev.VisibleToAndPosition, Color.Yellow, true);
    powerconnected[1] = LastTextID();
    for (forindex = 0; 9; 1)
    {
        if (forindex != 6)
        {
            CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, twoDvectorsArray[3][forindex], 1, EffectRev.VisibleToAndColor);
            CreateProjectileEffect(LocalPlayer(), ProjectileType.BaptisteBioticLauncher, null, twoDvectorsArray[3][forindex], Up(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
        }
        else
        {
            CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, twoDvectorsArray[3][forindex], 1, EffectRev.VisibleToAndColor);
            CreateProjectileEffect(LocalPlayer(), ProjectileType.ZaryaGraviton, null, Vector(0, 1.5, 0) + twoDvectorsArray[3][forindex], Up(), 0.05, ProjectileEffectReeval.VisibleToFriendlyTo);
        }
    }
    # might be able to make this a loop as well, but since the perks are all different it would be more difficult to do so maybe an array
    CreateInWorldText(LocalPlayer(), IconString(Icon.Heart), Vector(0, 2, 0) + twoDvectorsArray[3][1], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), IconString(Icon.Fire), Vector(0, 2, 0) + twoDvectorsArray[3][2], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Red, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), IconString(Icon.Diamond), Vector(0, 2, 0) + twoDvectorsArray[3][3], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Blue, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), IconString(Icon.Eye), Vector(0, 2, 0) + twoDvectorsArray[3][4], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), IconString(Icon.Halo), Vector(0, 2, 0) + twoDvectorsArray[3][5], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Blue, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), AbilityIconString(Hero.Cassidy, Button.Ability1), Vector(0, 2, 0) + FirstOf(twoDvectorsArray[3]), 3.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), AbilityIconString(Hero.Soldier76, Button.Ability1), Vector(0, 2, 0) + twoDvectorsArray[3][7], 3.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    CreateInWorldText(LocalPlayer(), AbilityIconString(Hero.Ashe, Button.Ability2), Vector(0, 2, 0) + twoDvectorsArray[3][9], 3.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    for (forindex = 0; CountOf(twoDvectorsArray[2]); 1)
    {
        CreateEffect(LocalPlayer(), Effect.Ring, Color.Yellow, twoDvectorsArray[2][forindex], 2, EffectRev.VisibleTo);
        CreateInWorldText(LocalPlayer(), HeroIconString(etcArray[5][forindex]), Vector(0, 2, 0) + twoDvectorsArray[2][forindex], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.Blue, Spectators.DefaultVisibility);
    }
    Wait(3, WaitBehavior.IgnoreCondition);
    CreateInWorldText(LocalPlayer(), <"Bastion Trap: press <0> <1>", InputBindingString(Button.Interact), <@"<0>: <1>", HeroIconString(Hero.Bastion), 1000>>, Vector(-83.763, -158.95, 64.107), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Purple, Spectators.DefaultVisibility);
    CreateEffect(LocalPlayer(), Effect.Ring, Color.White, Vector(-101.303, -150.36, -17.831), 2, EffectRev.VisibleToPositionAndRadius);
    CreateInWorldText(LocalPlayer(), "The end : 50,000 points", Vector(-101.303, -150.36, -17.831), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    CreateEffect(LocalPlayer(), Effect.Ring, Color.White, FirstOf(FirstOf(twoDvectorsArray)), 1, EffectRev.PositionAndRadius);
    for (forindex = 0; 3; 1)
    {
        CreateInWorldText(LocalPlayer(), <"Spawn boss: <0> : 15000 points", InputBindingString(Button.Interact)>, FirstOf(twoDvectorsArray)[indexofbosseffect], 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.White, Spectators.DefaultVisibility);
        CreateEffect(LocalPlayer(), Effect.Ring, Color.White, FirstOf(twoDvectorsArray)[indexofbosseffect], 1, EffectRev.VisibleTo);
    }
    CreateEffect(LocalPlayer(), Effect.Ring, Color.Yellow, Vector(269.882, 44.205, 179.101), 1, EffectRev.VisibleToPositionAndRadius);
    CreateInWorldText(LocalPlayer(), <"Property damage: $<0>", extraVar[36]>, Vector(269.882, 44.205, 179.101), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Yellow, Spectators.DefaultVisibility);
    CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, Vector(273.459, 44.205, 176.795), 1, EffectRev.VisibleToPositionAndRadius);
