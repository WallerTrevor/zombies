rule: "517 set xp to hero"
Event.OngoingPlayer
Team.Team1

if (currentheroxp != IndexOfArrayValue(hero, HeroOf(EventPlayer())))
{
    currentheroxp = IndexOfArrayValue(hero, HeroOf(EventPlayer()));
}

rule: "512 gain level"
Event.OngoingPlayer
Team.Team1
if (experiencesystem == true)
if (xp[currentheroxp] >= 100)
{

    xp[currentheroxp] -= 100;
    XPlevel[currentheroxp] += 1;
    SmallMessage(EventPlayer(), <"<0> level <1>! <2>", HeroIconString(HeroOf(EventPlayer())), XPlevel[currentheroxp], XPlevel[currentheroxp] == 5 ? "Secondary fire unlocked!" : (XPlevel[currentheroxp] == 10 ? <"<0> unlocked!", AbilityIconString(HeroOf(EventPlayer()), Button.Ability1)> : (XPlevel[currentheroxp] == 15 ? <"<0> unlocked!", AbilityIconString(HeroOf(EventPlayer()), Button.Ability2)> : (XPlevel[currentheroxp] == 20 ? <"<0> unlocked!", AbilityIconString(HeroOf(EventPlayer()), Button.Ultimate)> : "")))>);

    MinWait();
    LoopIfConditionIsTrue();
}

rule: "513 Rule 321 lvl gain stat changes"
Event.OngoingPlayer
Team.Team1
if (experiencesystem == true)
if (start == 1)

if (xpAppliedKey != currentheroxp * 1000 + XPlevel[currentheroxp])
{
    xpAppliedKey = currentheroxp * 1000 + XPlevel[currentheroxp];

    SetSecondaryFireEnabled(EventPlayer(), XPUnlocked(5) && currentmagazines > 0);
    SetAbility1Enabled(EventPlayer(), XPUnlocked(10));
    SetAbility2Enabled(EventPlayer(), XPUnlocked(15));
    SetUltimateAbilityEnabled(EventPlayer(), XPUnlocked(20));
}
