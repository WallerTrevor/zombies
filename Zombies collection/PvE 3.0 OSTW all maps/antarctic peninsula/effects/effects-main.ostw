import "../Main/index.ostw";

rule: "all the effects"
if (start == 1)
{

    buyperks[Buyable.OmnicBomb] = Vector(240.047, 46.147, 174.277);

    for (forindex = 0; 3; 1)
    {
        CreateEffect(LocalPlayer(), Effect.GoodAura, teleportercolor, teleporterpositions[telespot], EvaluateOnce(teleradiusef[forindex]), EffectRev.VisibleToPositionRadiusAndColor);
        CreateEffect(LocalPlayer(), Effect.Sparkles, teleportercolor, teleporterpositions[telespot], EvaluateOnce(teleradiusef[forindex]), EffectRev.VisibleToPositionRadiusAndColor);
        CreateEffect(LocalPlayer(), Effect.Ring, Color.White, teleporterpositions[telespot], EvaluateOnce(teleradiusef[forindex]), EffectRev.VisibleToPositionRadiusAndColor);
    }
    Wait(1, WaitBehavior.IgnoreCondition);

    for (forindex = 0; 3; 1)
    {
        CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, Died[EvaluateOnce(forindex)], 4, EffectRev.VisibleToPositionAndRadius);
        CreateEffect(LocalPlayer(), Effect.Sphere, Color.White, Died[EvaluateOnce(forindex)], PlayersInSlot(EvaluateOnce(forindex), Team.Team1).sea, EffectRev.VisibleToPositionAndRadius);
        CreateInWorldText(LocalPlayer(), <"<0>", EvaluateOnce(RandomValueInArray(diedtext))>, Died[EvaluateOnce(forindex)], 3, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
    }

    CreateEffect(LocalPlayer(), Effect.Ring, Color.Purple, rngbox, 2, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 10, 0) + rngbox, 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 25, 0) + rngbox, 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(LocalPlayer(), Effect.LightShaft, Color.SkyBlue, Vector(0, 40, 0) + rngbox, 1, EffectRev.VisibleToPositionAndRadius);
    CreateInWorldText(LocalPlayer(), IconString(Icon.QuestionMark), Vector(0, 2, 0) + rngbox, 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Purple, Spectators.DefaultVisibility);
    CreateEffect(LocalPlayer(), Effect.Sparkles, Color.Yellow, rngbox, 2, EffectRev.VisibleToPositionAndRadius);
    CreateProjectileEffect(LocalPlayer(), ProjectileType.SymmetraPhotonProjector, null, Up() + rngbox, Up(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
}

void ClearZoneMarkers() "clear zone markers"
{
    for (zoneMarkerIndex = 0; CountOf(zoneEffects); 1)
    {
        DestroyEffect(zoneEffects[zoneMarkerIndex]);
        if (zoneMarkerIndex % 10 == 9)
        {
            LoadingPause();
        }
    }
    for (zoneMarkerIndex = 0; CountOf(zoneTexts); 1)
    {
        DestroyInWorldText(zoneTexts[zoneMarkerIndex]);
        if (zoneMarkerIndex % 10 == 9)
        {
            LoadingPause();
        }
    }
    for (zoneMarkerIndex = 0; CountOf(zoneIcons); 1)
    {
        DestroyIcon(zoneIcons[zoneMarkerIndex]);
        if (zoneMarkerIndex % 10 == 9)
        {
            LoadingPause();
        }
    }
    zoneEffects = [];
    zoneTexts = [];
    zoneIcons = [];
    powerconnected = null;
}

void DrawZoneMarkers() "draw zone markers"
{

    for (zoneMarkerIndex = Buyable.Juggernaut; Buyable.Power + 1; 1)
    {
        if (InCurrentZone(buyperks[zoneMarkerIndex]))
        {
            CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, buyperks[EvaluateOnce(zoneMarkerIndex)], 1, EffectRev.VisibleToAndColor);
            ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
            if (zoneMarkerIndex != Buyable.Power)
            {
                CreateProjectileEffect(LocalPlayer(), ProjectileType.BaptisteBioticLauncher, null, buyperks[EvaluateOnce(zoneMarkerIndex)], Up(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
                ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());

                CreateInWorldText(LocalPlayer(), perkIcons[EvaluateOnce(zoneMarkerIndex)], Vector(0, 2, 0) + buyperks[EvaluateOnce(zoneMarkerIndex)], EvaluateOnce(zoneMarkerIndex) == Perk.Juggernaut ? 3.25 : 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
                ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
            }
            else
            {
                CreateProjectileEffect(LocalPlayer(), ProjectileType.ZaryaGraviton, null, Vector(0, 1.5, 0) + buyperks[EvaluateOnce(zoneMarkerIndex)], Up(), 0.05, ProjectileEffectReeval.VisibleToFriendlyTo);
                ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());

                if (poweron == 0)
                {
                    CreateIcon(AllLivingPlayers(Team.Team1), Vector(0, 2, 0) + buyperks[Buyable.Power], Icon.Bolt, IconRev.VisibleToAndPosition, Color.Yellow, true);
                    ModifyVariable(zoneIcons, Operation.AppendToArray, LastCreatedEntity());
                    powerconnected = LastCreatedEntity();
                }
            }
        }
        LoadingPause();
    }

    if (InCurrentZone(buyperks[Buyable.OmnicBomb]))
    {
        CreateEffect(LocalPlayer(), Effect.Ring, Color.Red, buyperks[Buyable.OmnicBomb], 1, EffectRev.VisibleTo);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        CreateProjectileEffect(LocalPlayer(), ProjectileType.BaptisteBioticLauncher, null, buyperks[Buyable.OmnicBomb], Up(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        CreateInWorldText(LocalPlayer(), AbilityIconString(Hero.Ashe, Button.Ability2), Vector(0, 2, 0) + buyperks[Buyable.OmnicBomb], 3.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
    }
    LoadingPause();

    for (zoneMarkerIndex = 0; CountOf(buyheros); 1)
    {

        if (InCurrentZone(buyheros[zoneMarkerIndex]) && hero[zoneMarkerIndex] != null)
        {
            CreateEffect(LocalPlayer(), Effect.Ring, Color.Yellow, buyheros[EvaluateOnce(zoneMarkerIndex)], 2, EffectRev.VisibleTo);
            ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
            CreateInWorldText(LocalPlayer(), HeroIconString(hero[EvaluateOnce(zoneMarkerIndex)]), Vector(0, 2, 0) + buyheros[EvaluateOnce(zoneMarkerIndex)], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.Blue, Spectators.DefaultVisibility);
            ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        }
        if (zoneMarkerIndex % 6 == 5)
        {
            LoadingPause();
        }
    }

    for (zoneMarkerIndex = 0; CountOf(bossbuypositions); 1)
    {
        if (InCurrentZone(bossbuypositions[zoneMarkerIndex]))
        {
            CreateInWorldText(LocalPlayer(), <"Spawn boss: <0> : 15000 points", InputBindingString(Button.Interact)>, bossbuypositions[EvaluateOnce(zoneMarkerIndex)] + Vector(0, 2, 0), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.White, Spectators.DefaultVisibility);
            ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
            CreateEffect(LocalPlayer(), Effect.Ring, Color.White, bossbuypositions[EvaluateOnce(zoneMarkerIndex)], 1, EffectRev.VisibleTo);
            ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        }
    }
    LoadingPause();

    if (InCurrentZone(bankButtons[BankButton.Upgrade]))
    {

        for (zoneMarkerIndex = 0; 4; 1)
        {
            CreateEffect(LocalPlayer(), Effect.Ring, [Color.Red, Color.Red, Color.Red, Color.Yellow][zoneMarkerIndex], bankButtons[zoneMarkerIndex], [1.5, 1, 1, 1][zoneMarkerIndex], EffectRev.VisibleTo);
            ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        }

        for (zoneMarkerIndex = 0; 4; 1)
        {
            CreateProjectileEffect(LocalPlayer(), ProjectileType.BaptisteBioticLauncher, null, bankButtons[BankButton.Upgrade] + [Vector(0, 0.25, 0.7), Vector(0, -0.5, 0), Vector(0.5, -0.5, 0), Vector(-0.5, -0.5, 0)][zoneMarkerIndex], [Backward(), Up(), Up(), Up()][zoneMarkerIndex], [0.05, 0.1, 0.1, 0.1][zoneMarkerIndex], ProjectileEffectReeval.VisibleToFriendlyTo);
            ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        }
        CreateInWorldText(LocalPlayer(), <"Property damage: $<0>", ramPoints>, bankButtons[BankButton.PropertyDamage], 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Yellow, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        CreateInWorldText(LocalPlayer(), <"Bank: <0> Points", bankPoints>, bankButtons[BankButton.Upgrade] + Vector(0, 2, 0), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        CreateInWorldText(LocalPlayer(), IconString(Icon.ArrowUp), bankButtons[BankButton.Withdraw], 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        CreateInWorldText(LocalPlayer(), IconString(Icon.ArrowDown), bankButtons[BankButton.Deposit], 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
    }

    if (InCurrentZone(bankButtons[BankButton.CreditCardOffice]))
    {
        CreateEffect(LocalPlayer(), Effect.Ring, Color.Blue, bankButtons[BankButton.CreditCardOffice], 1, EffectRev.VisibleToPositionAndRadius);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        CreateInWorldText(LocalPlayer(), AbilityIconString(Hero.Kiriko, Button.Ability1), bankButtons[BankButton.CreditCardOffice] + Vector(0, 2, 0), 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        CreateProjectileEffect(LocalPlayer(), ProjectileType.ZaryaParticleCannon, null, bankButtons[BankButton.CreditCardOffice] + Vector(0, 0.5, 0), Up(), 0.03, ProjectileEffectReeval.VisibleToFriendlyTo);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        CreateProjectileEffect(LocalPlayer(), ProjectileType.BaptisteBioticLauncher, null, bankButtons[BankButton.CreditCardOffice] + Vector(0, 0.5, 0), Down(), 0.1, ProjectileEffectReeval.VisibleToFriendlyTo);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
    }

    if (InCurrentZone(Vector(-101.303, -150.36, -17.831)))
    {
        CreateInWorldText(LocalPlayer(), <"Bastion Trap: press <0> <1>", InputBindingString(Button.Interact), <@"<0>: <1>", HeroIconString(Hero.Bastion), 1000>>, Vector(-83.763, -158.95, 64.107), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.Purple, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
        CreateEffect(LocalPlayer(), Effect.Ring, Color.White, Vector(-101.303, -150.36, -17.831), 2, EffectRev.VisibleToPositionAndRadius);
        ModifyVariable(zoneEffects, Operation.AppendToArray, LastCreatedEntity());
        CreateInWorldText(LocalPlayer(), "The end : 50,000 points", Vector(-101.303, -150.36, -17.831), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        ModifyVariable(zoneTexts, Operation.AppendToArray, LastTextID());
    }
}

rule: "zone markers"
if (start == 1)
if (zoneMarkersZone != telespot)
{
    zoneMarkersZone = telespot;

    zoneMarkersBusy = true;

    WaitUntil(zoneZombiesGone == true, 15);
    ClearZoneMarkers();
    DrawZoneMarkers();
    zoneMarkersBusy = false;

    LoopIfConditionIsTrue();
}

rule: "fire sale boxes"
if (start == 1)
if (fireSale == true)
{
    fireSaleEffects = [];
    fireSaleTexts = [];

    fireSaleBoxes = [];
    fireSaleZone = telespot;
    for (fireSaleIndex = 0; CountOf(mysterylocations); 1)
    {
        if (InCurrentZone(mysterylocations[fireSaleIndex]))
        {
            ModifyVariable(fireSaleBoxes, Operation.AppendToArray, mysterylocations[fireSaleIndex]);
        }

        if (InCurrentZone(mysterylocations[fireSaleIndex]) && mysterylocations[fireSaleIndex] != rngbox)
        {
            CreateEffect(LocalPlayer(), Effect.Ring, Color.Purple, mysterylocations[EvaluateOnce(fireSaleIndex)], 2, EffectRev.VisibleTo);
            ModifyVariable(fireSaleEffects, Operation.AppendToArray, LastCreatedEntity());
            CreateEffect(LocalPlayer(), Effect.LightShaft, Color.Orange, Vector(0, 10, 0) + mysterylocations[EvaluateOnce(fireSaleIndex)], 1, EffectRev.VisibleTo);
            ModifyVariable(fireSaleEffects, Operation.AppendToArray, LastCreatedEntity());
            CreateInWorldText(LocalPlayer(), IconString(Icon.QuestionMark), Vector(0, 2, 0) + mysterylocations[EvaluateOnce(fireSaleIndex)], 2.25, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleTo, Color.Orange, Spectators.DefaultVisibility);
            ModifyVariable(fireSaleTexts, Operation.AppendToArray, LastTextID());
        }
    }
    WaitUntil(fireSale != true || telespot != fireSaleZone, 99999);
    for (fireSaleIndex = 0; CountOf(fireSaleEffects); 1)
    {
        DestroyEffect(fireSaleEffects[fireSaleIndex]);
    }
    for (fireSaleIndex = 0; CountOf(fireSaleTexts); 1)
    {
        DestroyInWorldText(fireSaleTexts[fireSaleIndex]);
    }
    fireSaleEffects = [];
    fireSaleTexts = [];
    fireSaleBoxes = [];

    LoopIfConditionIsTrue();
}

rule: "69 round won sound effect"
Event.OngoingPlayer
Team.Team1
if (Z <= 0)
{
    PlayEffect(AllPlayers(Team.All), PlayEffect.RingExplosionSound, Color.White, EventPlayer(), 80);
}
rule: "66 wave >1 warning"
Event.OngoingPlayer
Team.Team1

if (HeroOf(EventPlayer()) == Hero.Ashe)

if (roundnumber > 1)
{
    AbortIf(HeroOf(EventPlayer()) != Hero.Ashe);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    BigMessage(EventPlayer(), "WARNING:STARTING HERO - LOW DAMAGE CAPABILITY");
    Wait(30, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "65 ring around each player"
Event.OngoingPlayer
Team.Team1
if (playerRingCreated == false)
{
    if (playerRingCreated == false)
    {
        if (SlotOf(EventPlayer()) < CountOf(playerRingColors))
        {
            CreateEffect(AllPlayers(Team.All), Effect.Ring, playerRingColors[SlotOf(EventPlayer())], EventPlayer(), 1.2, EffectRev.VisibleToPositionAndRadius);
            playerRingCreated = true;
        }
    }
}

rule: "Bot effect (each player team 2)"
Event.OnDeath
Team.Team2
if (ServerLoad() < 200)

if (IsDummyBot(EventPlayer()) == true)
{
    PlayEffect(AllPlayers(Team.All), PlayEffect.JunkratFragLauncherExplosionEffect, Color.White, EventPlayer(), 5);
    PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallMinefieldExplosionSound, Color.White, EventPlayer(), 100);
}

rule: "teleporter back to blue"
if (teleporterwait == false)
{
    teleportercolor = Color.Blue;
}
