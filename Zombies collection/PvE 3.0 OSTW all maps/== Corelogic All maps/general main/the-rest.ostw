{
    Wait(2, WaitBehavior.AbortWhenFalse);
    setspawn = RandomInteger(0, 5);
    DestroyAllDummyBots();
    StartCamera(AllPlayers(Team.Team1), Vector(317.328, -25.644, -140.906), Vector(320.513, -24.05, -134.612), 0);
    DestroyAllHudText();
    DestroyAllEffects();
    # delete players credit card and reset points
    Wait(4, WaitBehavior.IgnoreCondition);
    GoToAssembleHeroes();
   #getoutofspawn();
    Resurrect(AllPlayers(Team.Team1));
    Wait(2, WaitBehavior.IgnoreCondition);
    bankPoints += AllPlayers(Team.Team1).points * 0.75;
    AllPlayers(Team.Team1).outofpsawn = false;
    extraVar[0] = 0;
    extraVar[3] = false;
    romanNcounter = 1;
    extraVar[28] = 0;
    AllPlayers(Team.Team1).points = 0;
    extraVar[4] = false;
    AllPlayers(Team.Team1).creditcardlimit = 0;
    AllPlayers(Team.Team1).creditTier = 0;
    costmultiplier = 1;
    for (forindex = 0; 90; 1)
    {
        Wall_ID[forindex] = 1;
    }
}

