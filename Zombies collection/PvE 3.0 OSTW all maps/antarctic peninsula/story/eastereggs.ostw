
rule: "509 bot name singleplayer"

if (NumberOfPlayers(Team.Team1) == 1)
if (roundnumber > 0)
if (aprilrng == 50)
{
    botNames = [
        "01000111 01100101",
        "01110100 00100000",
        "01101111 01110101",
        "01110100 00100000",
        "01101111 01100110",
        "00100000 01101000",
        "01100101 01110010",
        "01100101 00101110"
    ];

    for (i = 0; i < CountOf(botNames); 1)
    {
        StartForcingDummyBotName(
            PlayersInSlot(i, Team.Team2),
            botNames[i]
        );
    }
}

rule: "510 bot name coop"
if (NumberOfPlayers(Team.Team1) > 1)
if (aprilrng == 50)
if (roundnumber > 0)
{
    StartForcingDummyBotName(PlayersInSlot(0, Team.Team2), "77 6F 72 6B 69");
    StartForcingDummyBotName(PlayersInSlot(1, Team.Team2), "6E 67 20 74 6F");
    StartForcingDummyBotName(PlayersInSlot(2, Team.Team2), "67 65 74 68 65");
    StartForcingDummyBotName(PlayersInSlot(3, Team.Team2), "72 20 69 73");
    StartForcingDummyBotName(PlayersInSlot(4, Team.Team2), "20 66 75 74");
    StartForcingDummyBotName(PlayersInSlot(5, Team.Team2), "69 6C 65 21");
}

rule: "glitch in the system" #This changes the round number to show a easter egg. it changes it to be binary for the round number.
if (roundnumber < 10)
if (aprilrng == 25)
{
    for (forindex = 0; forindex < 4; 1)
    {
        romanNcounter += 12;
        Wait(0.4, WaitBehavior.IgnoreCondition);
        romanNcounter -= 12;
        Wait(0.4, WaitBehavior.IgnoreCondition);
    }
    LoopIfConditionIsTrue();
}

rule: "507 april first quotes"
Event.OngoingPlayer
Team.Team1
if (IsUsingUltimate(EventPlayer()) == true)
if (aprilrng == 100)
{
    # might be an easier way to set this up
    if (HeroOf(EventPlayer()) == Hero.Dva)
    {
        CreateInWorldText(AllPlayers(Team.All), IndexOfArrayValue(aprilquotes, RandomInteger(0, 2)), EventPlayer(), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
        Wait(5, WaitBehavior.IgnoreCondition);
        DestroyInWorldText(LastTextID());
    }
