Event.OngoingPlayer
Team.Team2
Player.Doomfist
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 15)
{
    Wait(0.3, WaitBehavior.AbortWhenFalse);
