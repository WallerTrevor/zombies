rule: "202 Purchase Follower action"
Event.OngoingPlayer
Team.Team1

if (monkeyBombActive != true)
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
if (IsTrueForAny(buyheros, DistanceToEventPlayer(ArrayElement()) < 2) == true)
{
    Wait(1, WaitBehavior.AbortWhenFalse);
    WaitUntil(ServerLoad() < 230, 3);
    for (i = 0; CountOf(hero); 1)
    {

        if (DistanceToEventPlayer(buyheros[i]) < 2 && hero[i] != null)
        {
            if (points >= RequiredPurchasePoints(herobuycosts[i] / 3 * CoinDiscount()))
            {
                followerbuy = hero[i];

                points -= ScaledPurchaseCost(herobuycosts[i] / 3 * CoinDiscount());
                points2 -= ScaledPurchaseCost(herobuycosts[i] / 3 * CoinDiscount());

                SpendRamattraCoins(1);
                MinWait();
                Subfollowerbuy();
                FirstFollowerEmote();
            }
            else
            {

                messageSpot = i;
                SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(hero[messageSpot]), followerbuyMsg[messageSpot]>);
            }
            break;
        }
    }
}

rule: "Purchase Mystery Follower action"
Event.OngoingPlayer
Team.Team1

if (monkeyBombActive != true)
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)

if (NearMysteryBox())
{
    Wait(1, WaitBehavior.AbortWhenFalse);
    if (points >= RequiredPurchasePoints(FirstOf(herobuycosts) / 3 * CoinDiscount()))
    {
        followerbuy = RandomValueInArray(hero);
        points -= ScaledPurchaseCost(FirstOf(herobuycosts) / 3 * CoinDiscount());
        points2 -= ScaledPurchaseCost(FirstOf(herobuycosts) / 3 * CoinDiscount());

        SpendRamattraCoins(1);
        MinWait();
        Subfollowerbuy();
        FirstFollowerEmote();
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(FirstOf(hero)), FirstOf(followerbuyMsg)>);
    }
}

rule: "229 buy perks and power activate"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)

if (IsTrueForAny(ArraySlice(buyperks, 0, Buyable.packapunch + 1), DistanceToEventPlayer(ArrayElement()) < 2) == true)
{

    WaitUntil(ServerLoad() < 230, 3);

    for (i = Buyable.Juggernaut; Buyable.packapunch + 1; 1)
    {
        if (DistanceToEventPlayer(buyperks[i]) < 2)
        {
            if (poweron == 1)
            {
                if (points >= RequiredPurchasePoints(perkcosts[i] * CoinDiscount()))
                {
                    if (perk[i] < 3)
                    {
                        points -= CashbackPurchaseCharge(perkcosts[i] * CoinDiscount());

                        perk[i] += 1;

                        messageSpot = i;

                        SpendRamattraCoins(i == Buyable.packapunch ? 5 : 3);
                        SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(Hero.Ramattra), perkmessages[messageSpot]>);
                        Wait(0.25, WaitBehavior.IgnoreCondition);
                        PlayEffect(AllPlayers(Team.Team1), PlayEffect.RingExplosionSound, Color.White, EventPlayer(), 70);
                        Wait(0.25, WaitBehavior.IgnoreCondition);
                        Communicate(EventPlayer(), Communication.EmoteUp);
                        PurchaseFreezeAfterEmote();
                        break;
                    }
                    else
                    {
                        SmallMessage(EventPlayer(), <"<0> You already have the max tier!", HeroIconString(Hero.Ramattra)>);
                        break;
                    }
                }
                else if (points < perkcosts[i])
                {
                    SmallMessage(EventPlayer(), <"<0> No points? NO perks!", HeroIconString(Hero.Ramattra)>);
                    break;
                }
            }
            else
            {
                SmallMessage(EventPlayer(), <"<0> The power is not ON!", HeroIconString(Hero.Ramattra)>);

                break;
            }
        }
    }
}

rule: "connect power"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceToEventPlayer(buyperks[Buyable.Power]) < 2)
if (poweron == 0)
{
    PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);

    DestroyIcon(powerconnected);
    ModifyVariable(zoneIcons, Operation.RemoveFromArrayByValue, powerconnected);
    powerconnected = null;
    poweron = 1;
    SmallMessage(AllPlayers(Team.All), "The power is now ON!");

    if (CountOf(AllLivingPlayers(Team.Team2)) > 0)
    {
        SmallMessage(AllPlayers(Team.All), <"<0> Prepare for death!", HeroIconString(Hero.Ramattra)>);
    }
    else
    {
        SmallMessage(AllPlayers(Team.All), <"<0> Nice timing", HeroIconString(Hero.Ramattra)>);
    }

    AllPlayers(Team.Team2).powerUltPending = true;
}

rule: "202 Purchase hero actions"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)

if (IsTrueForAny(buyheros, DistanceToEventPlayer(ArrayElement()) < 2) == true)
{

    WaitUntil(ServerLoad() < 230, 3);
    for (idx = 0; CountOf(buyheros); 1)
    {

        if (DistanceToEventPlayer(buyheros[idx]) < 2 && hero[idx] != null)
        {

            buySpot = idx;
            if (HeroOf(EventPlayer()) == hero[buySpot])
            {
                if (points >= RoundToInteger(herobuycosts[buySpot] / 2 * costmultiplier - creditcardlimit, Rounding.Nearest) && currentmagazines < FullMagazines())
                {
                    points -= RoundToInteger(herobuycosts[buySpot] / 2 * costmultiplier * cashback, Rounding.Nearest);
                    Wait(0.25, WaitBehavior.IgnoreCondition);
                    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, herobuycosts[buySpot], RateChaseReevaluation.DestinationAndRate);
                    currentmagazines = FullMagazines();
                    SmallMessage(EventPlayer(), <"<0> Magazines refilled!", HeroIconString(hero[buySpot])>);

                    break;
                }
                else
                {

                    if (currentmagazines >= FullMagazines())
                    {
                        SmallMessage(EventPlayer(), "You already have full magazines!");
                    }
                    else if (points < herobuycosts[buySpot] / 2)
                    {
                        SmallMessage(EventPlayer(), <"<0> No points? NO magazines!", HeroIconString(Hero.Ramattra)>);
                    }
                }
            }
            else
            {
                if (points >= RoundToInteger(herobuycosts[buySpot] * CoinDiscount() * costmultiplier - creditcardlimit, Rounding.Nearest))
                {
                    ForcePlayerHero(EventPlayer(), hero[buySpot]);

                    perk[Perk.packapunch] = 0;
                    MinWait();
                    heroswap[currentswap] = hero[buySpot];
                    MinWait();
                    heroiconswap[currentswap] = HeroIconString(hero[buySpot]);
                    if (ServerLoad() < 235)
                    {
                        PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);
                        PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearEffect, Color.White, EventPlayer(), 1);
                    }
                    points -= RoundToInteger(herobuycosts[buySpot] * CoinDiscount() * costmultiplier * cashback, Rounding.Nearest);

                    SpendRamattraCoins(1);
                    Wait(0.25, WaitBehavior.IgnoreCondition);
                    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, herobuycosts[buySpot], RateChaseReevaluation.DestinationAndRate);
                    AttachPlayers(PlayersInSlot(SlotOf(EventPlayer()) + 4, Team.Team1), EventPlayer(), Vector(-0.5, 1.8, -0.2));
                    if (!ArrayContains(allowedheroes, HeroOf(EventPlayer())))
                    {
                        ModifyVariable(allowedheroes, Operation.AppendToArray, HeroOf(EventPlayer()));
                    }
                    currentmagazines = FullMagazines();
                }
                else
                {

                    SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(hero[buySpot]), herobuymessages[buySpot]>);
                }

                break;
            }
        }
    }
}

rule: "buy the ending"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceToEventPlayer(Vector(-101.303, -150.36, -17.831)) < 2)
if (IsAlive(EventPlayer()) == true)
{
    if (points >= 50000)
    {
        points -= 50000 * cashback;
        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 50000, RateChaseReevaluation.DestinationAndRate);

        FilteredArray(AllPlayers(Team.Team1), !IsDummyBot(ArrayElement())).endingRewardPending = true;

        slowmoCutscene = 40;
        Wait(2, WaitBehavior.IgnoreCondition);
        slowmoCutscene = 0;
        SmallMessage(AllPlayers(Team.Team1), <"<0> You really thought this was going to end?", HeroIconString(Hero.Ramattra)>);
        Wait(2, WaitBehavior.IgnoreCondition);

        AllPlayers(Team.Team1).singlelives = 3;
        AllPlayers(Team.Team1).perk[Perk.selfrevive] = 0;
        Kill(AllPlayers(Team.All), null);
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> HA, good luck escaping...", HeroIconString(Hero.Ramattra)>);
    }
}

rule: "ending reward for each player"
Event.OngoingPlayer
Team.Team1
if (endingRewardPending == true)
{
    endingRewardPending = false;
    if (!ArrayContains(endingHeroes, HeroOf(EventPlayer())))
    {
        ModifyVariable(endingHeroes, Operation.AppendToArray, HeroOf(EventPlayer()));
    }
    SmallMessage(EventPlayer(), <"<0> now has tier 3 Pack-a-Punch in every playthrough.", HeroIconString(HeroOf(EventPlayer()))>);
}

rule: "78 buy revive multiplayer"
Event.OngoingPlayer
Team.Team1
if (DistanceToEventPlayer(Vector(-83.583, -155.045, 120.352)) < 4)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (points >= RoundToInteger(1000 * costmultiplier - creditcardlimit, Rounding.Nearest))
if (powerconnected == 1)

if (RealPlayerCount() > 1)
{
    WaitUntil(ServerLoad() < 230, 3);
    points -= RoundToInteger(1000 * costmultiplier * cashback, Rounding.Nearest);
    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
    PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);
    Wait(0.1, WaitBehavior.IgnoreCondition);
    revived = 1;
    Wait(0.1, WaitBehavior.IgnoreCondition);
    Communicate(EventPlayer(), Communication.EmoteUp);

    PurchaseFreezeAfterEmote();
}

rule: "173 Purchase winston Omnic bomb"
Event.OngoingPlayer
Team.Team1
if (DistanceToEventPlayer(buyperks[Buyable.OmnicBomb]) < 2)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (monkeyBombOwned != true)
{

    if (poweron != 1)
    {
        SmallMessage(EventPlayer(), <"<0> The power is not ON!", HeroIconString(Hero.Ramattra)>);
        return;
    }
    if (points < RoundToInteger(2500 * costmultiplier - creditcardlimit, Rounding.Nearest))
    {
        SmallMessage(EventPlayer(), <"<0> No points? NO monkey bombs!", HeroIconString(Hero.Ramattra)>);
        return;
    }
    WaitUntil(ServerLoad() < 230, 3);
    points -= RoundToInteger(2500 * costmultiplier * cashback, Rounding.Nearest);
    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 2500, RateChaseReevaluation.DestinationAndRate);
    monkeyBombOwned = true;
    PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);
    Wait(0.1, WaitBehavior.IgnoreCondition);
    Communicate(EventPlayer(), Communication.EmoteUp);
    monkeyBombsLeft = 3;
    SmallMessage(EventPlayer(), <"<0> 3 monkey bombs a round: use the Ultimate Status voice line to throw one", HeroIconString(Hero.Ramattra)>);
    PurchaseFreezeAfterEmote();
    Part2 = false;
}

rule: "53  mystery box"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)

if (NearMysteryBox())
{

    if (points > MysteryBoxCost() * CoinDiscount() - creditcardlimit)
    {
        if (ServerLoad() < 235)
        {
            WaitUntil(ServerLoad() < 230, 1.5);
            PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);
        }
        WaitUntil(ServerLoad() < 230, 1.5);
        ForcePlayerHero(EventPlayer(), FirstOf(RandomValueInArray(RandomizedArray(AllHeroes()))));

        perk[Perk.packapunch] = 0;
        Wait(0.1, WaitBehavior.IgnoreCondition);
        Resurrect(EventPlayer());
        points -= MysteryBoxCost() * CoinDiscount() * cashback;

        SpendRamattraCoins(1);
        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, MysteryBoxCost(), RateChaseReevaluation.DestinationAndRate);
        if (ServerLoad() < 235)
        {
            PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearEffect, Color.White, EventPlayer(), 1);
            PlayEffect(AllPlayers(Team.All), PlayEffect.BuffExplosionSound, Color.White, EventPlayer(), 70);
        }
        heroswap[currentswap] = HeroOf(EventPlayer());
        heroiconswap[currentswap] = HeroIconString(HeroOf(EventPlayer()));
        if (!ArrayContains(allowedheroes, HeroOf(EventPlayer())))
        {
            ModifyVariable(allowedheroes, Operation.AppendToArray, HeroOf(EventPlayer()));
        }

        currentmagazines = FullMagazines();
        boxcounter += 1;
        Wait(1, WaitBehavior.IgnoreCondition);
        SkipIf(boxcounter < RandomInteger(6, 15), 2);
        rngbox = RandomValueInArray(mysterylocations);
        boxcounter = false;
    }
    else if (points < MysteryBoxCost() * CoinDiscount() - creditcardlimit)
    {
        BigMessage(EventPlayer(), "Come back when you've got some money buddy!");
    }
}

rule: "192 Purchase trap"
Event.OngoingPlayer
Team.Team1
if (DistanceToEventPlayer(Vector(-83.799, -160.001, 64.224)) <= 2)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (trapeffect == false)
{
    if (points >= 1000)
    {
        WaitUntil(ServerLoad() < 230, 3);
        trapeffect = 1;
        PlayEffect(AllPlayers(Team.Team1), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 70);
        points -= 2000;
        Wait(22, WaitBehavior.IgnoreCondition);
        trapeffect = false;
    }
    else if (points < 1000)
    {
        SmallMessage(EventPlayer(), <"<0>  A Trap? No! Omnics need purpose!", HeroIconString(Hero.Ramattra)>);
        Wait(4, WaitBehavior.IgnoreCondition);
    }
}
