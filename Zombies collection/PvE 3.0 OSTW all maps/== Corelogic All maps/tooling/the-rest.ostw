rule: "switch between 2 heros (needs ultimates, followers, ammo, systems working)"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Crouch) == true)
if (IsAlive(EventPlayer()) == true)
{
    if (ServerLoad() < 245)
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearSound, Color.White, EventPlayer(), 200);
        RemoveAllHealthPoolsFromPlayer(EventPlayer());
        if (currentswap == false)
        {
            swapvar = [1, 0, 0, 1, 2];
            MinWait();
            Subheroswap();
        }
        else if (currentswap == 1)
        {
            swapvar = [0, 1, 3, 4, 5];
            MinWait();
            Subheroswap();
        }
        ForcePlayerHero(EventPlayer(), heroswap[currentswap]);
        SetPlayerHealth(EventPlayer(), herohp[FirstOf(swap)]);
        SetAbilityCooldown(EventPlayer(), Button.Ability1, abilitycooldown[swap[2]]);
        SetAbilityCooldown(EventPlayer(), Button.Ability2, abilitycooldown[swap[3]]);
        SetAbilityCooldown(EventPlayer(), Button.SecondaryFire, abilitycooldown[swap[4]]);
        SetUltimateCharge(EventPlayer(), currentultcharge);
        MinWait();
        AttachPlayers(PlayersInSlot(SlotOf(EventPlayer()) + 4, Team.Team1), EventPlayer(), Vector(-0.5, 1.8, -0.2));
        Wait(0.1, WaitBehavior.IgnoreCondition);
        PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearEffect, Color.White, EventPlayer(), 1);
        Wait(1, WaitBehavior.IgnoreCondition);
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> Not on my watch! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
        Wait(6, WaitBehavior.IgnoreCondition);
    }
}

