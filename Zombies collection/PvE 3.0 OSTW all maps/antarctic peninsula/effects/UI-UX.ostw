rule: "info UI cancel"
Event.OngoingPlayer
Team.Team1
if (start > 0)
{
    SkipIf(CountOf(InfoUI) == false, 5);
    DestroyHudText(InfoUI[CountOf(InfoUI) - 1]);
    ModifyVariable(InfoUI, Operation.RemoveFromArrayByIndex, CountOf(InfoUI) - 1);
    MinWait();
    LoopIf(CountOf(InfoUI) != 0);
    InfoCooldown = TotalTimeElapsed() + 5;
    Abort();
}

rule: "loading message"
{
    CreateHudText(textListsLoaded == false ? AllPlayers(Team.Team1) : null, "Loading, please wait...", mapDataLoaded == false ? "map data" : (pfMapReady == false || zoneLoading == true ? "doors and pathfinding" : "text"), null, Location.Top, 0, Color.Yellow, Color.White, null, HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
}

rule: "Info UI"
Event.OngoingPlayer
if (start == false)
{

    for (infoUIIndex = 0; 18; 1)
    {
        if (infoUIIndex > 0)
        {
            LoadingPause();
        }
        if (ArrayContains([0, 7, 10, 14], infoUIIndex))
        {
            CreateHudText(settingsViewers == null ? EventPlayer() : null, null, null, <"<0> <1>", EvaluateOnce([IconString(Icon.Checkmark), IconString(Icon.Bolt), IconString(Icon.Diamond), IconString(Icon.Heart)][IndexOfArrayValue([0, 7, 10, 14], infoUIIndex)]), infoText[EvaluateOnce(infoUIIndex)]>, Location.Left, 10 + infoUIIndex, null, null, Color.Yellow, HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
        }
        else if (infoUIIndex == 5)
        {
            CreateHudText(settingsViewers == null ? EventPlayer() : null, null, null, infoText[5], Location.Left, 15, null, null, Color.Green, HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
        }
        else
        {
            CreateHudText(settingsViewers == null ? EventPlayer() : null, null, infoText[EvaluateOnce(infoUIIndex)], null, Location.Left, 10 + infoUIIndex, null, Color.White, null, HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
        }
        ModifyVariable(InfoUI, Operation.AppendToArray, LastTextID());
    }
    InfoCooldown = TotalTimeElapsed() + 0.16;
    HideHints = true;
    UI = 1;
}

rule: "toggle perk info"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Jump) == true)
if (perkinfo == false)
{
    Wait(2, WaitBehavior.AbortWhenFalse);
    perkinfo = 1;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    perkinfo = 2;
    Wait(7, WaitBehavior.IgnoreCondition);
    perkinfo = 1;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    perkinfo = false;
}

define SettingsRowText(Number row): [SettingsText.GameSettings, SettingsText.AnyoneCanChange, SettingsText.DifficultyEasy - 1 + Difficulty, SettingsText.WavesBrigitte + spawntype, SettingsText.XPSystemOff + (experiencesystem ? 1 : 0), SettingsText.Back, SettingsText.DifficultyDetails - 2 + 2 * Difficulty, SettingsText.DifficultyDetails - 1 + 2 * Difficulty, SettingsText.Hint][row];

rule: "settings menu: open and close with Melee"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Melee) == true)
if (start == false)
if (textListsLoaded == true)
{

    settingsViewers = settingsViewers == null ? AllPlayers(Team.Team1) : null;

    StartCamera(settingsViewers, FirstOf(settingsCamera), settingsCamera[1], 0);
    SetFacing(settingsViewers, DirectionTowards(FirstOf(settingsCamera), settingsCamera[1]), Relative.ToWorld);
}

rule: "settings menu: show it"
if (start == false)

if (textListsLoaded == true)
if (mapDataLoaded == true)
{

    LoadingPause();

    CreateInWorldText(settingsViewers, "+", FirstOf(settingsCamera) + FacingDirectionOf(LocalPlayer()) * 12, 3, Clipping.DoNotClip, InworldTextRev.VisibleToPositionAndString, Color.Yellow, Spectators.DefaultVisibility);
    settingsHuds = [LastTextID()];

    for (settingsRow = 0; 9; 1)
    {
        CreateInWorldText(settingsViewers, settingsText[SettingsRowText(EvaluateOnce(settingsRow))], settingsCamera[1] + settingsCamera[2] * (3 - settingsRow * 0.75), settingsRow == 0 ? 3 : (AbsoluteValue(settingsRow - 3.5) < 2 ? 2.2 : 1.3), Clipping.DoNotClip, InworldTextRev.VisibleToAndString, settingsRow == 0 ? Color.Yellow : (AbsoluteValue(settingsRow - 3.5) < 2 ? Color.Orange : Color.White), Spectators.DefaultVisibility);
        ModifyVariable(settingsHuds, Operation.AppendToArray, LastTextID());
    }

    WaitUntil(start != false, 99999);
    for (settingsRow = 0; CountOf(settingsHuds); 1)
    {
        DestroyInWorldText(settingsHuds[settingsRow]);
    }
}

rule: "settings menu: click a setting"
Event.OngoingPlayer
Team.Team1
if ((IsButtonHeld(EventPlayer(), Button.PrimaryFire) || IsButtonHeld(EventPlayer(), Button.SecondaryFire)) == true)
if (settingsViewers != null)
{
    menuStep = IsButtonHeld(EventPlayer(), Button.PrimaryFire) ? 1 : -1;
    menuPick = RoundToInteger(2 - 16 * DotProduct(FacingDirectionOf(EventPlayer()), settingsCamera[2]), Rounding.Nearest);
    if (menuPick == 0)
    {

        Difficulty = Max(1, Min(5, Difficulty + menuStep));
        difficultyStats = ArraySlice(difficultyTable, Difficulty * 6 - 6, 6);
    }
    else if (menuPick == 1)
    {

        spawntype = (spawntype + menuStep + 5) % 5;
    }
    else if (menuPick == 2)
    {
        experiencesystem = !experiencesystem;
    }
    else if (menuPick == 3)
    {

        settingsViewers = null;
    }
    PlayEffect(EventPlayer(), PlayEffect.BuffImpactSound, Color.White, EventPlayer(), 40);

    Wait(0.25, WaitBehavior.IgnoreCondition);
}
