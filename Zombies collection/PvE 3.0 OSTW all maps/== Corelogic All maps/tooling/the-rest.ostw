rule: "2 round change"
if (extraVar[1] <= 0)
if (O == false)
if (extraVar[3] == 1)
{
    Wait(0.16, WaitBehavior.IgnoreCondition);
    for (forindex = 0; CountOf(omnicspawn); 1)
    {
        DestroyDummyBot(Team.Team2, omnicspawn[forindex]);
    }
    extraVar[0] += 1;
    Z = 1;
    BigMessage(AllPlayers(Team.All), <@"Round <0>", etcArray[3][romanNcounter]>);
    P = false;
    # this needs to change for all heroes in inventory
    AllDeadPlayers(Team.Team1).Packapunch = false;
    ClearStatus(AllDeadPlayers(Team.Team1), Status.Burning);
    AllDeadPlayers(Team.Team1).damagevariable = 100;
    Teleport(AllDeadPlayers(Team.Team1), NearestWalkablePosition(RandomValueInArray(AllLivingPlayers(Team.Team1)) + Vector(RandomInteger(-5, 5), 0, RandomInteger(-5, 5))));
    ForcePlayerHero(AllDeadPlayers(Team.Team1), Hero.Cassidy);
    Resurrect(AllDeadPlayers(Team.Team1));
    # set a loop
    Died[0] = Vector(500, 0, 500);
    Died[1] = Vector(500, 0, 500);
    Died[2] = Vector(500, 0, 500);
    Died[3] = Vector(500, 0, 500);
    # can set these to false
    AllPlayers(Team.Team1).InfoCooldown = false;
    AllPlayers(Team.Team1).p_P = false;
    AllPlayers(Team.Team1).botTarget = false;
    AllPlayers(Team.Team1).HideHints = false;
    SetStatus(AllLivingPlayers(Team.Team1), null, Status.PhasedOut, 2);
    AllPlayers(Team.Team1).Head_HP = 3;
    extraVar[21] += 1;
    if (FirstOf(extraVar) < 12)
    {
        romanNcounter += 1;
    }
    extraVar[22] = RandomInteger(1, 5);
    # definitely need to play test to see if this is fun
    costmultiplier *= RandomReal(1, 1);
    roundpointmultiplier = RandomReal(1.01, 1.03);
}

rule: "3 Set Round Kills"
if (Z == 1)
if (O == false)
{
    # modify this based on difficulty
    extraVar[1] = 6 + FirstOf(extraVar) * 3;
    Wait(1, WaitBehavior.IgnoreCondition);
    Z = false;
}

rule: "5 Time manager"
{
    # @Condition O == false\nneed to change later when using soft restart
    if (IsAssemblingHeroes())
    {
        SetMatchTime(5);
        # needs to check when game is not started yet that way player always spends time in spawn
        Wait(6, WaitBehavior.IgnoreCondition);
    }
    # currently causes issues when the first game ends and all players die
    Wait(40, WaitBehavior.IgnoreCondition);
    SetMatchTime(3599);
    Wait(3000, WaitBehavior.AbortWhenFalse);
    LoopIfConditionIsTrue();
}

rule: "6 Defeat (needs to be refined for soft restart)"
if (IsTrueForAll(AllPlayers(Team.Team1), IsDead(ArrayElement())) == true)
if (IsTrueForAll(AllPlayers(Team.Team1), HasSpawned(ArrayElement())) == true)
{
    Wait(2, WaitBehavior.AbortWhenFalse);
    setspawn = RandomInteger(0, 5);
    DestroyAllDummyBots();
    StartCamera(AllPlayers(Team.Team1), Vector(317.328, -25.644, -140.906), Vector(320.513, -24.05, -134.612), 0);
    DestroyAllHudText();
    DestroyAllEffects();
    # delete players credit card and reset points
    Wait(4, WaitBehavior.IgnoreCondition);
    GoToAssembleHeroes();
   #getoutofspawn();
