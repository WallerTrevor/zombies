rule: "393 POINTS Omnic kill (final hit)"
Event.OnFinalBlow
Team.Team1
{
    if (!IsMeleeing(EventPlayer()))
    {
        if (!EventWasCriticalHit())
        {
            points += (50 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            extraVar[30] += (50 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
            SkipIf(H != 1, 1);
            SkipIf(H == 1, 1);
            R += 100 * H;
            xp[currentheroxp] += 5;
        }
        else if (EventWasCriticalHit())
        {
            points += (100 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            extraVar[30] += (100 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
            SkipIf(H != 1, 1);
            SkipIf(H == 1, 1);
            R += 200 * H;
            xp[currentheroxp] += 10;
        }
    }
    else if (IsMeleeing(EventPlayer()))
    {
        points += (60 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
        extraVar[30] += (60 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 250, RateChaseReevaluation.DestinationAndRate);
        SkipIf(H != 1, 1);
        SkipIf(H == 1, 1);
        R += 120 * H;
        xp[currentheroxp] += 6;
    }
    SetUltimateCharge(EventPlayer(), UltimateChargePercent(EventPlayer()) + 2);
}

rule: "396 POINTS Omnic kill (elimination)"
Event.OnElimination
Team.Team1
{
    if (!IsMeleeing(EventPlayer()))
    {
        if (!EventWasCriticalHit())
        {
            # prob should add heropoints list to finalblow too and melee
            if (ArrayContains(AllDamageHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 15;
            }
            else if (ArrayContains(AllSupportHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 5;
            }
            else if (ArrayContains(AllTankHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 10;
            }
            points += (40 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            extraVar[30] += (40 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            SkipIf(H != 1, 1);
            SkipIf(H == 1, 1);
            R += 80 * H;
            xp[currentheroxp] += 5;
        }
        else if (EventWasCriticalHit())
        {
            if (ArrayContains(AllDamageHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 30;
            }
            else if (ArrayContains(AllSupportHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 10;
            }
            else if (ArrayContains(AllTankHeroes(), HeroOf(EventPlayer())))
            {
                heropoints = 20;
            }
            points += (80 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            extraVar[30] += (80 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
            SkipIf(H != 1, 1);
            SkipIf(H == 1, 1);
            R += 160 * H;
            xp[currentheroxp] += 10;
        }
    }
    else if (IsMeleeing(EventPlayer()))
    {
        if (ArrayContains(AllDamageHeroes(), HeroOf(EventPlayer())))
        {
            heropoints = 45;
        }
        else if (ArrayContains(AllSupportHeroes(), HeroOf(EventPlayer())))
        {
            heropoints = 15;
        }
        else if (ArrayContains(AllTankHeroes(), HeroOf(EventPlayer())))
        {
            heropoints = 30;
        }
        points += (70 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
        extraVar[30] += (70 + heropoints * H) * roundpointmultiplier ^ (FirstOf(extraVar) - 1);
        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 250, RateChaseReevaluation.DestinationAndRate);
        SkipIf(H != 1, 1);
        SkipIf(H == 1, 1);
        R += 70 * H;
        xp[currentheroxp] += 7;
    }
    SetUltimateCharge(EventPlayer(), UltimateChargePercent(EventPlayer()) + 2);
}

