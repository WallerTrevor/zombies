rule: "73 Headshot maniac Perk add damage"
Event.OnDamageDealt
Team.Team1
if (perk[Perk.HeadshotManiac] == 1)
if (EventWasCriticalHit() == true)
if (damagevariable < 391)
{
    damagevariable += 10;
    SetDamageDealt(EventPlayer(), damagevariable);
}

rule: "74 headshot maniac Perk remove damage"
Event.OnDamageDealt
Team.Team1
# make it so this plays nicely with pack a punch
if (EventWasCriticalHit() == false)
if (damagevariable >= 55)
if (perk[Perk.HeadshotManiac] == 1)
{
    damagevariable -= 2.5;
    SetDamageDealt(EventPlayer(), damagevariable);
}

rule: "jugg tier 2 and 3"
Event.OnDamageTaken
Team.Team1
if (perk[Perk.Juggernaut] > 0)
{
    switch (perk[Perk.Juggernaut])
    {
        case 2:
            Wait(10, WaitBehavior.RestartWhenTrue);
            # need to make sure this doesnt stack infinitely
            AddHealthPoolToPlayer(EventPlayer(), HealthType.Health, 25, false, false);
            break;

        case 3:
            Wait(10, WaitBehavior.RestartWhenTrue);
            AddHealthPoolToPlayer(EventPlayer(), HealthType.Health, 50, false, false);
            break;
    }
}

rule: "give juggernaut perk max health"
Event.OngoingPlayer
Team.Team1
if (perk[Perk.Juggernaut] == 1)
{
    SetMaxHealth(EventPlayer(), 200);
}

rule: "109 PERK player hit speed boost sprint burst"
Event.OnDamageTaken
Team.Team1
if (EventDamage() == true)
if (perk[Perk.Sprintboost] == 1)
{
    switch (perk[Perk.Juggernaut])
    {
        case 1:
            SetMoveSpeed(EventPlayer(), 180);
            Wait(1, WaitBehavior.IgnoreCondition);
            SetMoveSpeed(EventPlayer(), 105);
            break;

        case 2:
            SetMoveSpeed(EventPlayer(), 200);
            Wait(1, WaitBehavior.IgnoreCondition);
            SetMoveSpeed(EventPlayer(), 107);
            break;

        case 3:
            SetMoveSpeed(EventPlayer(), 220);
            Wait(1, WaitBehavior.IgnoreCondition);
            SetMoveSpeed(EventPlayer(), 110);
            break;
    }
}

rule: "79 player died with maniac"
Event.OnDeath
Team.Team1
if (perk[Perk.HeadshotManiac] == 1)
{
    Died[SlotOf(EventPlayer())] = NearestWalkablePosition(EventPlayer());
    BigMessage(AllPlayers(Team.All), <"<0> <1>", EventPlayer(), RandomValueInArray(diedphrase)>);
    E[SlotOf(EventPlayer())] = true;
    SetMaxHealth(EventPlayer(), 100);
    StopForcingHero(EventPlayer());
    MinWait();
    perk[Perk.Juggernaut] = false;
    MinWait();
    healthmax = 50;
    perk[Perk.HeadshotManiac] = false;
    MinWait();
    SetDamageDealt(EventPlayer(), 100);
    damagevariable = 100;
    MinWait();
    healvariable = 100;
    SetHealingDealt(EventPlayer(), 100);
    perk[Perk.SpeedCola] = false;
    Wait(0.1, WaitBehavior.IgnoreCondition);
    perk[Perk.Sprintboost] = false;
    SetAllowedHeroes(EventPlayer(), allowedheroes);
}

rule: "77 multiplayer extra life Perk"
Event.OnDeath
Team.Team1
if (perk[Perk.selfrevive] == 1)
{
    # should set this to be a quick revive perk
    SetStatus(EventPlayer(), null, Status.KnockedDown, 2);
    Resurrect(EventPlayer());
    SetStatus(EventPlayer(), null, Status.Invincible, 10);
    perk[Perk.selfrevive] = 0;
}
