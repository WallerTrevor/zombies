
rule: "202 Purchase Follower action"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
# is heroradius variable needed?
if (IsTrueForAny(twoDvectorsArray[2], DistanceBetween(ArrayElement(), EventPlayer()) < 2) == true)
{
    Wait(1, WaitBehavior.AbortWhenFalse);
    # Loop through all heroes
    for (i = 0; CountOf(etcArray[5]); 1)
    {
        if (DistanceBetween(EventPlayer(), twoDvectorsArray[2][i]) < 2)
        {
            if (points >= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier - creditcardlimit, Rounding.Nearest))
            {
                followerbuy = etcArray[5][i];
                MinWait();
                Subfollowerbuy();
                points -= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier, Rounding.Nearest);
                points2 -= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier, Rounding.Nearest);
            }
            else
            {
                SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(etcArray[5][i]), etcArray[7][i]>);
            }
            break;
        }
    }
}

rule: "Purchase Mystery Follower action"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
if (DistanceBetween(EventPlayer(), extraVar[25]) <= 2)
{
    Wait(1, WaitBehavior.AbortWhenFalse);
    if (points >= RoundToInteger(FirstOf(twoDnumbersArray[6]) / 3 * costmultiplier - creditcardlimit, Rounding.Nearest))
    {
        followerbuy = RandomValueInArray(etcArray[5]);
        MinWait();
        Subfollowerbuy();
        points -= RoundToInteger(FirstOf(twoDnumbersArray[6]) / 3 * costmultiplier, Rounding.Nearest);
        points2 -= RoundToInteger(FirstOf(twoDnumbersArray[6]) / 3 * costmultiplier, Rounding.Nearest);
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(FirstOf(etcArray[5])), FirstOf(etcArray[7])>);
    }
}


rule: "229 buy perks and power activate"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsTrueForAny(twoDvectorsArray[3], [DistanceBetween(ArrayElement(), EventPlayer()) < 2]) == true)
{
    if (ServerLoadPeak() < 235)
    {
        for (i = 0; CountOf(twoDvectorsArray[3]); 1)
        {
            if (DistanceBetween(EventPlayer(), twoDvectorsArray[3][i]) < 2 && i != 6)
            {
                if (extraVar[28] == 1)
                {
                    if (points >= RoundToInteger(twoDnumbersArray2[2][i] * costmultiplier - creditcardlimit, Rounding.Nearest))
                    {
                        if (perk[i] < 3)
                        {
                            points -= RoundToInteger(twoDnumbersArray2[2][i] * costmultiplier * cashback, Rounding.Nearest);
                            Wait(0.25, WaitBehavior.IgnoreCondition);
                            perk[i] += 1;
                            PlayEffect(AllPlayers(Team.Team1), PlayEffect.RingExplosionSound, Color.White, EventPlayer(), 70);
                            SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(Hero.Ramattra), perkmessages[i]>);
                            Wait(0.25, WaitBehavior.IgnoreCondition);
                            Communicate(EventPlayer(), Communication.EmoteUp);
                            Wait(0.05, WaitBehavior.IgnoreCondition);
                            SetMoveSpeed(EventPlayer(), 0);
                            Wait(2, WaitBehavior.IgnoreCondition);
                            SetMoveSpeed(EventPlayer(), 100);
                            break;
                        }
                        else
                        {
                            SmallMessage(EventPlayer(), <"<0> You already have the max tier!", HeroIconString(Hero.Ramattra)>);
                            break;
                        }
                    }
                    else if (points < twoDnumbersArray2[2][i])
                    {
                        SmallMessage(EventPlayer(), <"<0> No points? NO perks!", HeroIconString(Hero.Ramattra)>);
                        break;
                    }
                }
                else
                {
                    SmallMessage(EventPlayer(), <"<0> The power is not ON!", HeroIconString(Hero.Ramattra)>);
                    # Stop after the first match
                    break;
                }
            }
        }
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> What do you think you're doing! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
    }
}

