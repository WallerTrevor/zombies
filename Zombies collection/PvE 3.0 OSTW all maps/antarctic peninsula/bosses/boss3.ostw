import "../Main/index.ostw";

void SpawnImperialWarmech() "spawn boss 3: Imperial Warmech"
{
    CreateDummyBot(Hero.Dva, Team.Team2, -1, bossSpot, Vector(0, 0, 0));
    bossBody = LastCreatedEntity();
    bossBots = [bossBody];

    Wait(0.5, WaitBehavior.IgnoreCondition);
    SetKnockbackReceived(bossBody, 0);
    SetMoveSpeed(bossBody, 100);
    SetDamageDealt(bossBody, 200);
    StartScalingPlayer(bossBody, 3 * BossScale(), true);
    StartForcingDummyBotName(bossBody, "Imperial warmech ");

    SetUltimateAbilityEnabled(bossBody, false);

    bossBody.zombieBusy = true;
    Wait(3, WaitBehavior.IgnoreCondition);
    bossPartList = [
        [Hero.WreckingBall, Vector(0, 6.1, 1), BossPart.Cannon],
        [Hero.WreckingBall, Vector(2.15, 5.4, 1), BossPart.Cannon],
        [Hero.WreckingBall, Vector(-2.15, 5.4, 1), BossPart.Cannon],
        [Hero.Bastion, Vector(2, 3, 1), BossPart.MachineGun],
        [Hero.Bastion, Vector(-2, 3, 1), BossPart.MachineGun]
    ];
    SpawnBossParts();
    AddHealthPoolToPlayer(bossBody, HealthType.Armor, 9999, true, true);
}

rule: "284 Cannon stats"
Event.OngoingPlayer
Team.Team2
Player.WreckingBall
if (Bosssequencer == 3)
if (Part == BossPart.Cannon)
{
    SetHealingReceived(EventPlayer(), 0);
    SetMaxHealth(EventPlayer(), 500);
    StartForcingDummyBotName(EventPlayer(), "Homing Cannon");
    Wait(0.35, WaitBehavior.IgnoreCondition);
    WaitUntil(IsDead(EventPlayer()), 99999);
    SetStatus(PlayersWithinRadius(EventPlayer(), 5, TeamOf(EventPlayer()), RadiusLOS.Off), null, Status.Stunned, 2);
}

rule: "285 Cannon shoot"
Event.OngoingPlayer
Team.Team2
Player.WreckingBall
if (Bosssequencer == 3)
if (Part == BossPart.Cannon)
if (IsButtonHeld(FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Button.PrimaryFire) == true)
{
    CreateHomingProjectile(ProjectileType.SigmaHypersphere, EventPlayer(), null, null, Relative.ToWorld, ModifyHealthType.Damage, OppositeTeamOf(TeamOf(EventPlayer())), 75, 0, 5, PlayEffect.BastionTankCannonExplosionEffect, PlayEffect.BastionTankCannonExplosionSound, 0.1, 30, 5, 5, FirstOf(SortedArray(FilteredArray(AllLivingPlayers(OppositeTeamOf(TeamOf(EventPlayer()))), HasSpawned(ArrayElement()) && ArrayElement() != EventPlayer()), AngleBetweenVectors(FacingDirectionOf(EventPlayer()), ArrayElement() - EyePosition(EventPlayer())))), 0.5);
    PlayEffect(AllPlayers(Team.All), PlayEffect.CassidyFlashbangExplosionSound, Color.White, EyePosition(EventPlayer()), 100);
    PlayEffect(AllPlayers(Team.All), PlayEffect.BadExplosion, Color.Gray, EventPlayer(), 2);
    Wait(1, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "286 Machine gun stats"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (Bosssequencer == 3)
if (IsDummyBot(EventPlayer()) == true)
if (Part == BossPart.MachineGun)
{
    SetDamageDealt(EventPlayer(), 100);
    StartScalingPlayer(EventPlayer(), 1.25 * BossScale(), true);
    SetMaxHealth(EventPlayer(), 1000);
    StartForcingDummyBotName(EventPlayer(), "Machine gun");
    ForceThrottle(EventPlayer(), 1, 1, 0, 1, 0, 1);
    Wait(0.35, WaitBehavior.IgnoreCondition);
    WaitUntil(IsDead(EventPlayer()), 99999);
    SetStatus(PlayersWithinRadius(EventPlayer(), 5, TeamOf(EventPlayer()), RadiusLOS.Off), null, Status.Stunned, 2);
}

rule: "287 Machine gun keep form"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (Bosssequencer == 3)
if (Part == BossPart.MachineGun)
if (IsUsingAbility1(EventPlayer()) == false)
if (IsDummyBot(EventPlayer()) == true)
{
    SetAbilityCooldown(EventPlayer(), Button.Ability1, 0);
    PressButton(EventPlayer(), Button.Ability1);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "288 Machine gun shoot"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (Bosssequencer == 3)
if (Part == BossPart.MachineGun)
if (IsButtonHeld(FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Button.PrimaryFire) == true)
if (IsDummyBot(EventPlayer()) == true)
{
    StartHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(2, WaitBehavior.IgnoreCondition);
    StopHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(1, WaitBehavior.AbortWhenFalse);
    LoopIfConditionIsTrue();
}

rule: "289 Imperial warmech set attacks"
Event.OngoingPlayer
Team.Team2
Player.Dva
if (Bosssequencer == 3)
if (EventPlayer() == bossBody)
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
if (IsAlive(EventPlayer()) == true)
{
    EventPlayer().Major_Attacks = RandomInteger(2, 6);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    if (EventPlayer().Major_Attacks == 2)
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactSound, Color.White, EyePosition(EventPlayer()), 200);
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactEffect, Color.White, PositionOf(EventPlayer()), 1);
        Wait(0.75, WaitBehavior.IgnoreCondition);
    }

    EventPlayer().warmachAttackParts = [
        [Hero.Pharah, Vector(0, 5, 0)],
        [Hero.Zarya, Vector(0, 2, 0)],
        [Hero.Sojourn, Vector(0, 5, 0)],
        [Hero.Moira, Vector(0, 4, 0)],
        [Hero.Junkrat, Vector(0, 4, -1)]
    ];
    for (EventPlayer().warmachAttackIndex = 0; CountOf(EventPlayer().warmachAttackParts); 1)
    {
        if (EventPlayer().warmachAttackIndex == EventPlayer().Major_Attacks - 2)
        {
            CreateDummyBot(EventPlayer().warmachAttackParts[EventPlayer().warmachAttackIndex][0], Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));

            ModifyVariable(bossBots, Operation.AppendToArray, LastCreatedEntity());
            MinWait();
            SetStatus(LastOf(bossBots), null, Status.PhasedOut, 9999);

            StartScalingPlayer(LastOf(bossBots), BossScale(), true);
            AttachPlayers(LastOf(bossBots), EventPlayer(), EventPlayer().warmachAttackParts[EventPlayer().warmachAttackIndex][1] * BossScale());
            if (EventPlayer().Major_Attacks == 3)
            {
                StartFacing(LastOf(bossBots), FacingDirectionOf(EventPlayer()) + Vector(RandomInteger(-1, 1), 0, 0), 1000, Relative.ToPlayer, FacingRev.DirectionAndTurnRate);
            }
            else
            {
                StartFacing(LastOf(bossBots), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
            }
            Wait(7, WaitBehavior.IgnoreCondition);
            LoopIfConditionIsTrue();
        }
    }
}

rule: "290 Rockets function"
Event.OngoingPlayer
Team.Team2
Player.Pharah
if (Bosssequencer == 3)
if (IsDummyBot(EventPlayer()) == true)
{
    SetDamageDealt(EventPlayer(), 100);
    SetInvisible(EventPlayer(), InvisibleTo.All);
    StartForcingDummyBotName(EventPlayer(), "Rockets");
    Wait(0.25, WaitBehavior.IgnoreCondition);
    SetUltimateCharge(EventPlayer(), 100);
    PressButton(EventPlayer(), Button.Ultimate);
    Wait(2.5, WaitBehavior.IgnoreCondition);
    SetUltimateCharge(EventPlayer(), 100);
    PressButton(EventPlayer(), Button.Ultimate);
    Wait(3.5, WaitBehavior.IgnoreCondition);
    DestroyDummyBot(TeamOf(EventPlayer()), SlotOf(EventPlayer()));
}

