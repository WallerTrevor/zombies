enum Perk
{
    Juggernaut = 0,
    Sprintboost = 1,
    selfrevive = 2,
    Doorman = 3,
    SpeedCola = 4,
    packapunch = 5
}

enum Buyable
{
    Juggernaut = 0,
    Sprintboost = 1,
    SelfRevive = 2,
    Doorman = 3,
    SpeedCola = 4,
    packapunch = 5,
    Power = 6,
    SprintBurst = 7,
    OmnicBomb = 8,
    Count = 9
}

enum PerkTier
{
    Tier1 = 1,
    Tier2 = 2,
    Tier3 = 3
}

enum WallState
{
    Open = 0,
    Closed = 1
}

struct Door
{

    public Vector Corner;
    public Vector OppositeCorner;
    public Vector Center;
    public Vector Facing;
    public Vector Side;
    public Number Width;
    public WallState State;
    public Number Zone;

    public Vector BeamSpan;
    public Any BeamA;
    public Any BeamB;
}

struct BankTier
{
    public Number Cost;
    public Number InterestRate;
}

struct CreditCardTier
{
    public Number Cost;
    public Number Limit;
    public Number Cashback;
    public Number InterestRate;
}

