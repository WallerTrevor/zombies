rule: "Toggle edit mode"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
{
    # @Disabled\ntoggle edit
    ToggleEdit = !ToggleEdit;
    # prevent spamming
    Wait(0.25, WaitBehavior.IgnoreCondition);
}

rule: "Enable edit mode"
Event.OngoingPlayer
Team.Team1
if (ToggleEdit == true)
{
    # @Disabled\nsetSlowMotion(10)\ncreateDummy(eventPlayer.getHero(), Team.1, getNumberOfPlayers(Team.1) + 1, eventPlayer, eventPlayer.getFacingDirection())\nstart noclipping from current position
    Noclip = EyePosition(EventPlayer());
    # disable controls
    SetAbility1Enabled(EventPlayer(), false);
    SetAbility2Enabled(EventPlayer(), false);
    SetPrimaryFireEnabled(EventPlayer(), false);
    SetSecondaryFireEnabled(EventPlayer(), false);
    SetUltimateAbilityEnabled(EventPlayer(), false);
    SetMeleeEnabled(EventPlayer(), false);
    SetJumpEnabled(EventPlayer(), false);
    # don't physically move
    SetMoveSpeed(EventPlayer(), false);
    # don't fall
    SetGravity(EventPlayer(), false);
    # make a camera from the noclip position and copy the player's facing direction
    StartCamera(EventPlayer(), Noclip, Noclip + FacingDirectionOf(EventPlayer()), 128);
    # take into account throttle, facing direction, jump, and crouch inputs to make a decent noclip  # chase the noclip's position
    ChaseVariableAtRate(Noclip, Noclip + (FacingDirectionOf(EventPlayer()) * ZOf(ThrottleOf(EventPlayer())) + WorldVectorOf(ThrottleOf(EventPlayer()) * Vector(true, false, false), EventPlayer(), LocalVector.Rotation) + Up() * (IsButtonHeld(EventPlayer(), Button.Jump) - IsButtonHeld(EventPlayer(), Button.Crouch))) * 100, 28, RateChaseReevaluation.DestinationAndRate);
    # wait for a bit so the player doesn't see where they are teleported to
    Wait(0.032, WaitBehavior.IgnoreCondition);
    # go to the sky
    Teleport(EventPlayer(), Vector(0, 10000, 0));
}

rule: "Disable edit mode"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == false)
if (ToggleEdit == false)
{
    # @Disabled\nsetSlowMotion(100)
    DestroyDummyBot(Team.Team1, NumberOfPlayers(Team.Team1));
    # save some server load
    StopChasingVariable(Noclip);
    # subtract player's height from noclipPosition so that the camera is teleported to where the noclip camera was
    Teleport(EventPlayer(), Noclip - (EyePosition(EventPlayer()) - PositionOf(EventPlayer())));
    # return values to normal
    SetGravity(EventPlayer(), 100);
    SetMoveSpeed(EventPlayer(), 100);
    # enable controls
    SetAbility1Enabled(EventPlayer(), true);
    SetAbility2Enabled(EventPlayer(), true);
    SetPrimaryFireEnabled(EventPlayer(), true);
    SetSecondaryFireEnabled(EventPlayer(), true);
    SetUltimateAbilityEnabled(EventPlayer(), true);
    SetMeleeEnabled(EventPlayer(), true);
    SetJumpEnabled(EventPlayer(), true);
    SetUltimateCharge(EventPlayer(), 100);
    # player is back in world, can use native player camera
    StopCamera(EventPlayer());
    # cancel momentum
    ApplyImpulse(EventPlayer(), VelocityOf(EventPlayer()) * -1, SpeedOf(EventPlayer()), Relative.ToWorld, ContraryMotion.Incorporate);
}

rule: "Initial Global"
{
    AllPos = [];
    AllDir = [];
    firstpos = [];
    secondpos = [];
    firstpoint2 = [];
    secondpoint2 = [];
    second = [];
    z = [];
    Wall_ID = [];
    g_beamType = [];
    doors = [];
    zoneDoors = [];
}

rule: "Initial Player"
Event.OngoingPlayer
{
    filterpos = false;
    lastsavedpos = false;
    closestbodypos = false;
    fullbodypos = false;
    prevpos_intersection = false;
    active_wall = [];
    closestwall = [];
}

rule: "Collision Logic"
Event.OngoingPlayer
Team.Team1
if (IsAlive(EventPlayer()) == true)
if (extraVar[3] == 1)
if (IsDummyBot(EventPlayer()) == false)
if (IsTrueForAny(firstpos, [DistanceBetween(ArrayElement(), EventPlayer()) < 10]) == true)
{
    if (extraVar[29] == 1)
    {
        WaitUntil(extraVar[29] == 0, 999999995904);
        Wait(1.5, WaitBehavior.IgnoreCondition);
    }
    if (outofpsawn == 0)
    {
        WaitUntil(outofpsawn == 1, 999999995904);
        Wait(1.5, WaitBehavior.IgnoreCondition);
    }
    lastsavedpos = (EyePosition(EventPlayer()) + PositionOf(EventPlayer())) / 2;
    Wait(0.16 + 0.32 * ServerLoadPeak() / 255 + SlotOf(EventPlayer()) * 0.016, WaitBehavior.IgnoreCondition);
    WaitUntil(Max(ServerLoadAverage(), ServerLoad()) < 245, 0.5);
    closestwall = FilteredArray(AllPos, DistanceBetween(AllPos[CurrentArrayIndex()], EventPlayer()) <= DistanceBetween(AllPos[CurrentArrayIndex()], firstpos[CurrentArrayIndex()]) || active_wall[CurrentArrayIndex()] == 1 || DotProduct(DirectionTowards(ArrayElement(), lastsavedpos), AllDir[CurrentArrayIndex()]) > 0 != DotProduct(DirectionTowards(ArrayElement(), EventPlayer()), AllDir[CurrentArrayIndex()]) > 0);
    for (x_ = 0; CountOf(closestwall); 1)
    {
        if (Wall_ID[z] == 0)
        {
            active_wall[z] = 0;
            # needs to use gamemode wide movement speed, when player gets perks
            SetMoveSpeed(EventPlayer(), 100);
        }
        z = IndexOfArrayValue(AllPos, closestwall[x_]);
        if (Wall_ID[z] == 1 || Wall_ID[z] == 3 || Wall_ID[z] == 5)
        {
            if (YOf(firstpos[z]) >= YOf(PositionOf(EventPlayer())) && YOf(firstpos[z]) <= YOf(EyePosition(EventPlayer()) + Vector(0, 0.2, 0)))
            {
                closestbodypos = firstpos[z];
            }
            else if (YOf(secondpos[z]) >= YOf(PositionOf(EventPlayer())) && YOf(secondpos[z]) <= YOf(EyePosition(EventPlayer()) + Vector(0, 0.2, 0)))
            {
                closestbodypos = secondpos[z];
            }
            else
            {
                closestbodypos = PositionOf(EventPlayer());
            }
            fullbodypos = Vector(XOf(EyePosition(EventPlayer())), YOf(closestbodypos), ZOf(EyePosition(EventPlayer())));
            filterpos = fullbodypos + AllDir[z] * DotProduct(AllPos[z] - fullbodypos, AllDir[z]) / DotProduct(AllDir[z], AllDir[z]);
            if (Wall_ID[z] == 1 || Wall_ID[z] == 3)
            {
                if (DotProduct(DirectionTowards(AllPos[z], lastsavedpos), AllDir[z]) > 0 != DotProduct(DirectionTowards(AllPos[z], fullbodypos), AllDir[z]) > 0)
                {
                    intersection_length = DotProduct(AllPos[z] - fullbodypos, AllDir[z]) / DotProduct(DirectionTowards(lastsavedpos, fullbodypos), AllDir[z]);
                    prevpos_intersection = fullbodypos + DirectionTowards(lastsavedpos, fullbodypos) * Vector(1, 1, 1) * intersection_length;
                    if (DotProduct(DirectionTowards(firstpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(firstpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(firstpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(secondpos[z], prevpos_intersection)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(secondpos[z], prevpos_intersection)) >= 0)
                    {
                        CancelPrimaryAction(EventPlayer());
                        Teleport(EventPlayer(), prevpos_intersection + DirectionTowards(prevpos_intersection, lastsavedpos) * Vector(1, 0, 1) * 2);
                    }
                }
            }
            thickness = 0;
            if (Wall_ID[z] == 5)
            {
                thickness = 8;
            }
            else
            {
                thickness = 4;
            }
            if (DistanceBetween(fullbodypos, filterpos) <= thickness && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(firstpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(firstpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(firstpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(secondpos[z]), YOf(firstpos[z]), ZOf(secondpos[z]))), DirectionTowards(secondpos[z], filterpos)) >= 0 && DotProduct(DirectionTowards(secondpos[z], Vector(XOf(firstpos[z]), YOf(secondpos[z]), ZOf(firstpos[z]))), DirectionTowards(secondpos[z], filterpos)) >= 0)
            {
                if (active_wall[z] == false)
                {
                    active_wall[z] = 1;
                    if ((Wall_ID[z] == 1 || Wall_ID[z] == 3) && is_Grounded == false)
                    {
                        SetGravity(EventPlayer(), 100);
                    }
                    else if (Wall_ID[z] == 5)
                    {
                        DisableMovementCollisionWithEnvironment(EventPlayer(), false);
                    }
                }
                if (Wall_ID[z] == 1)
                {
                    ApplyImpulse(EventPlayer(), DirectionTowards(filterpos, fullbodypos) * Vector(1, 0, 1), 1, Relative.ToWorld, ContraryMotion.Cancel);
                    if (doorNotif == 0)
                    {
                        doorNotif = 1;
                    }
                    if (IsButtonHeld(EventPlayer(), Button.Interact) && points >= 1000 * costmultiplier - creditcardlimit)
                    {
                        PlayEffect(AllPlayers(Team.All), PlayEffect.GoodExplosion, Color.White, AllPos[z], 50);
                        PlayEffect(AllPlayers(Team.All), PlayEffect.LucioSoundBarrierCastSound, Color.White, AllPos[z], 100);
                        points -= RoundToInteger(1000 * costmultiplier * cashback, Rounding.Nearest);
                        extraVar[41] = zoneDoors[extraVar[42]];
                        for (i = 0; CountOf(extraVar[41]); 1)
                        {
                            z = extraVar[41][i];
                            if (Wall_ID[z] == 1)
                            {
                                if (doors[z * 2] != null)
                                {
                                    DestroyEffect(doors[z * 2]);
                                }
                                if (doors[z * 2 + 1] != null)
                                {
                                    DestroyEffect(doors[z * 2 + 1]);
                                }
                                Wall_ID[z] = 0;
                                active_wall[z] = 0;
                            }
                        }
                        SmallMessage(EventPlayer(), "Zone bought!");
                        doorNotif = 0;
                        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
                        MinWait();
                        SetMoveSpeed(EventPlayer(), 100);
                    }
                    SetMoveSpeed(EventPlayer(), 100 - DotProduct(DirectionTowards(EyePosition(EventPlayer()), EyePosition(EventPlayer()) + WorldVectorOf(ThrottleOf(EventPlayer()), EventPlayer(), LocalVector.Rotation)), DirectionTowards(filterpos, fullbodypos) * -1) * 100);
                }
                else if (Wall_ID[z] == 3)
                {
                    ApplyImpulse(EventPlayer(), DirectionTowards(filterpos, fullbodypos), 2 * SpeedOf(EventPlayer()), Relative.ToWorld, ContraryMotion.Cancel);
                }
            }
            else
            {
                active_wall[z] = 0;
                # needs to use gamemode wide movement speed, when player gets perks
                SetMoveSpeed(EventPlayer(), 100);
            }
        }
    }
    LoopIfConditionIsTrue();
}

rule: "Reset"
Event.OngoingPlayer
if (CountOf(RemoveFromArray(active_wall, 0)) == 0)
{
    EnableMovementCollisionWithEnvironment(EventPlayer());
}

rule: "Make door arrays"
if (extraVar[3] == 1)
if (doormade == 0)
{
    i = 0;
    Wait(5, WaitBehavior.IgnoreCondition);
    looping = 0;
    Beameffectdoors = [];
    while (i < CountOf(twoDvectorsArray[4]))
    {
        if (!(i % 2))
        {
            MinWait();
        }
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping] + Up() * FirstOf(twoDnumbersArray2)[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + Up() * FirstOf(twoDnumbersArray2)[looping + 1]);
        ModifyVariable(Beameffectdoors, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping]);
        # if boolean is false, then use infinite height
        if (FirstOf(twoDnumbersArray2)[looping + 3] == 0)
        {
            ModifyVariable(firstpos, Operation.AppendToArray, twoDvectorsArray[4][i]);
            ModifyVariable(secondpos, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping] + Vector(0, 50, 0));
            ModifyVariable(firstpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + Vector(0, 50, 0));
            ModifyVariable(secondpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping]);
            ModifyVariable(AllPos, Operation.AppendToArray, (firstpos[i] + secondpos[i]) / 2);
            ModifyVariable(AllDir, Operation.AppendToArray, DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] + 180, 0));
        }
        else if (FirstOf(twoDnumbersArray2)[looping + 3] == 1)
        {
            ModifyVariable(firstpos, Operation.AppendToArray, twoDvectorsArray[4][i]);
            ModifyVariable(secondpos, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping + 4] + Up() * FirstOf(twoDnumbersArray2)[looping + 5]);
            ModifyVariable(firstpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + Up() * FirstOf(twoDnumbersArray2)[looping + 5]);
            ModifyVariable(secondpoint2, Operation.AppendToArray, twoDvectorsArray[4][i] + DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] - 90, 0) * FirstOf(twoDnumbersArray2)[looping + 4]);
            ModifyVariable(AllPos, Operation.AppendToArray, (firstpos[i] + secondpos[i]) / 2);
            ModifyVariable(AllDir, Operation.AppendToArray, DirectionFromAngles(FirstOf(twoDnumbersArray2)[looping + 2] + 180, 0));
        }
        if (FirstOf(twoDnumbersArray2)[looping + 3] == 1)
        {
            looping += 6;
        }
        else
        {
            looping += 4;
        }
        i += 1;
    }
    # for i in range(len(firstpos)):
    doormade = 1;
}

