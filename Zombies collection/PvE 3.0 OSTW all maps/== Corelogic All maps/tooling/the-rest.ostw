rule: "DAMAGE Melee does more damage"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Melee) == true)
{
    Wait(0.05, WaitBehavior.IgnoreCondition);
    SetDamageDealt(EventPlayer(), 350);
    # the reason this is toggled, is to allow a few frames before the melee animation starts, so the damage can be applied
    AllowButton(EventPlayer(), Button.Melee);
    PressButton(EventPlayer(), Button.Melee);
    Wait(0.5, WaitBehavior.IgnoreCondition);
    SetDamageDealt(EventPlayer(), damagevariable);
    # i did try a direct set damage, but it was not working, so this is the best way to do it, as it allows the damage to be applied only for melee attacks
    DisallowButton(EventPlayer(), Button.Melee);
}

