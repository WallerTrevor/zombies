disabled rule: "293 Imperial warmech destroyed"
Event.OngoingPlayer
Team.Team2
Player.Dva
if (IsInAlternateForm(EventPlayer()) == true)
{
    Wait(0.1, WaitBehavior.AbortWhenFalse);
    Kill(PlayersWithinRadius(EventPlayer(), 7, TeamOf(EventPlayer()), RadiusLOS.Off), null);
    PlayEffect(AllPlayers(Team.All), PlayEffect.BastionTankCannonExplosionSound, Color.White, EyePosition(EventPlayer()), 200);
    PlayEffect(AllPlayers(Team.All), PlayEffect.BastionTankCannonExplosionEffect, Color.White, EyePosition(EventPlayer()) + Vector(RandomInteger(-4, 4), RandomInteger(-3, 3), RandomInteger(-3, 3)), 1);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    WaitUntil(IsDead(EventPlayer()), 99999);
    DestroyAllEffects();
    ClearStatus(EventPlayer(), Status.Burning);
}

