rule: "18 Get out of Spawn"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == false)
if (outofpsawn == 1)
{
    Wait(1, WaitBehavior.IgnoreCondition);

    joinTeammate = teamOutOfSpawn ? FirstOf(FilteredArray(AllLivingPlayers(Team.Team1), !IsDummyBot(ArrayElement()) && ArrayElement() != EventPlayer() && ArrayElement().outofpsawn == 1 && !IsInSpawnRoom(ArrayElement()))) : null;
    if (joinTeammate != null)
    {
        Teleport(EventPlayer(), PositionOf(joinTeammate));
        doorSkipCheck = true;
    }
    else
    {
        getoutofspawn();
        teamOutOfSpawn = true;
    }
}

rule: "late joiner: catch up with the team"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == false)
if (HasSpawned(EventPlayer()) == true)
if (outofpsawn == 0)
if (IsTrueForAny(AllPlayers(Team.Team1), ArrayElement().outofpsawn == 1) == true)
{
    Wait(3, WaitBehavior.AbortWhenFalse);

    if (start == 1)
    {
        points = startingPoints;
        points2 = points;
        cashback = 1;
    }
    outofpsawn = 1;
}
