disabled rule: "288 Machine gun shoot"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (IsButtonHeld(FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Button.PrimaryFire) == true)
if (IsDummyBot(EventPlayer()) == true)
{
    StartHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(2, WaitBehavior.IgnoreCondition);
    StopHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(1, WaitBehavior.AbortWhenFalse);
    LoopIfConditionIsTrue();
}

disabled rule: "289 Imperial warmech set attacks"
Event.OngoingPlayer
Team.Team2
Player.Dva
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
if (IsAlive(EventPlayer()) == true)
{
    EventPlayer().Major_Attacks = RandomInteger(2, 6);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    if (EventPlayer().Major_Attacks == 2)
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactSound, Color.White, EyePosition(EventPlayer()), 200);
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactEffect, Color.White, PositionOf(EventPlayer()), 1);
        Wait(0.75, WaitBehavior.IgnoreCondition);
    }

    EventPlayer().warmachAttackParts = [
        [Hero.Pharah, Vector(0, 5, 0)],
        [Hero.Zarya, Vector(0, 2, 0)],
        [Hero.Sojourn, Vector(0, 5, 0)],
        [Hero.Moira, Vector(0, 4, 0)],
        [Hero.Junkrat, Vector(0, 4, -1)]
    ];
    for (EventPlayer().warmachAttackIndex = 0; CountOf(EventPlayer().warmachAttackParts); 1)
    {
        if (EventPlayer().warmachAttackIndex == EventPlayer().Major_Attacks - 2)
        {
            CreateDummyBot(EventPlayer().warmachAttackParts[EventPlayer().warmachAttackIndex][0], Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
            MinWait();
            SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
            AttachPlayers(LastCreatedEntity(), EventPlayer(), EventPlayer().warmachAttackParts[EventPlayer().warmachAttackIndex][1]);
            if (EventPlayer().Major_Attacks == 3)
            {
                StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()) + Vector(RandomInteger(-1, 1), 0, 0), 1000, Relative.ToPlayer, FacingRev.DirectionAndTurnRate);
            }
            else
            {
                StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
            }
            Wait(7, WaitBehavior.IgnoreCondition);
            LoopIfConditionIsTrue();
        }
    }
}

disabled rule: "290 Rockets function"
