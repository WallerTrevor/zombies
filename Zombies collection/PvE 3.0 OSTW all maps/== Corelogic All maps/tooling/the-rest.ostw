rule: "509 bot name singleplayer"

if (NumberOfPlayers(Team.Team1) == 1)
if (FirstOf(extraVar) > 0)
if (aprilrng == 50)
{
    botNames = [
        "01000111 01100101",
        "01110100 00100000",
        "01101111 01110101",
        "01110100 00100000",
        "01101111 01100110",
        "00100000 01101000",
        "01100101 01110010",
        "01100101 00101110"
    ];

    for (i = 0; i < CountOf(botNames); 1)
    {
        StartForcingDummyBotName(
            PlayersInSlot(i, Team.Team2),
            botNames[i]
        );
    }
}

