rule: "202 Purchase hero message"
Event.OngoingPlayer
Team.Team1
if (extraPlayerVar[4] == false)
if (IsTrueForAny(twoDvectorsArray[2], DistanceBetween(ArrayElement(), EventPlayer()) < 2) == true)
{
    for (i = 0; CountOf(twoDvectorsArray[2]); 1)
    {
        if (DistanceBetween(EventPlayer(), twoDvectorsArray[2][i]) < 2)
        {
            Wait(0.1, WaitBehavior.IgnoreCondition);
            SmallMessage(EventPlayer(), <"<0> Press: <1> for Hero = <2>", HeroIconString(etcArray[5][i]), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2>", RoundToInteger(twoDnumbersArray[6][i] * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), <"<0> Points --- Ammo cost <1>", RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier, Rounding.Nearest), RoundToInteger(twoDnumbersArray[6][i] / 2 * costmultiplier, Rounding.Nearest)>>>);
            extraPlayerVar[4] = true;
            Wait(5, WaitBehavior.IgnoreCondition);
            extraPlayerVar[4] = false;
            break;
        }
    }
}

rule: "Purchase Mystery Box message"
Event.OngoingPlayer
Team.Team1
if (extraPlayerVar[5] == false)
if (DistanceBetween(EventPlayer(), extraVar[25]) <= 2)
if (extraVar[25] != null)
{
    Wait(0.1, WaitBehavior.IgnoreCondition);
    SmallMessage(EventPlayer(), <"<0> Press: <1> for Mystery Hero = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2> Points", RoundToInteger(950 * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), RoundToInteger(316.667 * costmultiplier, Rounding.Nearest)>>);
    extraPlayerVar[5] = true;
    Wait(5, WaitBehavior.IgnoreCondition);
    extraPlayerVar[5] = false;
}

rule: "Purchase perk machine message"
Event.OngoingPlayer
Team.Team1
if (extraPlayerVar[6] == false)
if (IsTrueForAny(twoDvectorsArray[3], [DistanceBetween(ArrayElement(), EventPlayer()) < 2]) == true)
if (powerconnected == true)
{
    for (i = 0; CountOf(twoDvectorsArray[3]); 1)
    {
        if (DistanceBetween(EventPlayer(), twoDvectorsArray[3][i]) < 2)
        {
            if (i != 6)
            {
                Wait(0.1, WaitBehavior.IgnoreCondition);
                SmallMessage(EventPlayer(), <"<0> Press: <1> for Perk = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> == <1> Points", perkNames[i], RoundToInteger(twoDnumbersArray2[2][i] * costmultiplier, Rounding.Nearest)>>);
                extraPlayerVar[6] = true;
                Wait(5, WaitBehavior.IgnoreCondition);
                extraPlayerVar[6] = false;
                break;
            }
            else
            {
                SmallMessage(EventPlayer(), <"<0> Press: <1> To connect power", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact)>);
                extraPlayerVar[6] = true;
                Wait(5, WaitBehavior.IgnoreCondition);
                extraPlayerVar[6] = false;
                break;
            }
        }
    }
}

