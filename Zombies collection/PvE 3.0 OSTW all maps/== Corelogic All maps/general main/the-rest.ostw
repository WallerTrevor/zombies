¨â’©â’ªâ’«â’¬â’­â’®â’¯â’°â’±â’²â’³â’´â’µâ’¶â’·â’¸â’¹â’ºâ’»â’¼â’½â’¾â’¿â“€â“â“‚â“ƒâ“„â“…â“†â“‡â“ˆâ“‰â“Šâ“‹â“Œâ“â“Žâ“â“â“‘â“’â““â“”â“•â“–â“—â“˜â“™â“šâ“›â“œâ“â“žâ“Ÿâ“ â“¡â“¢â“£<0>", <"â“¤â“¥â“¦â“§â“¨â“©â”€â”â”‚â”ƒâ”„â”…â”†â”‡â”ˆâ”‰â”Šâ”‹â”Œâ”â”Žâ”â”â”‘â”’â”“â””â”•â”–â”—â”˜â”™â”šâ”›â”œâ”â”žâ”Ÿâ” â”¡â”¢â”£â”¤â”¥â”¦â”§â”¨â”©â”ªâ”«â”¬â”­â”®â”¯â”°â”±â”²â”³â”´â”µâ”¶â”·â”¸â”¹â”ºâ”»â”¼â”½â”¾â”¿â•€â•â•‚â•ƒâ•„â•…â•†â•‡â•ˆâ•‰â•Šâ•‹â•Œâ•â•Žâ•â•â•‘â•’â•“â•”â••â•–â•—â•˜â•™â•šâ•›â•œâ•â•žâ•Ÿâ• â•¡â•¢â•£â•¤â•¥â•¦â•§â•¨â•©â•ªâ•«â•¬â•­â•®â•¯â•°â•±â•²â•³â•´â•µâ•¶<0>", <"â•·â•¸â•¹â•ºâ•»â•¼â•½â•¾â•¿â–€â–â–‚â–ƒâ–„â–…â–†â–‡â–ˆâ–‰â–Šâ–‹â–Œâ–â–Žâ–â–â–‘â–’â–“â–”â–•â––â–—â–˜â–™â–šâ–›â–œâ–â–žâ–Ÿâ– â–¡â–¢â–£â–¤â–¥â–¦â–§â–¨â–©â–ªâ–«â–¬â–­â–®â–¯â–°â–±â–²â–³â–´â–µâ–¶â–·â–¸â–¹â–ºâ–»â–¼â–½â–¾â–¿â—€â—â—‚â—ƒâ—„â—…â—†â—‡â—ˆâ—‰â—Šâ—‹â—Œâ—â—Žâ—â—â—‘â—’â—“â—”â—•â—–â——â—˜â—™â—šâ—›â—œâ—â—žâ—Ÿâ— â—¡â—¢â—£â—¤â—¥â—¦â—§â—¨â—©â—ªâ—«â—¬â—­â—®â—¯â—°â—±â—²â—³<0>", <"â—´â—µâ—¶â—·â—¸â—¹â—ºâ—»â—¼â—½â—¾â—¿â˜€â˜â˜‚â˜ƒâ˜„â˜…â˜†â˜‡â˜ˆâ˜‰â˜Šâ˜‹â˜Œâ˜â˜Žâ˜â˜â˜‘â˜’â˜“â˜”â˜•â˜–â˜—â˜˜â˜™â˜šâ˜›â˜œâ˜â˜žâ˜Ÿâ˜ â˜¡â˜¢â˜£â˜¤â˜¥â˜¦â˜§â˜¨â˜©â˜ªâ˜«â˜¬â˜­â˜®â˜¯â˜°â˜±â˜²â˜³â˜´â˜µâ˜¶â˜·â˜¸â˜¹â˜ºâ˜»â˜¼â˜½â˜¾â˜¿â™€â™â™‚â™ƒâ™„â™…â™†â™‡â™ˆâ™‰â™Šâ™‹â™Œâ™â™Žâ™â™â™‘â™’â™“â™”â™•â™–â™—â™˜â™™â™šâ™›â™œâ™â™žâ™Ÿâ™ â™¡â™¢â™£â™¤â™¥â™¦â™§â™¨â™©â™ªâ™«â™¬â™­â™®â™¯â™°<0>", <"â™±â™²â™³â™´â™µâ™¶â™·â™¸â™¹â™ºâ™»â™¼â™½â™¾â™¿âš€âšâš‚âšƒâš„âš…âš†âš‡âšˆâš‰âšŠâš‹âšŒâšâšŽâšâšâš‘âš’âš“âš”âš•âš–âš—âš˜âš™âššâš›âšœâšâšžâšŸâš âš¡âš¢âš£âš¤âš¥âš¦âš§âš¨âš©âšªâš«âš¬âš­âš®âš¯âš°âš±âš²âš³âš´âšµâš¶âš·âš¸âš¹âšºâš»âš¼âš½âš¾âš¿â›€â›â›‚â›ƒâ›„â›…â›†â›‡â›ˆâ›‰â›Šâ›‹â›Œâ›â›Žâ›â›â›‘â›’â›“â›”â›•â›–â›—â›˜â›™â›šâ››â›œâ›â›žâ›Ÿâ› â›¡â›¢â›£â›¤â›¥â›¦â›§â›¨â›©â›ªâ›«â›¬â›­<0>", "â›®â›¯â›°â›±â›²â›³â›´â›µâ›¶â›·â›¸â›¹â›ºâ›»â›¼â›½â›¾â›¿âœ€âœâœ‚âœƒâœ„âœ…âœ†âœ‡âœˆâœ‰âœŠâœ‹âœŒâœâœŽâœâœâœ‘âœ’âœ“âœ”âœ•âœ–âœ—âœ˜âœ™âœšâœ›âœœâœâœžâœŸâœ âœ¡âœ¢âœ£âœ¤âœ¥âœ¦âœ§âœ¨âœ©âœªâœ«âœ¬âœ­âœ®âœ¯âœ°âœ±âœ²âœ³âœ´âœµâœ¶âœ·âœ¸âœ¹âœºâœ»âœ¼âœ½âœ¾âœ¿â€ââ‚âƒâ„â…â†â‡âˆâ‰âŠâ‹âŒâ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
    pfLoadedMap_nodes = [];
    pfLoadedMap_neighbors = [];
    # Decompress nodes
    for (pfI1 = 0; CountOf(FirstOf(pfDecompress)); 1)
    {
        for (pfI2 = 0; StringLength(FirstOf(pfDecompress)[pfI1]); 3)
        {
            ModifyVariable(pfLoadedMap_nodes, Operation.AppendToArray, Vector((IndexOfStringChar(pfcompressionTable, CharInString(FirstOf(pfDecompress)[pfI1], pfI2)) * 2 - 4096) / 10, (IndexOfStringChar(pfcompressionTable, CharInString(FirstOf(pfDecompress)[pfI1], pfI2 + 1)) * 2 - 4096) / 10, (IndexOfStringChar(pfcompressionTable, CharInString(FirstOf(pfDecompress)[pfI1], pfI2 + 2)) * 2 - 4096) / 10));
            MinWait();
        }
    }
    # Decompress neighbors
    pfdecompressionState = 0;
    pfcurrentNeighbors = [];
    for (pfI1 = 0; CountOf(pfDecompress[1]); 1)
    {
        for (pfI2 = 0; StringLength(pfDecompress[1][pfI1]); 1)
        {
            pfnext = IndexOfStringChar(pfcompressionTable, CharInString(pfDecompress[1][pfI1], pfI2));
            # Next is the neighbor.
            if (pfdecompressionState == 0)
            {
                # Current node is terminated.
                if (!pfnext)
                {
                    ModifyVariable(pfLoadedMap_neighbors, Operation.AppendToArray, [pfcurrentNeighbors]);
                    # Reset current neighbors array
                    pfcurrentNeighbors = [];
                }
                else
                {
                    pfdecompressionState = 1;
                    ModifyVariable(pfcurrentNeighbors, Operation.AppendToArray, [[pfnext - 1, []]]);
                }
            }
            else if (pfdecompressionState == 1)
            {
                # Current neighbor is terminated
                if (!pfnext)
                {
                    pfdecompressionState = 0;
                }
                else
                {
                    pfcurrentNeighbors[CountOf(pfcurrentNeighbors) - 1] = [FirstOf(LastOf(pfcurrentNeighbors)), Append(LastOf(pfcurrentNeighbors)[1], pfnext - 1)];
                }
            }
            if (!(pfI2 % 20))
            {
                MinWait();
            }
        }
        MinWait();
    }
    pfcompressionTable = null;
    # Unlock pathfinder
    pfIterationsThisTick = 0;
}


rule: "56  points loss for high roller"
Event.OnDeath
Team.Team1
{
    bankPoints += points * 0.2;
    points -= points * 0.3;
    points = RoundToInteger(points, Rounding.Up);
}

rule: "global bank interest gain every round"
if (numberOfZombies <= 0)
if (bankPoints > 0)
if (start == 1)
{
    Wait(0.16, WaitBehavior.IgnoreCondition);
    for (i = 0; CountOf(bankRates); 1)
    {
        if (bankTier == i)
        {
            bankPoints += bankPoints * bankRates[i];
        }
        break;
    }
}

rule: "global bank tier upgrade"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceBetween(EventPlayer(), Vector(273.459, 44.205, 176.795)) < 1)
if (bankTier < 3)
{
    for (i = 0; CountOf(FirstOf(twoDnumbersArray)); 1)
    {
        if (bankTier == i)
        {
            if (bankPoints >= FirstOf(twoDnumbersArray)[i])
            {
                bankPoints -= FirstOf(twoDnumbersArray)[i];
                bankTier = i + 1;
                SmallMessage(AllPlayers(Team.All), <"You have permanently upgraded your bank to tier <0>", i + 1>);
                PlayEffect(AllPlayers(Team.All), PlayEffect.BuffExplosionSound, Color.White, EventPlayer(), 70);
            }
            else
            {
                SmallMessage(AllPlayers(Team.All), <"You need <0> points in the bank to upgrade!", FirstOf(twoDnumbersArray)[i]>);
            }
            break;
        }
    }
}

rule: "global bank withdraw button"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceBetween(EventPlayer(), Vector(277.123, 44.205, 177.262)) < 1)
{
    if (ServerLoad() < 245)
    {
        if (bankPoints >= 250)
        {
            bankPoints -= 250;
            points += 250;
            Wait(ServerLoadAverage() / 255 * 0.18 - 90.032, WaitBehavior.IgnoreCondition);
            if (withdrawNotif == 0)
            {
                withdrawNotif = 1;
            }
            LoopIfConditionIsTrue();
        }
        else
        {
            SmallMessage(EventPlayer(), "The bank is out of funds!");
        }
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> Bank closed! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
    }
}

rule: "global bank deposit button"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceBetween(EventPlayer(), Vector(275.451, 44.205, 175.244)) < 1)
{
    if (ServerLoad() < 245)
    {
        if (points >= 200)
        {
            bankPoints += 200;
            points -= 200;
            if (depNotif == 0)
            {
                depNotif = 1;
            }
            Wait(ServerLoadAverage() / 255 * 0.18 - 90.032, WaitBehavior.IgnoreCondition);
            LoopIfConditionIsTrue();
        }
        else
        {
            SmallMessage(EventPlayer(), "You don't have enough points to deposit!");
        }
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> Bank closed! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
    }
}

rule: "property damage easter egg"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceBetween(EventPlayer(), Vector(269.882, 44.205, 179.101)) < 1)
{
    SmallMessage(EventPlayer(), <"<0> You have caused $<1> damage to my army!", HeroIconString(Hero.Ramattra), ramPoints>);
}

rule: "credit card system"
Event.OngoingPlayer
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (DistanceBetween(EventPlayer(), Vector(299.653, -14.545, -222.024)) < 1)
if (creditTier < 3)
{
    if (ServerLoad() < 245)
    {
        for (i = 0; CountOf(creditCosts); 1)
        {
            if (points >= creditCosts[i])
            {
                points -= creditCosts[i];
                ChaseVariableAtRate(points2, EvaluateOnce(points), 1000, RateChaseReevaluation.DestinationAndRate);
                creditTier = i + 1;
                creditcardlimit = creditLimits[i];
                cashback = cashbackRates[i];
                SmallMessage(EventPlayer(), <"Your credit card is now tier <0>", i + 1>);
                Wait(4, WaitBehavior.IgnoreCondition);
                SmallMessage(EventPlayer(), "Hold spacebar to see credit card details");
            }
            else
            {
                if (i == 0)
                {
                    SmallMessage(EventPlayer(), <"You need <0> points buy a credit card!", creditCosts[i]>);
                }
                else
                {
                    SmallMessage(EventPlayer(), <"You need <0> points to upgrade!", creditCosts[i]>);
                }
                break;
            }
        }
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> Credit card office closed! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
    }
}

rule: "credit card interest"
Event.OngoingPlayer
if (points < 0)
if (numberOfZombies < 1)
if (IsAlive(EventPlayer()) == true)
if (creditTier > 0)
{
    for (i = 1; CountOf(ccRates); 1)
    {
        if (creditTier == i)
        {
            ccCurrentRate = ccRates[i];
            ccInterest = points * ccCurrentRate;
            points += ccInterest;
            ChaseVariableAtRate(points2, EvaluateOnce(points), 1000, RateChaseReevaluation.DestinationAndRate);
            SmallMessage(EventPlayer(), <"You have incurred <0> interest on your credit card.", ccInterest>);
        }
        break;
    }
}

