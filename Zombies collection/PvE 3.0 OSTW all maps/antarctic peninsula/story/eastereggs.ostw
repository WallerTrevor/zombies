rule: "glitch in the system" #This changes the round number to show a easter egg. it changes it to be binary for the round number.
if (roundnumber < 10)
if (aprilrng == 25)
{
    for (forindex = 0; forindex < 4; 1)
    {
        romanNcounter += 12;
        Wait(0.4, WaitBehavior.IgnoreCondition);
        romanNcounter -= 12;
        Wait(0.4, WaitBehavior.IgnoreCondition);
    }
    LoopIfConditionIsTrue();
}

rule: "507 april first quotes"
Event.OngoingPlayer
Team.Team1
if (IsUsingUltimate(EventPlayer()) == true)
if (aprilrng == 100)
{
    for (EventPlayer().aprilQuoteIndex = 0; CountOf(heroAlphabetical); 1)
    {
        if (HeroOf(EventPlayer()) == heroAlphabetical[EventPlayer().aprilQuoteIndex] && CountOf(aprilQuoteLines[EventPlayer().aprilQuoteIndex]) > 0)
        {
            CreateInWorldText(AllPlayers(Team.All), RandomValueInArray(aprilQuoteLines[EventPlayer().aprilQuoteIndex]), EventPlayer(), 1, Clipping.ClipAgainstSurfaces, InworldTextRev.VisibleToPositionAndString, Color.White, Spectators.DefaultVisibility);
            Wait(5, WaitBehavior.IgnoreCondition);
            DestroyInWorldText(LastTextID());
            break;
        }
    }
}
