rule: "26 Revive Player system"
Event.OngoingPlayer
Team.Team1
if (IsAlive(EventPlayer()) == true)
if (IsDummyBot(EventPlayer()) == false)

if (IsTrueForAny(Died, DistanceBetween(ArrayElement(), EventPlayer()) < 4) == true)
{

    reviveTarget = PlayersInSlot(IndexOfArrayValue(Died, FirstOf(SortedArray(Died, DistanceBetween(ArrayElement(), EventPlayer())))), Team.Team1);

    ChaseVariableOverTime(reviveTarget.sea, 4, 2 + P * 2, TimeChaseReevaluation.DestinationAndDuration);
    Wait(2 + P * 2, WaitBehavior.AbortWhenFalse);

    Resurrect(reviveTarget);
    Teleport(reviveTarget, EventPlayer());
    reviveTarget.doorSkipCheck = true;
    P += 1;
    Died[SlotOf(reviveTarget)] = Vector(500, 0, 500);
    points += 100 * H;
    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
    SkipIf(H != 1, 1);
    SkipIf(H == 1, 1);
    AllPlayers(Team.Team1).InfoCooldown = false;
    R += 100 * H;
    SetStatus(reviveTarget, null, Status.PhasedOut, 5);
    SetMaxHealth(reviveTarget, 100);

    StopChasingVariable(reviveTarget.sea);
    reviveTarget.sea = 0;
    reviveTarget = null;
}

