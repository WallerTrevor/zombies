if (IsOnGround(EventPlayer()) == true)
if (extraPlayerVar[2] < -15)
{
    Damage(EventPlayer(), null, AbsoluteValue(extraPlayerVar[2]) * MaxHealth(EventPlayer()) / 200 * AbsoluteValue(extraPlayerVar[2]) / 8 * 3);
}

