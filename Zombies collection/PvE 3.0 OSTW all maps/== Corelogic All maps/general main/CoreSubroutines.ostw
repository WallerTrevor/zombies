
void totalrandomspawn() "each bot will be random"
{
	wavevoicecall();
	setbotamount();
	for (forindex = 0; botamount; 1)
	{
		current_hero = hero[RandomInteger(0, 37)];
		CreateDummyBot(current_hero, Team.Team2, forindex, FirstOf(SpawnPoints(Team.Team2)), Vector(0, 0, 0));
		omnicspawn[forindex] = SlotOf(PlayersInSlot(forindex, Team.Team2));
		subindex = forindex;
		ActiveEnemyIndex();
		Wait(0.75, WaitBehavior.AbortWhenFalse);
	}
}

void ResetPurchaseMessageTimer() "reset purchase message timer"
{
	heroBuyMessTimer = true;
	Wait(5, WaitBehavior.IgnoreCondition);
	heroBuyMessTimer = false;
}