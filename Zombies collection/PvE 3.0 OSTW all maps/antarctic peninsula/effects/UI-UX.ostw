import "../Main/index.ostw";

rule: "202 Purchase hero message"
Event.OngoingPlayer
Team.Team1
if (heroBuyMessTimer == false)
if (IsTrueForAny(buyheros, DistanceToEventPlayer(ArrayElement()) < 2) == true)
{

    Wait(0.1, WaitBehavior.IgnoreCondition);
    for (i = 0; CountOf(buyheros); 1)
    {

        if (DistanceToEventPlayer(buyheros[i]) < 2 && hero[i] != null)
        {

            messageSpot = i;
            SmallMessage(EventPlayer(), <"<0> Press: <1> for Hero = <2>", HeroIconString(hero[messageSpot]), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2>", RoundToInteger(herobuycosts[messageSpot] * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), <"<0> Points --- Ammo cost <1>", RoundToInteger(herobuycosts[messageSpot] / 3 * costmultiplier, Rounding.Nearest), RoundToInteger(herobuycosts[messageSpot] / 2 * costmultiplier, Rounding.Nearest)>>>);
            ResetPurchaseMessageTimer(heroBuyMessTimer);
            break;
        }
    }
}

rule: "Purchase Mystery Box message"
Event.OngoingPlayer
Team.Team1
if (mysteryBuyMessTimer == false)

if (NearMysteryBox())
{
    Wait(0.1, WaitBehavior.IgnoreCondition);
    SmallMessage(EventPlayer(), <"<0> Press: <1> for Mystery Hero = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2> Points", RoundToInteger(MysteryBoxCost() * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), RoundToInteger(316.667 * costmultiplier, Rounding.Nearest)>>);
    ResetPurchaseMessageTimer(mysteryBuyMessTimer);
}

rule: "Purchase perk machine message"
Event.OngoingPlayer
Team.Team1
if (perkBuyMessTimer == false)

if (outofpsawn == 1)

if (IsTrueForAny(ArraySlice(buyperks, 0, Buyable.Power + 1), DistanceToEventPlayer(ArrayElement()) < 2) == true)
{

    Wait(0.1, WaitBehavior.IgnoreCondition);

    for (i = Buyable.Juggernaut; Buyable.Power + 1; 1)
    {
        if (DistanceToEventPlayer(buyperks[i]) < 2)
        {
            if (poweron == 0 && i == Buyable.Power)
            {

                SmallMessage(EventPlayer(), <"<0> Dont you dare touch that!", HeroIconString(Hero.Ramattra)>);
            }
            else if (poweron == 0)
            {

                SmallMessage(EventPlayer(), <"<0> What a Mysterious Machine for my Trials!", HeroIconString(Hero.Ramattra)>);
            }
            else if (i != Buyable.Power)
            {

                messageSpot = i;
                SmallMessage(EventPlayer(), <"<0> Press: <1> for Perk = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> == <1> Points", perkNames[messageSpot], RoundToInteger(perkcosts[messageSpot] * costmultiplier, Rounding.Nearest)>>);
            }
            ResetPurchaseMessageTimer(perkBuyMessTimer);
            break;
        }
    }
}

rule: "Purchase monkey bomb message"
Event.OngoingPlayer
Team.Team1
if (perkBuyMessTimer == false)
if (outofpsawn == 1)
if (DistanceToEventPlayer(buyperks[Buyable.OmnicBomb]) < 2)
{
    SmallMessage(EventPlayer(), poweron == 0 ? <"<0> What a Mysterious Machine for my Trials!", HeroIconString(Hero.Ramattra)> : (monkeyBombOwned == true ? <"<0> Use the Ultimate Status voice line to throw a monkey bomb", HeroIconString(Hero.Ramattra)> : <"<0> Press: <1> for Monkey bomb == <2> Points", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), RoundToInteger(2500 * costmultiplier, Rounding.Nearest)>));
    ResetPurchaseMessageTimer(perkBuyMessTimer);
}

rule: "perk HUD and Pack-a-Punch tier"
Event.OngoingPlayer
Team.Team1
if (start == 1)
if (IsDummyBot(EventPlayer()) == false)
{
    for (EventPlayer().perkHudIndex = Perk.Juggernaut; Perk.DoubleMag + 1; 1)
    {
        CreateHudText(EventPlayer().perk[EvaluateOnce(EventPlayer().perkHudIndex)] > 0 ? EventPlayer() : null, null, null, EventPlayer().perkinfo == 2 ? <"<0> <1>: <2>", perkIcons[EvaluateOnce(EventPlayer().perkHudIndex)], perkNames[EvaluateOnce(EventPlayer().perkHudIndex)], perkInfo[EvaluateOnce(EventPlayer().perkHudIndex)]> : perkIcons[EvaluateOnce(EventPlayer().perkHudIndex)], Location.Left, 3, null, null, [Color.White, Color.Blue, Color.Orange, Color.Red][EventPlayer().perk[EvaluateOnce(EventPlayer().perkHudIndex)]], HudTextRev.VisibleToStringAndColor, Spectators.DefaultVisibility);
    }
    CreateHudText(EventPlayer().papAppliedTier > 0 ? EventPlayer() : null, null, null, EventPlayer().perkinfo == 2 ? <"\n\n\n<0> <1>: <2>", perkNames[Perk.packapunch], EventPlayer().papAppliedTier, perkInfo[Perk.packapunch]> : <"\n\n\n<0>", EventPlayer().papAppliedTier>, Location.Left, 9, null, null, [Color.White, Color.Blue, Color.Orange, Color.Red][EventPlayer().papAppliedTier], HudTextRev.VisibleToStringAndColor, Spectators.DefaultVisibility);
    CreateEffect(EventPlayer().papAppliedTier == 1 ? AllPlayers(Team.Team1) : null, Effect.BaptisteImmortalityFieldProtectedEffect, Color.White, EventPlayer(), 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(EventPlayer().papAppliedTier == 2 ? AllPlayers(Team.Team1) : null, Effect.AnaNanoBoostedEffect, Color.Team2, EventPlayer(), 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(EventPlayer().papAppliedTier == 3 ? AllPlayers(Team.Team1) : null, Effect.EchoCloningEffect, Color.White, EventPlayer(), 1, EffectRev.VisibleToPositionAndRadius);
}

