import "../Main/index.ostw";

rule: "202 Purchase hero message"
Event.OngoingPlayer
Team.Team1
if (heroBuyMessTimer == false)
if (IsTrueForAny(buyheros, DistanceBetween(ArrayElement(), EventPlayer()) < 2) == true)
{
    for (i = 0; CountOf(buyheros); 1)
    {
        if (DistanceBetween(EventPlayer(), buyheros[i]) < 2)
        {
            Wait(0.1, WaitBehavior.IgnoreCondition);
            SmallMessage(EventPlayer(), <"<0> Press: <1> for Hero = <2>", HeroIconString(hero[i]), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2>", RoundToInteger(herobuycosts[i] * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), <"<0> Points --- Ammo cost <1>", RoundToInteger(herobuycosts[i] / 3 * costmultiplier, Rounding.Nearest), RoundToInteger(herobuycosts[i] / 2 * costmultiplier, Rounding.Nearest)>>>);
            heroBuyMessTimer = true;
            Wait(5, WaitBehavior.IgnoreCondition);
            heroBuyMessTimer = false;
            break;
        }
    }
}

rule: "Purchase Mystery Box message"
Event.OngoingPlayer
Team.Team1
if (mysteryBuyMessTimer == false)
if (DistanceBetween(EventPlayer(), rngbox) <= 2)
if (rngbox != null)
{
    Wait(0.1, WaitBehavior.IgnoreCondition);
    SmallMessage(EventPlayer(), <"<0> Press: <1> for Mystery Hero = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> Points -- Hold: <1> for follower = <2> Points", RoundToInteger(950 * costmultiplier, Rounding.Nearest), InputBindingString(Button.Reload), RoundToInteger(316.667 * costmultiplier, Rounding.Nearest)>>);
    mysteryBuyMessTimer = true;
    Wait(5, WaitBehavior.IgnoreCondition);
    mysteryBuyMessTimer = false;
}

rule: "Purchase perk machine message"
Event.OngoingPlayer
Team.Team1
if (perkBuyMessTimer == false)
if (IsTrueForAny(buyperks, [DistanceBetween(ArrayElement(), EventPlayer()) < 2]) == true)
if (powerconnected == true)
{
    for (i = 0; CountOf(buyperks); 1)
    {
        if (DistanceBetween(EventPlayer(), buyperks[i]) < 2)
        {
            if (i != 6)
            {
                Wait(0.1, WaitBehavior.IgnoreCondition);
                SmallMessage(EventPlayer(), <"<0> Press: <1> for Perk = <2>", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact), <"<0> == <1> Points", perkNames[i], RoundToInteger(perkcosts[i] * costmultiplier, Rounding.Nearest)>>);
                perkBuyMessTimer = true;
                Wait(5, WaitBehavior.IgnoreCondition);
                perkBuyMessTimer = false;
                break;
            }
            else
            {
                SmallMessage(EventPlayer(), <"<0> Press: <1> To connect power", HeroIconString(Hero.Ramattra), InputBindingString(Button.Interact)>);
                perkBuyMessTimer = true;
                Wait(5, WaitBehavior.IgnoreCondition);
                perkBuyMessTimer = false;
                break;
            }
        }
    }
}

