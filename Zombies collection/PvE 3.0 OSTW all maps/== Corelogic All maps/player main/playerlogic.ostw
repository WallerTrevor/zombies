rule: "26 Revive Player system"
Event.OngoingPlayer
Team.Team1
# might rebuild downed system to have players be unkillable
if (DistanceBetween(EventPlayer(), Died[i]) <= 4)
# and only stay alive for 25 seconds then dissapear
if (EventPlayer() != PlayersInSlot(i, Team.Team1))
# then lose their hero and will need to rebuild spectator cam
if (IsAlive(EventPlayer()) == true)
if (IsDummyBot(EventPlayer()) == false)
if (IsTrueForAny(Died, DistanceBetween(ArrayElement(), EventPlayer()) < 4) == true)
{
    for (i = 0; CountOf(Died); 1)
    {
        if (DistanceBetween(EventPlayer(), Died[i]) <= 4)
        {
            sea = PlayersInSlot(i, Team.Team1);
            ChaseVariableOverTime(PlayersInSlot(i, Team.Team1).sea, 4, 2 + P * 2, TimeChaseReevaluation.DestinationAndDuration);
            Wait(2 + P * 2, WaitBehavior.AbortWhenFalse);
            Teleport(PlayersInSlot(i, Team.Team1), EventPlayer());
            Resurrect(PlayersInSlot(i, Team.Team1));
            P += 1;
            # wait(0.25)
            Died[i] = Vector(500, 0, 500);
            points += 100 * H;
            ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 1000, RateChaseReevaluation.DestinationAndRate);
            SkipIf(H != 1, 1);
            SkipIf(H == 1, 1);
            AllPlayers(Team.Team1).InfoCooldown = false;
            R += 100 * H;
            SetStatus(PlayersInSlot(i, Team.Team1), null, Status.PhasedOut, 5);
            SetMaxHealth(PlayersInSlot(i, Team.Team1), 100);
            break;
        }
    }
}

