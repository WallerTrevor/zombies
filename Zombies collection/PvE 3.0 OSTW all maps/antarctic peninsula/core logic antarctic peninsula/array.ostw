import "../Main/index.ostw";

rule: "teleporter numbers"
{
    doorzone1count1 = 0;
    doorzone1count2 = 37;
    doorzone2count1 = 38;
    doorzone2count2 = 71;
    doorzone3count1 = 72;
    doorzone3count2 = 110;
}

rule: "load map data"
{

    LoadCoreData();
    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.bossbuypositions);
    decompressVSub();
    bossbuypositions = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.mysterylocations);
    decompressVSub();
    mysterylocations = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.buyheros);
    decompressVSub();
    buyheros = decodeOut;
    buyherosHome = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.buyperks);
    decompressVSub();
    buyperks = decodeOut;
    buyperksHome = decodeOut;

    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.settingsCamera);
    decompressVSub();
    settingsCamera = decodeOut;

    decodeIn = Unpack(import("Local-compressed.json").twoDvectorsArray.teleporterpositions);
    decompressVSub();
    teleporterpositions = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").twoDnumbersArray2.teleradiusef);
    decompressNSub();
    teleradiusef = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").twoDnumbersArray2.perkcosts);
    decompressNSub();
    perkcosts = decodeOut;

    decodeIn = Unpack(import("Local-compressed.json").waveBoss.actions);
    decompressNSub();
    smActions = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").waveBoss.healthTriggers);
    decompressNSub();
    smHealthTriggers = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").waveBoss.spawnCodes);
    decompressNSub();
    smSpawnCodes = decodeOut;
    decodeIn = Unpack(import("Local-compressed.json").waveBoss.stepTimes);
    decompressNSub();
    smStepTimes = decodeOut;

    decodeIn = import("Local-compressed.json").texts.perkNames.data;
    decompressTextSub();
    perkNames = decodeOut;
    decodeIn = import("Local-compressed.json").texts.perkmessages.data;
    decompressTextSub();
    perkmessages = decodeOut;

    decodeIn = import("Local-compressed.json").texts.perkInfo.data;
    decompressTextSub();
    perkInfo = decodeOut;

    perkIcons = [AbilityIconString(Hero.Cassidy, Button.Ability1), IconString(Icon.Heart), IconString(Icon.Fire), IconString(Icon.Diamond), IconString(Icon.Eye), IconString(Icon.Halo)];

    decodeIn = Unpack(import("Local-compressed.json").bankButtons);
    decompressVSub();
    bankButtons = decodeOut;

    pfLoadedZone = -1;
    mapDataLoaded = true;
}
