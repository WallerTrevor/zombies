        <"Interest: <0>% per round (<1> points)   <2>", RoundToInteger(creditCardTiers[LocalPlayer().creditTier].InterestRate * 100, Rounding.Nearest), Max(0, RoundToInteger((0 - LocalPlayer().points) * creditCardTiers[LocalPlayer().creditTier].InterestRate, Rounding.Up)), LocalPlayer().creditTier < creditCardTiers.Length - 1 ? <"Next tier: <0> points", creditCardTiers[LocalPlayer().creditTier + 1].Cost> : "Max tier">,
        Location.Left, 3, [Color.White, Color.Green, Color.SkyBlue, Color.Yellow][LocalPlayer().creditTier], Color.White, Color.White, HudTextRev.VisibleToStringAndColor, Spectators.DefaultVisibility);
