    SetDamageDealt(EventPlayer(), damagevariable);
    CreateEffect(AllPlayers(Team.Team1), Effect.BaptisteImmortalityFieldProtectedEffect, Color.White, EventPlayer(), 1, EffectRev.VisibleToPositionRadiusAndColor);
    Packapunch = papTier;
}

void zone1() "zone 1 subroutine"
{
    ForceSpawnRoom(Team.All, 1);
    extraVar[12] = 0;
    doorZoneStart = extraVar[33];
    doorZoneEnd = extraVar[34];
}

void zone2() "zone 2 subroutine"
{
    ForceSpawnRoom(Team.All, 0);
    extraVar[12] = 1;
    doorZoneStart = extraVar[35];
    doorZoneEnd = extraVar[36];
}

void zone3() "zone 3 subroutine"
{
    ForceSpawnRoom(Team.All, 2);
    extraVar[12] = 2;
    doorZoneStart = extraVar[37];
    doorZoneEnd = extraVar[38];
}

void makedoors() "make the door effects"
{
    if (extraVar[12] == 1 || extraVar[12] == 2)
    {
        for (doorindexsequencer = 0; doorZoneStart * 2; 1)
        {
            doors[doorindexsequencer] = null;
        }
    }
    Wait(3, WaitBehavior.IgnoreCondition);
    for (dooreffectsequencer = doorZoneStart; doorZoneEnd; 1)
    {
        # test this
        if (Wall_ID[dooreffectsequencer] == 1)
        {
            CreateBeamEffect(AllPlayers(Team.Team1), BeamType.JunkratTrapChainBeam, Beameffectdoors[EvaluateOnce(dooreffectsequencer * 4)], Beameffectdoors[EvaluateOnce(dooreffectsequencer * 4 + 1)], Color.Red, EffectRev.VisibleToPositionAndRadius);
            # append to allow the game to delete for later
            doors[dooreffectsequencer * 2] = LastCreatedEntity();
            CreateBeamEffect(AllPlayers(Team.Team1), BeamType.JunkratTrapChainBeam, Beameffectdoors[EvaluateOnce(dooreffectsequencer * 4 + 2)], Beameffectdoors[EvaluateOnce(dooreffectsequencer * 4 + 3)], Color.Red, EffectRev.VisibleToPositionAndRadius);
            # append to allow the game to delete for later
            doors[dooreffectsequencer * 2 + 1] = LastCreatedEntity();
            if (!(dooreffectsequencer % 3))
            {
                MinWait();
            }
        }
    }
}

