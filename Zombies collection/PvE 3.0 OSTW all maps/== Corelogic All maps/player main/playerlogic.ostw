rule: "toggle camera toggle"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
{
    if (cameratoggle == 2)
    {
        Wait(1, WaitBehavior.AbortWhenFalse);
        cameratoggle = false;
        StopCamera(EventPlayer());
    }
    else if (cameratoggle == false)
    {
        Wait(1, WaitBehavior.AbortWhenFalse);
        cameratoggle = 1;
    }
    else if (cameratoggle == 1)
    {
        Wait(1, WaitBehavior.AbortWhenFalse);
        cameratoggle = 2;
    }
}

