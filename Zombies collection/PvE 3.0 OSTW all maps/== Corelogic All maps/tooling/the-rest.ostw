rule: "stop jetpack cat from flying too long"
Event.OngoingPlayer
Player.JetpackCat
if (AltitudeOf(EventPlayer()) >= 1.5)
if (AltitudeOf(EventPlayer()) < 100)
{
    Wait(3, WaitBehavior.AbortWhenFalse);
    StartAccelerating(EventPlayer(), Down(), 100, 20, Relative.ToWorld, AccelerateRev.DirectionRateAndMaxSpeed);
    WaitUntil(AltitudeOf(EventPlayer()) <= 1.5, 5);
    # to prevent them from flying away again too soon
    DisallowButton(EventPlayer(), Button.Jump);
    StopAccelerating(EventPlayer());
    Wait(3, WaitBehavior.IgnoreCondition);
    AllowButton(EventPlayer(), Button.Jump);
}

