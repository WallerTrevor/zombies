rule: "432 OMNIC WAVE BOSS zenyatta discord if Near"
Event.OngoingPlayer
Team.Team2
Player.Zenyatta
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 10)
{
