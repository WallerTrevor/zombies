if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team2), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 6)
if (IsDummyBot(EventPlayer()) == true)
{
    # needs to be a variable
    Skip(1);
    followerattack1();
    Skip(1);
    followerattack2();
    Skip(1);
    PressButton(EventPlayer(), Button.Ability2);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
    Skip(1);
    followerattack2();
    Skip(1);
    StartHoldingButton(EventPlayer(), Button.SecondaryFire);
    Wait(1, WaitBehavior.IgnoreCondition);
    StopHoldingButton(EventPlayer(), Button.SecondaryFire);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
    Skip(1);
    StartHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(1, WaitBehavior.IgnoreCondition);
    PressButton(EventPlayer(), Button.SecondaryFire);
    StopHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
    Skip(1);
    PressButton(EventPlayer(), Button.Ability1);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

void followerattack1() "391 FOLLOWERS attack subroutine 1"
{
    StartHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(1, WaitBehavior.IgnoreCondition);
    StopHoldingButton(EventPlayer(), Button.PrimaryFire);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

void followerattack2() "392 FOLLOWERS attack subroutine 2"
{
    PressButton(EventPlayer(), Button.PrimaryFire);
    Wait(6, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "202 Purchase Follower action"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
# is heroradius variable needed?
if (IsTrueForAny(twoDvectorsArray[2], DistanceBetween(ArrayElement(), EventPlayer()) < 2) == true)
{
    Wait(1, WaitBehavior.AbortWhenFalse);
    # Loop through all heroes
    for (i = 0; CountOf(etcArray[5]); 1)
    {
        if (DistanceBetween(EventPlayer(), twoDvectorsArray[2][i]) < 2)
        {
            if (points >= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier - creditcardlimit, Rounding.Nearest))
            {
                followerbuy = etcArray[5][i];
                MinWait();
                Subfollowerbuy();
                points -= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier, Rounding.Nearest);
                points2 -= RoundToInteger(twoDnumbersArray[6][i] / 3 * costmultiplier, Rounding.Nearest);
            }
            else
            {
                SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(etcArray[5][i]), etcArray[7][i]>);
            }
            break;
        }
    }
}

