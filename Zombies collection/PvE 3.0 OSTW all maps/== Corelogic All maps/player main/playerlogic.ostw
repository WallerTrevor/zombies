rule: "393 POINTS Omnic kill (final hit)"
Event.OnFinalBlow
Team.Team1
{

    killKind = IsMeleeing(EventPlayer()) ? 2 : (EventWasCriticalHit() ? 1 : 0);
    killPoints = ([50, 100, 60][killKind] + heropoints * H) * roundpointmultiplier ^ (roundnumber - 1);
    points += killPoints;
    ramPoints += killPoints;
    ChaseVariableAtRate(points2, EvaluateOnce(points) * H, [1000, 1000, 250][killKind], RateChaseReevaluation.DestinationAndRate);

    if (H != 1)
    {
        R += [100, 200, 120][killKind] * H;
    }
    xp[currentheroxp] += [5, 10, 6][killKind];

    SetUltimateCharge(EventPlayer(), UltimateChargePercent(EventPlayer()) + UltChargePerKill() / 2);
}

rule: "396 POINTS Omnic kill (elimination)"
Event.OnElimination
Team.Team1
{

    killKind = IsMeleeing(EventPlayer()) ? 2 : (EventWasCriticalHit() ? 1 : 0);

    if (ArrayContains(AllDamageHeroes(), HeroOf(EventPlayer())))
    {
        heropoints = 15 * (killKind + 1);
    }
    else if (ArrayContains(AllSupportHeroes(), HeroOf(EventPlayer())))
    {
        heropoints = 5 * (killKind + 1);
    }
    else if (ArrayContains(AllTankHeroes(), HeroOf(EventPlayer())))
    {
        heropoints = 10 * (killKind + 1);
    }
    killPoints = ([40, 80, 70][killKind] + heropoints * H) * roundpointmultiplier ^ (roundnumber - 1);
    points += killPoints;
    ramPoints += killPoints;
    if (killKind == 2)
    {
        ChaseVariableAtRate(points2, EvaluateOnce(points) * H, 250, RateChaseReevaluation.DestinationAndRate);
    }

    if (H != 1)
    {
        R += [80, 160, 70][killKind] * H;
    }
    xp[currentheroxp] += [5, 10, 7][killKind];

    SetUltimateCharge(EventPlayer(), UltimateChargePercent(EventPlayer()) + UltChargePerKill() / 2);
}

