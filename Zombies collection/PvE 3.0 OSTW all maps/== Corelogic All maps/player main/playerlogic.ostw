Number PaPTier(): ArrayContains(endingHeroes, HeroOf(EventPlayer())) ? 3 : perk[Perk.packapunch];

rule: "pack a punch ability"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == false)
if (PaPTier() != papAppliedTier)
{
    papAppliedTier = PaPTier();

    damagevariable = [100, 250, 500, 1000][papAppliedTier];
    SetDamageDealt(EventPlayer(), damagevariable);

    Packapunch = papAppliedTier;
}

Number FollowerOwnerPaPTier(): Max(0, PlayersInSlot(SlotOf(EventPlayer()) - 4, Team.Team1).papAppliedTier);

rule: "pack a punch: followers"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == true)
if (SlotOf(EventPlayer()) >= 4)
if (SlotOf(EventPlayer()) <= 7)

if (isMonkeyBomb != true)
if (damagevariable != [100, 250, 500, 1000][FollowerOwnerPaPTier()])
{
    Packapunch = FollowerOwnerPaPTier();
    damagevariable = [100, 250, 500, 1000][Packapunch];
    SetDamageDealt(EventPlayer(), damagevariable);
}

rule: "new game: first hero slot"
