Team.Team1
if (PlayersWithinRadius(Vector(-109.55, -151.893, -6.832), 2.5, Team.Team1, RadiusLOS.Off) == true)
if (start == 1)
{
    Teleport(EventPlayer(), Vector(-104.638, -150.413, -15.437));
}

rule: "403 Challenge waves"
Event.OngoingPlayer
Team.Team2
if (challengewave == 1)
if (IsAlive(EventPlayer()) == true)
{
    SetUltimateCharge(EventPlayer(), 100);
    if (numberOfZombies < 4)
    {
        challengewave = false;
    }
}

rule: "404 set challenge wave every few rounds"
if (chwaveinterval >= 4)
{
    challengewave = RandomInteger(0, 1);
    if (challengewave == 1)
    {
        chwaveinterval = false;
    }
}


rule: "235 is not assembling heroes get out of spawn"
# might need another condition to check if softrestarted
if (IsAssemblingHeroes() == false)
{
    Wait(30, WaitBehavior.IgnoreCondition);
    AllPlayers(Team.Team1).outofpsawn = 1;
}

rule: "teleporter timer"
if (teleporterwait > 0)
{
    Wait(60, WaitBehavior.IgnoreCondition);
    teleporterwait = false;
}

