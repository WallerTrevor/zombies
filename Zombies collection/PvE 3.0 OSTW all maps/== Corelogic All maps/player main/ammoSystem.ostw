rule: "104 fix reload disabled"
Event.OngoingPlayer
Team.Team1
if (HeroOf(EventPlayer()) != Hero.Ashe)
{
    AllowButton(EventPlayer(), Button.Reload);
}

rule: "113  ashe reload fix"
Event.OngoingPlayer
Team.Team1
Player.Ashe
if (IsReloading(EventPlayer()) == true)
{
    Wait(0.45, WaitBehavior.IgnoreCondition);
    SetAmmo(EventPlayer(), 0, 12);
}

rule: "Easy: magazines never run out"
Event.OngoingPlayer
Team.Team1
if (Difficulty == 1)
if (currentmagazines < FullMagazines())
{
    currentmagazines = FullMagazines();
}

rule: "115  ammo message force melee when out of ammo"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
if (currentmagazines == false)
{
    Wait(0.1, WaitBehavior.IgnoreCondition);

    SmallMessage(EventPlayer(), <"<0> <1>", HeroIconString(HeroOf(EventPlayer())), noammostrings[IndexOfArrayValue(hero, HeroOf(EventPlayer()))]>);
    BigMessage(EventPlayer(), "USE MELEE");
    Wait(5, WaitBehavior.IgnoreCondition);
    SmallMessage(EventPlayer(), "MELEE BONUS DAMAGE");
    Wait(5, WaitBehavior.IgnoreCondition);
    SmallMessage(EventPlayer(), "buy any hero for more ammo");
}

rule: "161 life weiver no ammo"
Event.OngoingPlayer
Team.Team1
Player.Lifeweaver
if (currentmagazines == false)
{

    DisallowButton(EventPlayer(), Button.PrimaryFire);
    DisallowButton(EventPlayer(), Button.SecondaryFire);
}

rule: "160 life weaver ammo"
Event.OngoingPlayer
Team.Team1
Player.Lifeweaver
if (IsButtonHeld(EventPlayer(), Button.SecondaryFire) == true)
if (IsReloading(EventPlayer()) == false)
{
    currentmagazines -= 0.025;
    Wait(0.1, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "171 no ammo force melee"
Event.OngoingPlayer
Team.Team1
if ((IsButtonHeld(EventPlayer(), Button.PrimaryFire) || IsButtonHeld(EventPlayer(), Button.SecondaryFire)) == true)
if (currentmagazines <= 0)
{
    PressButton(EventPlayer(), Button.Melee);
}

rule: "160 orisa ammo"
Event.OngoingPlayer
Team.Team1
Player.Orisa
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
{
    currentmagazines -= 0.05;
    Wait(0.2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "105 specific hero ammo"
Event.OngoingPlayer
Team.Team1
if ((IsButtonHeld(EventPlayer(), Button.Ability1) || IsButtonHeld(EventPlayer(), Button.Ability2) || IsButtonHeld(EventPlayer(), Button.SecondaryFire) || IsButtonHeld(EventPlayer(), Button.PrimaryFire)) == true)
{
    if (IsButtonHeld(EventPlayer(), Button.SecondaryFire))
    {
        switch (HeroOf(EventPlayer()))
        {
            case Hero.Moira:

                currentmagazines -= 0.05;
                Wait(0.25, WaitBehavior.IgnoreCondition);
                LoopIfConditionIsTrue();
                break;
        }
    }

    if (IsButtonHeld(EventPlayer(), Button.PrimaryFire))
    {
        switch (HeroOf(EventPlayer()))
        {
            case Hero.Doomfist:
                currentmagazines -= 0.25;
                Wait(0.25, WaitBehavior.IgnoreCondition);
                LoopIfConditionIsTrue();
                break;

            case Hero.Dva:
                if (!IsInAlternateForm(EventPlayer()))
                {
                    currentmagazines -= 0.05;
                    Wait(0.15, WaitBehavior.IgnoreCondition);
                    LoopIfConditionIsTrue();
                }
                break;

            case Hero.Hanzo:
                currentmagazines -= 0.25;
                break;

            case Hero.Sigma:
                currentmagazines -= 0.05;
                Wait(0.1, WaitBehavior.IgnoreCondition);
                currentmagazines -= 0.05;
                Wait(1.5, WaitBehavior.IgnoreCondition);
                LoopIfConditionIsTrue();
                break;
        }
    }
    else
    {
        switch (HeroOf(EventPlayer()))
        {
            case Hero.Reaper:
                if (IsUsingAbility1(EventPlayer()))
                {
                    currentmagazines -= 0.5;
                }
                break;

            case Hero.Cassidy:
                if (IsUsingAbility1(EventPlayer()))
                {
                    SkipIf(Ammo(EventPlayer(), 0) == 6, 1);
                    currentmagazines -= 0.5;
                }
                break;

            case Hero.Reinhardt:
                if (IsUsingAbility2(EventPlayer()))
                {
                    currentmagazines -= 0.25;
                }
                break;
        }
    }
}

rule: "132  rien out of ammo"
Event.OngoingPlayer
Team.Team1
Player.Reinhardt
if (IsUsingAbility2(EventPlayer()) == true)
if (currentmagazines <= 0)
{
    DisallowButton(EventPlayer(), Button.Ability2);
}

rule: "112  hanzo ammo"
Event.OngoingPlayer
Team.Team1
Player.Hanzo
if (IsFiringPrimary(EventPlayer()) == true)
{
    currentmagazines -= 0.25;
}

rule: "84 reloading uses a magazine"
Event.OngoingPlayer
Team.Team1
if (IsReloading(EventPlayer()) == true)
{
    currentmagazines -= ReloadCost();
}

rule: "89 out of ammo"
Event.OngoingPlayer

if (currentmagazines <= 0)
if (HeroOf(EventPlayer()) != Hero.Moira)
if (HeroOf(EventPlayer()) != Hero.Mercy)
if (HeroOf(EventPlayer()) != Hero.Reinhardt)
if (HeroOf(EventPlayer()) != Hero.Brigitte)
if (HeroOf(EventPlayer()) != Hero.Torbjorn)
if (HeroOf(EventPlayer()) != Hero.Mei)
if (IsDummyBot(EventPlayer()) == false)
{
    SetPrimaryFireEnabled(EventPlayer(), false);
    SetSecondaryFireEnabled(EventPlayer(), false);
    DisallowButton(EventPlayer(), Button.PrimaryFire);
    DisallowButton(EventPlayer(), Button.SecondaryFire);
}

rule: "90 initialize ammo amount"
Event.OngoingPlayer
{
    magazines[0] = 5;
    magazines[1] = 5;
    currentmagazines = FirstOf(magazines);
    currentswap = false;
    DisallowButton(EventPlayer(), Button.Crouch);
    ultcharge[0] = false;
    ultcharge[1] = false;
    MinWait();
    currentultcharge = FirstOf(ultcharge);
    MinWait();
    SetUltimateCharge(EventPlayer(), FirstOf(ultcharge));
}

rule: "91 enable guns when they have ammo"
Event.OngoingPlayer
if (currentmagazines > 0)

if (start == 1)
if (HeroOf(EventPlayer()) != Hero.Mei)
{
    SetPrimaryFireEnabled(EventPlayer(), true);

    SetSecondaryFireEnabled(EventPlayer(), XPUnlocked(5));
    AllowButton(EventPlayer(), Button.PrimaryFire);
    AllowButton(EventPlayer(), Button.SecondaryFire);
}

rule: "94 out of ammo moira"
Event.OngoingPlayer
Player.Moira
if (currentmagazines <= 0)
{
    SetSecondaryFireEnabled(EventPlayer(), false);
}

rule: "96 mercy disable gun if no ammo"
Event.OngoingPlayer
Team.Team1
Player.Mercy
if (magazines <= 0)
if (Weapon(EventPlayer()) == 2)
{
    SetWeapon(EventPlayer(), 1);
}

rule: "97 torb disable gun if no ammo"
Event.OngoingPlayer
Team.Team1
Player.Torbjorn
if (magazines <= 0)
if (Weapon(EventPlayer()) == 1)
{
    SetWeapon(EventPlayer(), 2);
}

rule: "103  remove less than zero issue on ammo"
Event.OngoingPlayer
if (currentmagazines < 0)
{
    currentmagazines = false;
}
