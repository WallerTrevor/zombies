if (doublemag == false)
{
    currentmagazines -= 1;
}

rule: "89 out of ammo"
Event.OngoingPlayer
# can just have an if else statement for specific heros
if (HeroOf(EventPlayer()) != Hero.Moira)
if (HeroOf(EventPlayer()) != Hero.Mercy)
if (HeroOf(EventPlayer()) != Hero.Reinhardt)
if (HeroOf(EventPlayer()) != Hero.Brigitte)
if (HeroOf(EventPlayer()) != Hero.Torbjorn)
if (HeroOf(EventPlayer()) != Hero.Mei)
if (IsDummyBot(EventPlayer()) == false)
if (currentmagazines <= 0)
{
    SetPrimaryFireEnabled(EventPlayer(), false);
    SetSecondaryFireEnabled(EventPlayer(), false);
    DisallowButton(EventPlayer(), Button.PrimaryFire);
    DisallowButton(EventPlayer(), Button.SecondaryFire);
}

rule: "90 initialize ammo amount"
Event.OngoingPlayer
{
    magazines[0] = 5;
    magazines[1] = 5;
    currentmagazines = FirstOf(magazines);
    currentswap = false;
    DisallowButton(EventPlayer(), Button.Crouch);
    ultcharge[0] = false;
    ultcharge[1] = false;
    MinWait();
    currentultcharge = FirstOf(ultcharge);
    MinWait();
    SetUltimateCharge(EventPlayer(), FirstOf(ultcharge));
}

rule: "91 enable guns when they have ammo"
Event.OngoingPlayer
if (currentmagazines > 0)
if (HeroOf(EventPlayer()) != Hero.Mei)
{
    SetPrimaryFireEnabled(EventPlayer(), true);
    SetSecondaryFireEnabled(EventPlayer(), true);
    AllowButton(EventPlayer(), Button.PrimaryFire);
    AllowButton(EventPlayer(), Button.SecondaryFire);
}

rule: "94 out of ammo moira"
