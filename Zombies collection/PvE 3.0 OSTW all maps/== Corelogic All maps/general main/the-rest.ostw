    StartFacing(EventPlayer(), DirectionTowards(EyePosition(EventPlayer()), EyePosition(FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), ArrayElement().p_T == false), DistanceBetween(EventPlayer(), ArrayElement()))))), 400, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
}

rule: "409 OMNIC Bots Attack if Near"
