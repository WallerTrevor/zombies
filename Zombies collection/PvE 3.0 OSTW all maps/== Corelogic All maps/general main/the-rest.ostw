rule: "68 player joined invincible"
Event.OnPlayerJoin
Team.Team1
if (HasSpawned(EventPlayer()) == true)
if (start == 1)
{
    SetStatus(EventPlayer(), null, Status.PhasedOut, 30);
    # eventPlayer.points = 500
    points2 = points;
    cashback = 1;
}

rule: "120  Remove bots when players join"
{
    if (NumberOfPlayers(Team.Team1) == 2)
    {
        for (botRemoveSlot = 14; botRemoveSlot <= 17; 1)
        {
            DestroyDummyBot(Team.Team2, botRemoveSlot);
        }
    }
    else if (NumberOfPlayers(Team.Team1) == 3)
    {
        for (botRemoveSlot = 10; botRemoveSlot <= 17; 1)
        {
            DestroyDummyBot(Team.Team2, botRemoveSlot);
        }
    }
    else if (NumberOfPlayers(Team.Team1) == 4)
    {
        for (botRemoveSlot = 8; botRemoveSlot <= 17; 1)
        {
            DestroyDummyBot(Team.Team2, botRemoveSlot);
        }
    }
}

rule: "anticrash on"
if (ServerLoadPeak() >= 150)
{
    SetSlowMotion(100 - (7 * ServerLoadPeak() - 150) / 105);
}

rule: "anticrash off"
if (ServerLoadPeak() < 150)
{
    SetSlowMotion(100);
}

disabled rule: "148 Remove bots ANTI CRASH"
if (ServerLoadAverage() >= null)
{
    for (botRemoveSlot = 17; botRemoveSlot >= 6; -1)
    {
        DestroyDummyBot(Team.Team2, botRemoveSlot);

        if (botRemoveSlot > 6)
        {
            Wait(0.25, WaitBehavior.AbortWhenFalse);
        }
    }
}

rule: "Toggle edit mode"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
{
    # @Disabled\ntoggle edit
    ToggleEdit = !ToggleEdit;
    # prevent spamming
    Wait(0.25, WaitBehavior.IgnoreCondition);
}

rule: "Enable edit mode"
Event.OngoingPlayer
Team.Team1
if (ToggleEdit == true)
{
    # @Disabled\nsetSlowMotion(10)\ncreateDummy(eventPlayer.getHero(), Team.1, getNumberOfPlayers(Team.1) + 1, eventPlayer, eventPlayer.getFacingDirection())\nstart noclipping from current position
    Noclip = EyePosition(EventPlayer());
    # disable controls
    SetAbility1Enabled(EventPlayer(), false);
    SetAbility2Enabled(EventPlayer(), false);
    SetPrimaryFireEnabled(EventPlayer(), false);
    SetSecondaryFireEnabled(EventPlayer(), false);
    SetUltimateAbilityEnabled(EventPlayer(), false);
    SetMeleeEnabled(EventPlayer(), false);
    SetJumpEnabled(EventPlayer(), false);
    # don't physically move
    SetMoveSpeed(EventPlayer(), false);
    # don't fall
    SetGravity(EventPlayer(), false);
    # make a camera from the noclip position and copy the player's facing direction
    StartCamera(EventPlayer(), Noclip, Noclip + FacingDirectionOf(EventPlayer()), 128);
    # take into account throttle, facing direction, jump, and crouch inputs to make a decent noclip  # chase the noclip's position
    ChaseVariableAtRate(Noclip, Noclip + (FacingDirectionOf(EventPlayer()) * ZOf(ThrottleOf(EventPlayer())) + WorldVectorOf(ThrottleOf(EventPlayer()) * Vector(true, false, false), EventPlayer(), LocalVector.Rotation) + Up() * (IsButtonHeld(EventPlayer(), Button.Jump) - IsButtonHeld(EventPlayer(), Button.Crouch))) * 100, 28, RateChaseReevaluation.DestinationAndRate);
    # wait for a bit so the player doesn't see where they are teleported to
    Wait(0.032, WaitBehavior.IgnoreCondition);
    # go to the sky
    Teleport(EventPlayer(), Vector(0, 10000, 0));
}

rule: "Disable edit mode"
Event.OngoingPlayer
Team.Team1
if (IsDummyBot(EventPlayer()) == false)
if (ToggleEdit == false)
{
    # @Disabled\nsetSlowMotion(100)
    DestroyDummyBot(Team.Team1, NumberOfPlayers(Team.Team1));
    # save some server load
    StopChasingVariable(Noclip);
    # subtract player's height from noclipPosition so that the camera is teleported to where the noclip camera was
    Teleport(EventPlayer(), Noclip - (EyePosition(EventPlayer()) - PositionOf(EventPlayer())));
    # return values to normal
    SetGravity(EventPlayer(), 100);
    SetMoveSpeed(EventPlayer(), 100);
    # enable controls
    SetAbility1Enabled(EventPlayer(), true);
    SetAbility2Enabled(EventPlayer(), true);
    SetPrimaryFireEnabled(EventPlayer(), true);
    SetSecondaryFireEnabled(EventPlayer(), true);
    SetUltimateAbilityEnabled(EventPlayer(), true);
    SetMeleeEnabled(EventPlayer(), true);
    SetJumpEnabled(EventPlayer(), true);
    SetUltimateCharge(EventPlayer(), 100);
    # player is back in world, can use native player camera
    StopCamera(EventPlayer());
    # cancel momentum
    ApplyImpulse(EventPlayer(), VelocityOf(EventPlayer()) * -1, SpeedOf(EventPlayer()), Relative.ToWorld, ContraryMotion.Incorporate);
}

