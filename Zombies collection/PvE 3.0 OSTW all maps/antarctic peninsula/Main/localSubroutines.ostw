import "index.ostw";

void getoutofspawn() "out of spawn subroutine"
{
    switch (setspawn)
    {
        case false:

            Teleport(EventPlayer(), Vector(-98.883, 8.939, 72.511));
            zone1();
            doorsNeedDrawing = true;
            break;

        case 1:

            Teleport(EventPlayer(), Vector(-80.097, 9.076, -73.528));
            zone1();
            doorsNeedDrawing = true;
            break;

        case 2:

            Teleport(EventPlayer(), Vector(185.785, 45.059, 176.924));
            zone2();
            doorsNeedDrawing = true;
            break;

        case 3:

            Teleport(EventPlayer(), Vector(349.006, 45.721, 180.954));
            zone2();
            doorsNeedDrawing = true;
            break;

        case 4:

            Teleport(EventPlayer(), Vector(211.903, -9.592, -237.573));
            zone3();
            doorsNeedDrawing = true;
            break;

        case 5:

            Teleport(EventPlayer(), Vector(354.448, -9.548, -232.832));
            zone3();
            doorsNeedDrawing = true;
            break;
    }
}

void zone1() "zone 1 subroutine"
{
    ForceSpawnRoom(Team.All, 1);
    telespot = 0;
    doorZoneStart = doorzone1count1;
    doorZoneEnd = doorzone1count2;
}

void zone2() "zone 2 subroutine"
{
    ForceSpawnRoom(Team.All, 0);
    telespot = 1;
    doorZoneStart = doorzone2count1;
    doorZoneEnd = doorzone2count2;
}

void zone3() "zone 3 subroutine"
{
    ForceSpawnRoom(Team.All, 2);
    telespot = 2;
    doorZoneStart = doorzone3count1;
    doorZoneEnd = doorzone3count2;
}
