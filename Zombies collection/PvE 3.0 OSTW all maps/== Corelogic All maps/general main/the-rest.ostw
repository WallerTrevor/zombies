rule: "410 OMNIC Bots Dont Attack if Not Near"
Event.OngoingPlayer
Team.Team2
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) >= 1.8)
if (IsFiringPrimary(EventPlayer()) == true)
if (IsUsingUltimate(EventPlayer()) == false)
{
    StopHoldingButton(EventPlayer(), Button.PrimaryFire);
