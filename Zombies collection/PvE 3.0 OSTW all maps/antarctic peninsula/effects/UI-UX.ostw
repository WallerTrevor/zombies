rule: "info UI cancel"
Event.OngoingPlayer
Team.Team1
if (start > 0)
{
    SkipIf(CountOf(InfoUI) == false, 5);
    DestroyHudText(InfoUI[CountOf(InfoUI) - 1]);
    ModifyVariable(InfoUI, Operation.RemoveFromArrayByIndex, CountOf(InfoUI) - 1);
    MinWait();
    LoopIf(CountOf(InfoUI) != 0);
    InfoCooldown = TotalTimeElapsed() + 5;
    Abort();
}

rule: "Info UI"
Event.OngoingPlayer
if (start == false)
{
    for (infoUIIndex = 0; CountOf(infoUIData); 1)
    {
        if (infoUIIndex > 0)
        {
            MinWait();
        }
        CreateHudText(EventPlayer(), null, infoUIData[infoUIIndex][0], infoUIData[infoUIIndex][1], Location.Left, infoUIData[infoUIIndex][2], null, infoUIData[infoUIIndex][3], infoUIData[infoUIIndex][4], HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
        ModifyVariable(InfoUI, Operation.AppendToArray, LastTextID());
    }
    InfoCooldown = TotalTimeElapsed() + 0.16;
    HideHints = true;
    UI = 1;
}

