void Subheroswap() "hero swap subroutine"
{
    PreloadHero(EventPlayer(), heroswap[FirstOf(swapvar)]);
    # need to switch this for overpy extended variables
    herohp[swapvar[1]] = Health(EventPlayer());
    ultcharge[swapvar[1]] = currentultcharge;
    abilitycooldown[swapvar[2]] = AbilityCooldown(EventPlayer(), Button.Ability1);
    abilitycooldown[swapvar[3]] = AbilityCooldown(EventPlayer(), Button.Ability2);
    abilitycooldown[swapvar[4]] = AbilityCooldown(EventPlayer(), Button.SecondaryFire);
    PressButton(EventPlayer(), Button.Reload);
    MinWait();
    magazines[swapvar[1]] = currentmagazines;
    currentswap = FirstOf(swapvar);
    MinWait();
    currentmagazines = magazines[FirstOf(swapvar)];
    currentultcharge = ultcharge[FirstOf(swapvar)];
}

void Subfollowerbuy() "follower subroutine"
{
    DestroyDummyBot(Team.Team1, SlotOf(EventPlayer()) + 4);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    CreateDummyBot(followerbuy, Team.Team1, SlotOf(EventPlayer()) + 4, Vector(0, 0, 0), Vector(0, 0, 0));
    Wait(0.03, WaitBehavior.IgnoreCondition);
    AttachPlayers(PlayersInSlot(SlotOf(EventPlayer()) + 4, Team.Team1), EventPlayer(), Vector(-0.5, 1.8, -0.2));
    Wait(0.1, WaitBehavior.IgnoreCondition);
    StartScalingPlayer(PlayersInSlot(SlotOf(EventPlayer()) + 4, Team.Team1), 0.2, true);
    StartModifyingHeroVoiceLines(FirstOf(SlotOf(EventPlayer())) + 4, 1.3, true);
}

void PaPsound() "PaP Sound subroutine"
{
    PlayEffect(AllPlayers(Team.All), PlayEffect.BaptisteBioticLauncherExplosionSound, Color.White, EventPlayer(), 80);
    Wait(0.2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

void wavespawn() "518 spawn bots subroutine"
{
    wavevoicecall();
    CreateDummyBot(bossSpawn[extraVar[4]], Team.Team2, 0, FirstOf(SpawnPoints(Team.Team2)), Vector(0, 0, 0));
    omnicspawn[0] = SlotOf(PlayersInSlot(0, Team.Team2));
    extraVar[27] = 0;
    ActiveEnemyIndex();
    Wait(0.5, WaitBehavior.AbortWhenFalse);
    setbotamount();
    for (forindex = 1; botamount + 1; 2)
    {
        CreateDummyBot(bot1spawn[extraVar[4]], Team.Team2, forindex, FirstOf(SpawnPoints(Team.Team2)), Vector(0, 0, 0));
        omnicspawn[forindex] = SlotOf(PlayersInSlot(forindex, Team.Team2));
        extraVar[27] = forindex;
        ActiveEnemyIndex();
        Wait(0.75, WaitBehavior.AbortWhenFalse);
        if (forindex + 1 <= botamount)
        {
            CreateDummyBot(bot2spawn[extraVar[4]], Team.Team2, forindex + 1, FirstOf(SpawnPoints(Team.Team2)), Vector(0, 0, 0));
            omnicspawn[forindex + 1] = SlotOf(PlayersInSlot(forindex + 1, Team.Team2));
            extraVar[27] = forindex + 1;
            ActiveEnemyIndex();
            Wait(0.75, WaitBehavior.AbortWhenFalse);
        }
    }
}

void totalrandomspawn() "each bot will be random"
{
    wavevoicecall();
    setbotamount();
    for (forindex = 0; botamount; 1)
    {
        extraVar[26] = etcArray[5][RandomInteger(0, 37)];
        CreateDummyBot(extraVar[26], Team.Team2, forindex, FirstOf(SpawnPoints(Team.Team2)), Vector(0, 0, 0));
        omnicspawn[forindex] = SlotOf(PlayersInSlot(forindex, Team.Team2));
        extraVar[27] = forindex;
        ActiveEnemyIndex();
        Wait(0.75, WaitBehavior.AbortWhenFalse);
    }
}

void wavevoicecall() "player voiceline call subroutine"
{
    Wait(9, WaitBehavior.AbortWhenFalse);
    Communicate(RandomValueInArray(AllLivingPlayers(Team.Team1)), Communication.Countdown);
    Wait(RandomReal(4.5, 5.5), WaitBehavior.AbortWhenFalse);
    Communicate(RandomValueInArray(AllLivingPlayers(Team.Team1)), Communication.Incoming);
    Wait(0.5, WaitBehavior.AbortWhenFalse);
}

void setbotamount() "set bot amount subroutine"
{
    # this needs to be done so that it hot swaps while players leave and join
    if (FirstOf(extraVar) < 5 + (NumberOfPlayers(Team.Team1) - 1) * 2)
    {
        botamount = 5 + FirstOf(extraVar);
    }
    else
    {
        botamount = 13 - (NumberOfPlayers(Team.Team1) - 1) * 2;
        if (botamount < 1)
        {
            botamount = 1;
        }
    }
}

void getoutofspawn() "out of spawn subroutine"
{
    # this can be a for loop and array that is outside of all maps, and map specific spawn points
    if (setspawn == false)
    {
        # zone 1 need to label which of these is which
        Teleport(EventPlayer(), Vector(-98.883, 8.939, 72.511));
        zone1();
        makedoors();
    }
    else if (setspawn == 1)
    {
        # zone 1-1
        Teleport(EventPlayer(), Vector(-80.097, 9.076, -73.528));
        zone1();
        makedoors();
    }
    else if (setspawn == 2)
    {
        # zone 2
        Teleport(EventPlayer(), Vector(185.785, 45.059, 176.924));
        zone2();
        makedoors();
    }
    else if (setspawn == 3)
    {
        # zone 2-1
        Teleport(EventPlayer(), Vector(349.006, 45.721, 180.954));
        zone2();
        makedoors();
    }
    else if (setspawn == 4)
    {
        # zone 3
        Teleport(EventPlayer(), Vector(211.903, -9.592, -237.573));
        zone3();
        makedoors();
    }
    else if (setspawn == 5)
    {
        # zone 3-1
        Teleport(EventPlayer(), Vector(354.448, -9.548, -232.832));
        zone3();
        makedoors();
    }
}

