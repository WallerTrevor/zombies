rule: "404 set challenge wave every few rounds"
if (chwaveinterval >= 4)
{
    challengewave = RandomInteger(0, 1);
    if (challengewave == 1)
    {
        chwaveinterval = false;
    }
}

rule: "235 the match timer in a game"
if (teamOutOfSpawn == true)
if (IsGameInProgress() == true)
{
    SetMatchTime(3599);
    UnpauseMatchTime();
    while (true)
    {
        Wait(3000, WaitBehavior.AbortWhenFalse);
        SetMatchTime(3599);
    }
}

rule: "leave spawn reminder"
if (start == 1)
if (teamOutOfSpawn == false)
{
    Wait(5, WaitBehavior.AbortWhenFalse);
    SmallMessage(FilteredArray(AllPlayers(Team.Team1), ArrayElement().outofpsawn == 0), "Leave the spawn room to start!");
}

