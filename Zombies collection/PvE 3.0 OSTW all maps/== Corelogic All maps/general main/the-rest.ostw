rule: "434 OMNIC WAVE BOSS roadhog use heal"
Event.OngoingPlayer
Team.Team2
Player.Roadhog
if (NormalizedHealth(EventPlayer()) <= 0.5)
{
    StartHoldingButton(EventPlayer(), Button.SecondaryFire);
    Wait(3, WaitBehavior.IgnoreCondition);
    StopHoldingButton(EventPlayer(), Button.SecondaryFire);
}



disabled rule: "15 Unstuck Bots(buggy effect)"
Event.OngoingPlayer
Team.Team2
if (IsInLineOfSight(EventPlayer(), FirstOf(AllLivingPlayers(Team.Team1)), BarrierLOS.NoBarriersBlock) == false)
if (IsAlive(EventPlayer()) == true)
if (IsInSpawnRoom(EventPlayer()) == false)
if ((HasStatus(EventPlayer(), Status.Hacked) || HasStatus(EventPlayer(), Status.KnockedDown) || HasStatus(EventPlayer(), Status.Frozen) || HasStatus(EventPlayer(), Status.Asleep) || !HasStatus(EventPlayer(), Status.Stunned)) == true)
{
    # @Condition distance(eventPlayer, getRealClosestPlayer(eventPlayer, Team.1)) > 2.5
    Wait(2.5, WaitBehavior.AbortWhenFalse);
    # eventPlayer.teleport(random.choice(Y))
    Teleport(EventPlayer(), NearestWalkablePosition(DirectionFromAngles(RandomReal(0, 360), RandomReal(-3, 3)) * RandomReal(20, 35) + PositionOf(FirstOf(AllLivingPlayers(Team.Team1)))));
    # loop()
    Wait(0.4, WaitBehavior.IgnoreCondition);
    CreateEffect(AllPlayers(Team.All), Effect.BadAura, Color.Black, EvaluateOnce(PositionOf(EventPlayer())) + Vector(0, 1.5, 0), 1, EffectRev.VisibleToPositionAndRadius);
    CreateEffect(AllPlayers(Team.All), Effect.GoodAuraSound, Color.White, EvaluateOnce(PositionOf(EventPlayer())), 100, EffectRev.VisibleToPositionAndRadius);
    Wait(4, WaitBehavior.IgnoreCondition);
    DestroyEffect(LastCreatedEntity());
    DestroyEffect(LastCreatedEntity());
}


rule: "9 Omnic Kill all powerups)"
Event.OnDeath
Team.Team2
if (roundnumber > 3)
{
    for (EventPlayer().powerupDropIndex = 0; 6; 1)
    {
        if (SlotOf(EventPlayer()) == EventPlayer().powerupDropIndex || (SlotOf(EventPlayer()) == 1 && numberOfZombies < 6 && EventPlayer().powerupDropIndex == 2))
        {
            if (EventPlayer().powerupDropIndex == 2)
            {
                if (RandomInteger(1, 50) == 1)
                {
                    M[EventPlayer().powerupDropIndex] = NearestWalkablePosition(EventPlayer()) + Vector(0, 0.5, 0);
                }
            }
            else if (RandomInteger(1, 75) == 1)
            {
                M[EventPlayer().powerupDropIndex] = NearestWalkablePosition(EventPlayer()) + Vector(0, 0.5, 0);
            }
            SetUltimateCharge(EventPlayer(), 0);
        }
    }
}

rule: "50 is hacked"
Event.OngoingPlayer
Team.Team2
if (HasStatus(EventPlayer(), Status.Hacked) == true)
{
    SetMoveSpeed(EventPlayer(), 0);
    SetPrimaryFireEnabled(EventPlayer(), false);
    SetStatus(EventPlayer(), null, Status.Burning, 4);
    StartDamageOverTime(EventPlayer(), null, 10, 60);
    DisallowButton(EventPlayer(), Button.Jump);
    Wait(4, WaitBehavior.IgnoreCondition);
    SetMoveSpeed(EventPlayer(), 100);
    SetPrimaryFireEnabled(EventPlayer(), true);
}

rule: "118  Omnic Kill (Global Var B) ALL SLOTS"
Event.OnDeath
Team.Team2
{
    # this is probably causing constant infinite ult perk
    B = RandomInteger(1, 50);
    SkipIf(B != 1, 1);
    M[0] = NearestWalkablePosition(EventPlayer()) + Vector(0, 0.5, 0);
    SetUltimateCharge(EventPlayer(), 0);
    Wait(0.2, WaitBehavior.IgnoreCondition);
    numberOfZombies -= 1;
    SkipIf(numberOfZombies < NumberOfLivingPlayers(Team.Team2), 1);
    Respawn(EventPlayer());
}

rule: "436 OMNIC set features ALL"
Event.OngoingPlayer
Team.Team2
if (SlotOf(EventPlayer()) != PlayersInSlot(0, Team.Team2))
if (HasSpawned(EventPlayer()) == true)
{
    StartModifyingHeroVoiceLines(EventPlayer(), 0.5, true);

    switch (HeroOf(EventPlayer()))
    {
        case Hero.Roadhog:
            StartScalingPlayer(EventPlayer(), 0.6, true);
            break;

        case Hero.Lucio:
            StartScalingPlayer(EventPlayer(), 0.4, true);
            break;

        case Hero.Dva:
            StartScalingPlayer(EventPlayer(), 0.7, true);
            DisallowButton(EventPlayer(), Button.PrimaryFire);
            break;

        case Hero.WreckingBall:
            StartScalingPlayer(EventPlayer(), 0.65, true);
            Wait(2.5, WaitBehavior.IgnoreCondition);
            PressButton(EventPlayer(), Button.Ability1);
            break;

        case Hero.Orisa:
        case Hero.Sigma:
        case Hero.Mauga:
            StartScalingPlayer(EventPlayer(), 0.65, true);
            break;

        case Hero.Torbjorn:
            StartScalingPlayer(EventPlayer(), 1.5, true);
            break;

        case Hero.Winston:
            StartScalingPlayer(EventPlayer(), 0.5, true);
            StartModifyingHeroVoiceLines(EventPlayer(), 1.5, true);
            break;
    }
}

rule: "519 Spawn wave director"
# @Condition getPlayers(Team.1).hasSpawned() == true also needs a 3, for directors cut version, where each hero is on for 5 rounds then changes using a loop
if (roundnumber >= 1)
if (numberOfZombies >= 4)
if (IsGameInProgress() == true)
{
    switch (spawntype)
    {
        case false:
            g = false;
            # needs a lot more types as well, since there will be the new addition, random, and legacy from 1.0
            bossSpawn = [null];
            # needs a way to make it so more than 1 wave boss can be spawned at once as well
            bot1spawn = [Hero.Brigitte];
            # need to make it so wave boss doesnt respawn after being killed
            bot2spawn = [Hero.Brigitte];
            # and need wave boss to spawn a 2nd or 3rd one if players are doing well
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 1:
            g = false;
            Wait(0.25, WaitBehavior.IgnoreCondition);
            bossSpawn = [null];
            bot1spawn = [Hero.Torbjorn];
            bot2spawn = [Hero.Torbjorn];
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 2:
            g = false;
            Wait(0.25, WaitBehavior.IgnoreCondition);
            if (roundnumber < 5)
            {
                bossSpawn = null;
                bot1spawn = hero[RandomInteger(0, 37)];
                bot2spawn = hero[RandomInteger(0, 37)];
                Wait(0.25, WaitBehavior.IgnoreCondition);
                wavespawn();
            }
            else if (roundnumber >= 5)
            {
                bossSpawn = hero[RandomInteger(0, 37)];
                bot1spawn = hero[RandomInteger(0, 37)];
                bot2spawn = hero[RandomInteger(0, 37)];
                Wait(0.25, WaitBehavior.IgnoreCondition);
                wavespawn();
            }
            break;

        case 3:
            bossSpawn = [null, Hero.Doomfist, Hero.Torbjorn, Hero.Reinhardt, Hero.Winston, Hero.Roadhog, Hero.JunkerQueen, Hero.Zenyatta, Hero.Mauga, Hero.Sombra, Hero.Mei, Hero.Reaper, Hero.Ramattra];
            bot1spawn = [Hero.Brigitte, Hero.Torbjorn, Hero.Torbjorn, Hero.Moira, Hero.Lucio, Hero.Torbjorn, Hero.Roadhog, Hero.Moira, Hero.Lucio, Hero.Mercy, Hero.JunkerQueen, Hero.Tracer, Hero.Doomfist];
            bot2spawn = [Hero.Brigitte, Hero.Brigitte, Hero.Reinhardt, Hero.Winston, Hero.Genji, Hero.Winston, Hero.Genji, Hero.Brigitte, Hero.Hanzo, Hero.Mauga, Hero.Dva, Hero.Echo, Hero.Sombra];
            Wait(0.25, WaitBehavior.IgnoreCondition);
            wavespawn();
            break;

        case 4:
            Wait(0.25, WaitBehavior.IgnoreCondition);
            totalrandomspawn();
            break;
    }
}

rule: "wave director incramenter"
if (spawntype == 3)
if (roundnumber > 1)
# incrament every 3 rounds
if (roundnumber / 3 == RoundToInteger(roundnumber / 3, Rounding.Down))
{
    if (g >= 12)
    {
        g = 0;
    }
    else
    {
        g += 1;
    }
}

disabled rule: "559 stop throttle omnics"
Event.OngoingPlayer
Team.Team2
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 1.75)
{
    StopForcingThrottle(EventPlayer());
}

rule: "use ability loop"
Event.OngoingPlayer
Team.Team2
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), EventPlayer())))) < 10)
{
    for (idx = 0; 10; 1)
    {
        abilityFlag = abilityTable[hero[rrentEnemyIndex] * 10 * Difficulty + idx];
        if (abilityFlag > 0)
        {
            PressButton(EventPlayer(), buttons[abilityFlag - 1]);
        }
        Wait(1, WaitBehavior.IgnoreCondition);
    }
}

rule: "408 OMNIC Bots Face Nearest Player"
