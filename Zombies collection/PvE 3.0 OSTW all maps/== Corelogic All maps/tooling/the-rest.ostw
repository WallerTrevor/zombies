disabled rule: "289 Imperial warmech set attacks"
Event.OngoingPlayer
Team.Team2
Player.Dva
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
if (IsAlive(EventPlayer()) == true)
{
    Major_Attacks = RandomInteger(2, 6);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    if (Major_Attacks == 2)
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactSound, Color.White, EyePosition(EventPlayer()), 200);
        PlayEffect(AllPlayers(Team.All), PlayEffect.WreckingBallPiledriverImpactEffect, Color.White, PositionOf(EventPlayer()), 1);
        Wait(0.75, WaitBehavior.IgnoreCondition);
        CreateDummyBot(Hero.Pharah, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        MinWait();
        SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
        AttachPlayers(LastCreatedEntity(), EventPlayer(), Vector(0, 5, 0));
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
        Wait(7, WaitBehavior.IgnoreCondition);
        LoopIfConditionIsTrue();
    }
    else if (Major_Attacks == 3)
    {
        CreateDummyBot(Hero.Zarya, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        MinWait();
        SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
        AttachPlayers(LastCreatedEntity(), EventPlayer(), Vector(0, 2, 0));
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()) + Vector(RandomInteger(-1, 1), 0, 0), 1000, Relative.ToPlayer, FacingRev.DirectionAndTurnRate);
        Wait(7, WaitBehavior.IgnoreCondition);
        LoopIfConditionIsTrue();
    }
    else if (Major_Attacks == 4)
    {
        CreateDummyBot(Hero.Sojourn, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        MinWait();
        SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
        AttachPlayers(LastCreatedEntity(), EventPlayer(), Vector(0, 5, 0));
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
        Wait(7, WaitBehavior.IgnoreCondition);
        LoopIfConditionIsTrue();
    }
    else if (Major_Attacks == 5)
    {
        CreateDummyBot(Hero.Moira, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        MinWait();
        SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
        AttachPlayers(LastCreatedEntity(), EventPlayer(), Vector(0, 4, 0));
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
        Wait(7, WaitBehavior.IgnoreCondition);
        LoopIfConditionIsTrue();
    }
    else if (Major_Attacks == 6)
    {
        CreateDummyBot(Hero.Junkrat, Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        MinWait();
        SetStatus(LastCreatedEntity(), null, Status.PhasedOut, 9999);
        AttachPlayers(LastCreatedEntity(), EventPlayer(), Vector(0, 4, -1));
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
        Wait(7, WaitBehavior.IgnoreCondition);
        LoopIfConditionIsTrue();
    }
}

