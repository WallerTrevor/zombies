Team.Team1
if (DistanceBetween(EventPlayer(), M[5]) <= 1.5)
if (AllPlayers(Team.Team1).G[5] == false)
if (roundnumber >= 1)
{
    M[5] = Vector(500, 25, 500);
    AllPlayers(Team.Team1).G[5] = true;
    AllPlayers(Team.Team1).S[5] = 1;
    AllLivingPlayers(Team.Team1).magazines += 10;
    BigMessage(AllPlayers(Team.All), "Max ammo!");
    Wait(3, WaitBehavior.IgnoreCondition);
    AllPlayers(Team.Team1).G[5] = false;
    AllPlayers(Team.Team1).S[5] = false;
}

rule: "143 DIFFICULTY damage resistance"
Event.OngoingPlayer
Team.Team1
if (HasSpawned(EventPlayer()) == true)
{
    switch (Difficulty)
    {
        case 1:
            # needs to be changed if i introduce armor
            SetDamageReceived(EventPlayer(), 25);
            break;

        case 2:
            SetDamageReceived(EventPlayer(), 50);
            break;

        case 3:
            SetDamageReceived(EventPlayer(), 100);
            break;

        case 4:
            SetDamageReceived(EventPlayer(), 200);
            break;
    }
}

rule: "159 workshop setting explosive rounds(could add a cheats menu somewhere)"
Event.OnDamageDealt
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.PrimaryFire) == true)
if (WorkshopSettingToggle("fun", "explosive rounds", false, 0) == true)
{
    Damage(PlayersWithinRadius(Victim(), 3, Team.Team2, RadiusLOS.Off), Attacker(), 300);
    PlayEffect(AllPlayers(Team.All), PlayEffect.GoodExplosion, Color.Red, Victim(), 3);
    Wait(0.45, WaitBehavior.IgnoreCondition);
}

rule: "191 Trap logic"
if (trapeffect == true)
{
    CreateDummyBot(Hero.Bastion, Team.Team1, 12, Vector(-86.342, -150.729, 39.793), Vector(0, 0, 0));
    omnicspawn[18] = SlotOf(PlayersInSlot(12, Team.Team1));
    CreateDummyBot(Hero.Bastion, Team.Team1, 13, Vector(-82.277, -150.687, 80.335), Vector(0, 0, 0));
    omnicspawn[19] = SlotOf(PlayersInSlot(13, Team.Team1));
    StartHoldingButton(PlayersInSlot(12, Team.Team1), Button.PrimaryFire);
    Wait(0.25, WaitBehavior.IgnoreCondition);
    PlayersInSlot(12, Team.Team1).p_T = 1;
    PlayersInSlot(13, Team.Team1).p_T = 1;
    PressButton(PlayersInSlot(12, Team.Team1), Button.Ability1);
    PressButton(PlayersInSlot(13, Team.Team1), Button.Ability1);
    StartHoldingButton(PlayersInSlot(13, Team.Team1), Button.PrimaryFire);
    Wait(20, WaitBehavior.IgnoreCondition);
    DestroyDummyBot(Team.Team1, omnicspawn[18]);
    DestroyDummyBot(Team.Team1, omnicspawn[19]);
}


rule: "299 out of bounce boundry"
