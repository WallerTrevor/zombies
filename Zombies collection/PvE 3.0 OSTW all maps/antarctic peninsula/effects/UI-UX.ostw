rule: "toggle perk info"
Event.OngoingPlayer
Team.Team1
if (perkinfo == false)
if (IsButtonHeld(EventPlayer(), Button.Jump) == true)
{
    Wait(2, WaitBehavior.AbortWhenFalse);
    perkinfo = 1;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    perkinfo = 2;
    Wait(7, WaitBehavior.IgnoreCondition);
    perkinfo = 1;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    perkinfo = false;
}

rule: "perk info expanded"
Event.OngoingPlayer
Team.Team1
if (perkinfo == 2)
{
    for (i = 0; CountOf(Perkui); 1)
    {
        CreateHudText(EventPlayer(), <"<0>", perkicon[i]>, "Perk", "Perk info:", Location.Left, 3, perkcolor[i], perkcolor[i], Color.White, HudTextRev.VisibleTo, Spectators.DefaultVisibility);
        ModifyVariable(Perkui, Operation.AppendToArray, LastTextID());
    }
    for (i = 0; 3 - (CountOf(Perkui) - 1); 1)
    {
        # this adds blank lines if less than 4 perks
        CreateHudText(EventPlayer(), null, "\n", null, Location.Left, 3, Color.Green, Color.SkyBlue, Color.White, HudTextRev.VisibleTo, Spectators.DefaultVisibility);
        ModifyVariable(Perkui, Operation.AppendToArray, LastTextID());
    }
}

rule: "perk delete"
Event.OngoingPlayer
Team.Team1
if (perkinfo == 1)
{
    DestroyHudText(Perkui[CountOf(Perkui) - 1]);
    ModifyVariable(Perkui, Operation.RemoveFromArrayByIndex, CountOf(Perkui) - 1);
    MinWait();
    LoopIf(CountOf(Perkui) != 0);
    Abort();
}

