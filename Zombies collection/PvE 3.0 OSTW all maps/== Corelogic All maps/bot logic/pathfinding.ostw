Number ZombieBaseSpeed(): roundnumber <= 6 ? 80 + 8 * roundnumber : 128;

rule: "137  bots too far away"
Event.OngoingPlayer
Team.Team2
if (zombieTargetDistance > 90)

if (IsAlive(EventPlayer()) == true)

if (IsInSpawnRoom(EventPlayer()) == false)

if (IsBossBot(EventPlayer()) == false)
{

    Wait(6 + SlotOf(EventPlayer()) * 0.032, WaitBehavior.AbortWhenFalse);

    Teleport(EventPlayer(), FirstOf(SpawnPoints(Team.Team2)));

    pfDestination = null;
    zombieMode = ZombieMode.Idle;
    StopThrottleInDirection(EventPlayer());
}

rule: "402 Omnic movespeed + health"
Event.OngoingPlayer
Team.Team2
if (HasSpawned(EventPlayer()) == true)
{
    SetMaxHealth(EventPlayer(), 15 * roundnumber);
    SetMoveSpeed(EventPlayer(), ZombieBaseSpeed());
}

rule: "Zombie AI settings and server load gate"
{

    Wait(3, WaitBehavior.IgnoreCondition);
    zombieLoadLimit = WorkshopSettingInteger("Pathfinding", "Server load limit for zombie AI extras", 200, 50, 250, 0);
    zombiePathfindSetting = WorkshopSettingToggle("Pathfinding", "Zombies pathfind when stuck or you are above them", true, 1);
    zombieRunFasterSetting = WorkshopSettingToggle("Pathfinding", "Zombies run faster when far away", true, 2);
    zombieExtrasAllowed = true;

    while (true)
    {
        if (zombieExtrasAllowed)
        {
            if (ServerLoadAverage() > zombieLoadLimit || ServerLoad() > zombieLoadLimit + 60)
            {
                zombieExtrasAllowed = false;
            }
        }
        else if (ServerLoadAverage() < zombieLoadLimit - 30 && ServerLoad() < zombieLoadLimit)
        {
            zombieExtrasAllowed = true;
        }
        Wait(0.5, WaitBehavior.IgnoreCondition);
    }
}

rule: "Zombie chase: reset when a zombie spawns"
Event.OngoingPlayer
Team.Team2
if (IsAlive(EventPlayer()) == true)
{
    zombieMode = ZombieMode.Idle;
    zombieModeSince = TotalTimeElapsed();
    zombieStuckChecks = 0;
    zombieAboveChecks = 0;
    zombieBusy = false;
    zombieAppliedSpeed = 0;
    pfSpeedFactor = 1;
    pfDestination = null;
    pfSavedTarget = null;
    pfIsPathfinding = false;
    pfCurrentNodeIndex = -1;
    pfWalkingToPosition = null;
    pfStuckOnNode = 0;

    StopThrottleInDirection(EventPlayer());

    zombieTargetDistance = 9999;
}

rule: "Zombie chase: straight at you, pathfinding only when stuck or you are above"
Event.OngoingPlayer
Team.Team2
if (IsAlive(EventPlayer()) == true)

if (IsInSpawnRoom(EventPlayer()) == false)

if (IsBossPart(EventPlayer()) == false)
{

    zombieTarget = FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.Team1), ArrayElement().p_T == 0), DistanceBetween(EventPlayer(), ArrayElement())));
    if (zombieTarget == null)
    {
        zombieTarget = FirstOf(SortedArray(AllLivingPlayers(Team.Team1), DistanceBetween(EventPlayer(), ArrayElement())));
    }
    zombieTargetDistance = zombieTarget == null ? 9999 : DistanceBetween(EventPlayer(), zombieTarget);
    if (zombieTarget == null)
    {
        pfDestination = null;
        zombieMode = ZombieMode.Idle;
        StopThrottleInDirection(EventPlayer());
    }
    else
    {
        zombieFlatDistance = DistanceBetween(PositionOf(EventPlayer()) * Vector(1, 0, 1), PositionOf(zombieTarget) * Vector(1, 0, 1));
        zombieHeightDifference = YOf(PositionOf(zombieTarget)) - YOf(PositionOf(EventPlayer()));
        if (zombieMode == ZombieMode.Pathfinding)
        {

            zombieCloseEnough = AbsoluteValue(zombieHeightDifference) < 1.2 && (zombieFlatDistance < 3 || TotalTimeElapsed() - zombieModeSince > 3 && IsInLineOfSight(PositionOf(EventPlayer()) + Up(), PositionOf(zombieTarget) + Up(), BarrierLOS.NoBarriersBlock));
            zombieWantsPath = zombiePathfindSetting && pfMapReady && !zombieCloseEnough && TotalTimeElapsed() - zombieModeSince < 20 && ServerLoad() < zombieLoadLimit + 60;
        }
        else
        {

            if (HorizontalSpeedOf(EventPlayer()) < 1.5 && zombieFlatDistance > 3 && !zombieBusy && IsOnGround(EventPlayer()) && !HasStatus(EventPlayer(), Status.Frozen) && !HasStatus(EventPlayer(), Status.Stunned) && !HasStatus(EventPlayer(), Status.KnockedDown) && !HasStatus(EventPlayer(), Status.Asleep) && !HasStatus(EventPlayer(), Status.Hacked))
            {
                zombieStuckChecks += 1;
            }
            else
            {
                zombieStuckChecks = 0;
            }

            if (AbsoluteValue(zombieHeightDifference) > 1.8)
            {
                zombieAboveChecks += 1;
            }
            else
            {
                zombieAboveChecks = 0;
            }
            zombieWantsPath = zombiePathfindSetting && pfMapReady && zombieExtrasAllowed && TotalTimeElapsed() - zombieModeSince > 1.5 && (zombieStuckChecks >= 3 || zombieAboveChecks >= 2);
        }
        if (zombieWantsPath)
        {
            if (zombieMode != ZombieMode.Pathfinding)
            {
                zombieMode = ZombieMode.Pathfinding;
                zombieModeSince = TotalTimeElapsed();
                pfLookAtDestination();
            }

            pfDestination = PositionOf(zombieTarget);
        }
        else
        {
            if (zombieMode != ZombieMode.Straight)
            {
                zombieMode = ZombieMode.Straight;
                zombieModeSince = TotalTimeElapsed();
                zombieStuckChecks = 0;
                zombieAboveChecks = 0;
                pfDestination = null;
                StartFacing(EventPlayer(), DirectionTowards(EyePosition(EventPlayer()), EyePosition(zombieTarget)), 400, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
            }
            if (!pfIsPathfinding)
            {
                StartThrottleInDirection(EventPlayer(), DirectionTowards(PositionOf(EventPlayer()), PositionOf(zombieTarget)), 1, Relative.ToWorld, ThrottleBehavior.ReplaceExistingThrottle, ThrottleRev.DirectionAndMagnitude);
            }
        }

        zombieSpeedBoost = zombieRunFasterSetting ? 1 + Min(Max(zombieFlatDistance - 15, 0) * 0.04, 0.6) : 1;
        zombieSpeedBoost = RoundToInteger(zombieSpeedBoost * 10, Rounding.Down) / 10;
        if (!zombieBusy && ZombieBaseSpeed() * zombieSpeedBoost != zombieAppliedSpeed)
        {
            zombieAppliedSpeed = ZombieBaseSpeed() * zombieSpeedBoost;
            pfSpeedFactor = zombieAppliedSpeed / 100;
            SetMoveSpeed(EventPlayer(), zombieAppliedSpeed);
        }
    }
    Wait(zombieExtrasAllowed ? 0.25 : 0.5, WaitBehavior.AbortWhenFalse);
    LoopIfConditionIsTrue();
}

rule: "Zombie stop moving when dead"
Event.OngoingPlayer
Team.Team2
if (IsDead(EventPlayer()) == true)
{
    pfDestination = null;
    zombieMode = ZombieMode.Idle;
    StopThrottleInDirection(EventPlayer());
}

rule: "【PF Decompress】Decompress map"
if (pfDecompress == true)
{
    pfMapReady = false;

    pfcompressionTable = <" <0>", decodeTable>;
    pfLoadedMap_nodes = [];
    pfLoadedMap_neighbors = [];

    for (pfI1 = 0; CountOf(FirstOf(pfDecompress)); 1)
    {
        for (pfI2 = 0; StringLength(FirstOf(pfDecompress)[pfI1]); 6)
        {
            pfLoadedMap_nodes = Append(pfLoadedMap_nodes, Vector((PfDigit(FirstOf(pfDecompress)[pfI1], pfI2) * 1024 + PfDigit(FirstOf(pfDecompress)[pfI1], pfI2 + 1) - 524288) / 100, (PfDigit(FirstOf(pfDecompress)[pfI1], pfI2 + 2) * 1024 + PfDigit(FirstOf(pfDecompress)[pfI1], pfI2 + 3) - 524288) / 100, (PfDigit(FirstOf(pfDecompress)[pfI1], pfI2 + 4) * 1024 + PfDigit(FirstOf(pfDecompress)[pfI1], pfI2 + 5) - 524288) / 100));

            if (!(pfI2 % 24))
            {
                LoadingPause();
            }
        }
    }

    pfdecompressionState = 0;
    pfcurrentNeighbors = [];
    for (pfI1 = 0; CountOf(pfDecompress[1]); 1)
    {
        for (pfI2 = 0; StringLength(pfDecompress[1][pfI1]); 1)
        {
            pfnext = PfDigit(pfDecompress[1][pfI1], pfI2);

            if (pfdecompressionState == 0)
            {

                if (!pfnext)
                {
                    pfLoadedMap_neighbors = Append(pfLoadedMap_neighbors, [pfcurrentNeighbors]);
                    pfcurrentNeighbors = [];
                }
                else
                {
                    pfdecompressionState = 1;
                    pfcurrentNeighbors = Append(pfcurrentNeighbors, [[pfnext - 1, []]]);
                }
            }
            else if (pfdecompressionState == 1)
            {

                if (!pfnext)
                {
                    pfdecompressionState = 0;
                }
                else
                {
                    pfcurrentNeighbors[CountOf(pfcurrentNeighbors) - 1] = [FirstOf(LastOf(pfcurrentNeighbors)), Append(LastOf(pfcurrentNeighbors)[1], pfnext - 1)];
                }
            }
            if (!(pfI2 % 20))
            {
                LoadingPause();
            }
        }
        LoadingPause();
    }

    pfNodeComponent = [];
    for (pfI1 = 0; CountOf(pfLoadedMap_nodes); 1)
    {
        pfNodeComponent = Append(pfNodeComponent, PfDigit(pfDecompress[3][RoundToInteger(pfI1 / 42, Rounding.Down)], pfI1 % 42 * 3 + 2));
        if (!(pfI1 % 20))
        {
            LoadingPause();
        }
    }
    pfNodeIndices = MappedArray(pfLoadedMap_nodes, CurrentArrayIndex());

    pfComponentNodes = [];
    for (pfI1 = 0; LastOf(SortedArray(pfNodeComponent, ArrayElement())) + 1; 1)
    {
        pfComponentNodes[pfI1] = FilteredArray(pfNodeIndices, pfNodeComponent[ArrayElement()] == pfI1);
        LoadingPause();
    }

    pfMapReady = true;
}

Number PfDigit(String text, Number position): IndexOfStringChar(pfcompressionTable, CharInString(text, position));

void pfUpdateNodeMeta() "【PF Core Subroutine】☞ Update node meta"
{
    pfStartTime = TotalTimeElapsed();
    pfWalkingFromPosition = PositionOf(EventPlayer());
}

void pfWalkToDestination() "☆【PF Core Subroutine】☞ Walk to destination"
{
    StartThrottleInDirection(EventPlayer(), DirectionTowards(PositionOf(EventPlayer()), pfCurrentNodeIndex == -1 ? pfDestination : pfLoadedMap_nodes[pfCurrentNodeIndex]), DistanceBetween(PositionOf(EventPlayer()), pfCurrentNodeIndex == -1 ? pfDestination : pfLoadedMap_nodes[pfCurrentNodeIndex]) > 0.4 && (pfCurrentNodeIndex != -1 || !(!pfSavedTarget || DistanceBetween(pfDestination, pfSavedTarget) > 5)), Relative.ToWorld, ThrottleBehavior.ReplaceExistingThrottle, ThrottleRev.DirectionAndMagnitude);
}

rule: "【PF Core】Update & Execute"
Event.OngoingPlayer
if (pfDestination == true)
if ((!pfSavedTarget || DistanceBetween(pfDestination, pfSavedTarget) > 5) == true)
{

    if (!pfMapReady)
    {
        WaitUntil(pfMapReady, 99999);
    }

    Wait(RandomReal(0, 0.3), WaitBehavior.IgnoreCondition);
    pfSavedTarget = pfDestination;

    if (!pfIsPathfinding || pfCurrentNodeIndex == -1)
    {
        pfCurrentNodeIndex = FirstOf(SortedArray(ArraySlice(SortedArray(pfNodeIndices, DistanceBetween(pfLoadedMap_nodes[ArrayElement()], PositionOf(EventPlayer()))), 0, 5), !IsInLineOfSight(pfLoadedMap_nodes[ArrayElement()] + Vector(0, 2, 0), PositionOf(EventPlayer()) + Vector(0, 2, 0), BarrierLOS.NoBarriersBlock)));
    }

    pfGoalNode = FirstOf(SortedArray(ArraySlice(SortedArray(pfComponentNodes[pfNodeComponent[pfCurrentNodeIndex]], DistanceBetween(pfLoadedMap_nodes[ArrayElement()], pfSavedTarget)), 0, 5), !IsInLineOfSight(pfLoadedMap_nodes[ArrayElement()] + Vector(0, 2, 0), pfSavedTarget + Vector(0, 2, 0), BarrierLOS.NoBarriersBlock)));
    pfIsPathfinding = true;
    pfWalkingToPosition = pfLoadedMap_nodes[pfCurrentNodeIndex];
    pfUpdateNodeMeta();
    pfWalkToDestination();
    Wait(2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

void pfReadNextHopChar() "【PF Core Subroutine】☞ Read next hop char"
{

    pfHopChar = PfDigit(pfDecompress[2][RoundToInteger(pfHopPosition / 128, Rounding.Down)], pfHopPosition % 128);
}

void pfLookupNextHop() "【PF Core Subroutine】☞ Look up next hop (Floyd-Warshall, RLE base 1024)"
{

    pfHopPosition = PfDigit(pfDecompress[3][RoundToInteger(pfCurrentNodeIndex / 42, Rounding.Down)], pfCurrentNodeIndex % 42 * 3) * 1024 + PfDigit(pfDecompress[3][RoundToInteger(pfCurrentNodeIndex / 42, Rounding.Down)], pfCurrentNodeIndex % 42 * 3 + 1);

    pfHopRemaining = pfGoalNode;
    pfHopRuns = 0;
    pfReadNextHopChar();
    while (pfHopRemaining > pfHopChar % 128)
    {
        pfHopRemaining -= pfHopChar % 128 + 1;
        pfHopPosition += 1;
        pfReadNextHopChar();
        pfHopRuns += 1;
        if (pfHopRuns % 25 == 0)
        {
            MinWait();
        }
    }
    pfHopSlot = RoundToInteger(pfHopChar / 128, Rounding.Down);
}

void pfProgressEventPlayer() "【PF Core Subroutine】☞ Progress event player"
{
    if (pfCurrentNodeIndex == pfGoalNode)
    {

        pfAttributes = [];
        pfCurrentNodeIndex = -1;
    }
    else
    {
        pfLookupNextHop();
        if (pfHopSlot >= CountOf(pfLoadedMap_neighbors[pfCurrentNodeIndex]))
        {
            LogToInspector(<"Pathfinder <0>: no path from node <1> to node <2>.", EventPlayer(), pfCurrentNodeIndex, pfGoalNode>);
            pfAttributes = [];
            pfCurrentNodeIndex = -1;
        }
        else
        {
            pfPreviousNode = pfCurrentNodeIndex;
            pfCurrentNodeIndex = FirstOf(pfLoadedMap_neighbors[pfPreviousNode][pfHopSlot]);

            pfAttributes = FirstOf(FilteredArray(pfLoadedMap_neighbors[pfCurrentNodeIndex], FirstOf(ArrayElement()) == pfPreviousNode))[1];
        }
    }

    pfWalkingToPosition = pfCurrentNodeIndex == -1 ? pfDestination : pfLoadedMap_nodes[pfCurrentNodeIndex];
    pfUpdateNodeMeta();
}

void pfRecalibrate() "【PF Core Subroutine】☞ Recalibrate"
{
    StopThrottleInDirection(EventPlayer());
    pfCurrentNodeIndex = -1;
    pfSavedTarget = null;
    pfIsPathfinding = false;
}

rule: "【PF Core】Watch progress (checked every 4 ticks)"
Event.OngoingPlayer
if (pfIsPathfinding == true)
{

    pfIsStuck = false;
    pfSlowSince = 0;
    while (pfIsPathfinding)
    {
        if (pfWalkingToPosition && pfCurrentNodeIndex != -1 && DistanceBetween(PositionOf(EventPlayer()) * Vector(1, 0, 1), pfWalkingToPosition * Vector(1, 0, 1)) <= 0.6 * Max(pfSpeedFactor, 1) && AbsoluteValue(YOf(PositionOf(EventPlayer())) - YOf(pfWalkingToPosition)) <= 1.5)
        {

            pfProgressEventPlayer();
        }
        else if (pfWalkingToPosition && DistanceBetween((pfWalkingFromPosition + pfWalkingToPosition) / 2, EventPlayer()) > (DistanceBetween(pfWalkingFromPosition, pfWalkingToPosition) + 4) * 1.2)
        {

            pfRecalibrate();
        }

        if (!pfWalkingToPosition || MagnitudeOf(VelocityOf(EventPlayer())) >= 3)
        {
            pfSlowSince = 0;
            pfIsStuck = false;
        }
        else if (!pfSlowSince)
        {
            pfSlowSince = TotalTimeElapsed();
        }
        else if (TotalTimeElapsed() - pfSlowSince > 2.1)
        {
            pfIsStuck = true;
        }
        Wait(0.064, WaitBehavior.IgnoreCondition);
    }
}

rule: "【PF Core】Stop throttle when pfDestination is reset"
Event.OngoingPlayer
if (pfIsPathfinding == true)
if (pfDestination == null)
{
    StopThrottleInDirection(EventPlayer());
    pfIsPathfinding = false;
    pfSavedTarget = null;
    pfCurrentNodeIndex = -1;
}

rule: "【PF Core】Insurance"
Event.OngoingPlayer
if (pfIsPathfinding == true)
if (pfWalkingToPosition == true)
{

    if (pfCurrentNodeIndex == pfGoalNode && DistanceBetween(EventPlayer(), pfSavedTarget) < DistanceBetween(pfWalkingToPosition, pfSavedTarget) && IsInLineOfSight(PositionOf(EventPlayer()) + Vector(0, 0.25, 0), pfSavedTarget + Vector(0, 0.25, 0), BarrierLOS.NoBarriersBlock))
    {
        pfProgressEventPlayer();
    }
    else if (pfWalkingToPosition != pfDestination && pfCurrentNodeIndex == -1 && DistanceBetween(pfSavedTarget, pfDestination) < 5 && IsInLineOfSight(pfSavedTarget + Up(), pfDestination + Up(), BarrierLOS.NoBarriersBlock))
    {
        pfWalkingToPosition = pfDestination;
    }
    else if (DistanceBetween(EventPlayer(), pfWalkingToPosition) > 0.4 && !(!pfSavedTarget || DistanceBetween(pfDestination, pfSavedTarget) > 5) && (pfIsStuck || DistanceBetween(pfWalkingFromPosition, pfWalkingToPosition) - 4.95 * (TotalTimeElapsed() - pfStartTime) < 0) && !HasStatus(EventPlayer(), Status.Rooted) && !HasStatus(EventPlayer(), Status.Frozen) && !HasStatus(EventPlayer(), Status.Asleep) && !HasStatus(EventPlayer(), Status.KnockedDown) && !HasStatus(EventPlayer(), Status.Stunned))
    {

        if (pfStuckOnNode - 2 == pfCurrentNodeIndex)
        {
            LogToInspector(<"Pathfinder <0> struggled to reach node <1> at <2>. Try adjusting your map in the editor.", EventPlayer(), pfCurrentNodeIndex, pfLoadedMap_nodes[pfCurrentNodeIndex]>);
            Teleport(EventPlayer(), pfWalkingToPosition);
        }
        else
        {
            pfStuckOnNode = pfCurrentNodeIndex + 2;
            pfRecalibrate();
        }
    }
    Wait(2, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

void pfLookAtDestination() "☆【PF Core Subroutine】☞ Look at destination"
{

    StartFacing(EventPlayer(), DirectionTowards(EyePosition(EventPlayer()) * (DistanceBetween(PositionOf(EventPlayer()), pfWalkingToPosition) < 3 ? Vector(1, 0, 1) : Vector(1, 1, 1)), (pfWalkingToPosition + Vector(0, 1.5, 0)) * (DistanceBetween(PositionOf(EventPlayer()), pfWalkingToPosition) < 3 ? Vector(1, 0, 1) : Vector(1, 1, 1))), 500, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
}
