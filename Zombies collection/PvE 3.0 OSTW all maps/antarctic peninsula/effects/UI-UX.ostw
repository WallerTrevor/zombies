rule: "settings page initial control"
Event.OngoingPlayer
if (start != 1)
{
    # could probably use a if-then-else here unless double if doesnt work with this
    if (start == false)
    {
        if (IsButtonHeld(EventPlayer(), Button.Melee))
        {
            start = 2;
        }
        else if (start == 2)
        {
            if (IsButtonHeld(EventPlayer(), Button.Crouch))
            {
                start = false;
            }
        }
    }
}