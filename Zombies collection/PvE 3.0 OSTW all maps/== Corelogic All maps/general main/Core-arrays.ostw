void LoadCoreData() "load core data"
{

    decodeTable = "";
    for (decodeString = 0; CountOf(import("Core-compressed.json").alphabet); 1)
    {
        decodeTable = <"<0><1>", decodeTable, import("Core-compressed.json").alphabet[decodeString]>;
    }

    for (decodeString = 0; 18; 1)
    {
        infoText[decodeString] = StringSlice(decodeTable, 62 + decodeString * 50, 40);
    }

    LoadingPause();

    decodeIn = Unpack(import("Core-compressed.json").difficulty.table);
    decompressNSub();
    difficultyTable = decodeOut;
    difficultyStats = ArraySlice(difficultyTable, Difficulty * 6 - 6, 6);

    decodeIn = Unpack(import("Core-compressed.json").bankTiers.Cost);
    decompressNSub();
    bankTiers = [];
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        bankTiers += [{Cost: decodeOut[decodeIndex], InterestRate: 0}];
    }
    decodeIn = Unpack(import("Core-compressed.json").bankTiers.InterestRate);
    decompressNSub();
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        bankTiers[decodeIndex].InterestRate = decodeOut[decodeIndex];
    }

    decodeIn = Unpack(import("Core-compressed.json").creditCardTiers.Cost);
    decompressNSub();
    creditCardTiers = [];
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        creditCardTiers += [{Cost: decodeOut[decodeIndex], Limit: 0, Cashback: 1, InterestRate: 0}];
    }
    decodeIn = Unpack(import("Core-compressed.json").creditCardTiers.Limit);
    decompressNSub();
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        creditCardTiers[decodeIndex].Limit = decodeOut[decodeIndex];
    }
    decodeIn = Unpack(import("Core-compressed.json").creditCardTiers.Cashback);
    decompressNSub();
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        creditCardTiers[decodeIndex].Cashback = decodeOut[decodeIndex];
    }
    decodeIn = Unpack(import("Core-compressed.json").creditCardTiers.InterestRate);
    decompressNSub();
    for (decodeIndex = 0; CountOf(decodeOut); 1)
    {
        creditCardTiers[decodeIndex].InterestRate = decodeOut[decodeIndex];
    }

    textPairTable = import("Core-compressed.json").textPairs;
    textPad = StringSlice(FirstOf(textPairTable), 0, 1);
    decodeIn = Unpack(import("Core-compressed.json").twoDnumbersArray.herobuycosts);
    decompressNSub();
    herobuycosts = decodeOut;

    decodeIn = Unpack(import("Core-compressed.json").counters.heroType);
    decompressNSub();
    counterHeroType = decodeOut;
    decodeIn = Unpack(import("Core-compressed.json").counters.typeChart);
    decompressNSub();
    counterChart = decodeOut;

    romanN = ["0", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "", "0", "00110001", "00110010", "00110011", "00110100", "00110101", "00110110", "00110111", "00111000", "00111001"];
}

rule: "load text and hero lists"
{

    Wait(3, WaitBehavior.IgnoreCondition);

    hero = [Hero.Lucio, Hero.Hanzo, Hero.Zenyatta, Hero.Soldier76, Hero.Mercy, Hero.Pharah, Hero.Junkrat, Hero.Symmetra, Hero.Doomfist, Hero.Baptiste, Hero.Bastion, Hero.Reaper, Hero.Genji, Hero.Ashe, Hero.Zarya, Hero.Roadhog, Hero.Dva, Hero.Brigitte, Hero.Reinhardt, Hero.Torbjorn, Hero.Sigma, Hero.Orisa, Hero.Moira, Hero.Mei, Hero.Anran, Hero.Mauga, Hero.Sojourn, Hero.Sombra, Hero.Tracer, Hero.Widowmaker, Hero.Winston, Hero.WreckingBall, Hero.Echo, Hero.Freja, Hero.Hazard, Hero.Illari, Hero.JunkerQueen, Hero.Lifeweaver, Hero.Juno, Hero.Kiriko, Hero.Ana, Hero.Venture, Hero.Cassidy, Hero.Ramattra, Hero.Domina, Hero.Emre, Hero.JetpackCat, Hero.Mizuki, Hero.Vendetta, Hero.Wuyang];
