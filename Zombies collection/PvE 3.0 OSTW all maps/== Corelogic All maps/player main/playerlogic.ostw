rule: "163 heal over time effect solo"
Event.OnDamageTaken
Team.Team1
if (AllLivingPlayers(Team.Team1) == true)
if (NumberOfPlayers(Team.Team1) == 1)
{
    if (NumberOfPlayers(Team.Team1) == 1)
    {
        # need to disable built in health regen as well
        StopHealOverTime(healovertime);
        Wait(5, WaitBehavior.RestartWhenTrue);
        StartHealOverTime(EventPlayer(), EventPlayer(), 3, 4 * healvariable);
        healovertime = LastHealOverTime();
    }
    else if (NumberOfPlayers(Team.Team1) > 1)
    {
        StopHealOverTime(healovertime);
        Wait(5, WaitBehavior.RestartWhenTrue);
        StartHealOverTime(EventPlayer(), EventPlayer(), 3, 4 * healvariable);
        healovertime = LastHealOverTime();
    }
}

