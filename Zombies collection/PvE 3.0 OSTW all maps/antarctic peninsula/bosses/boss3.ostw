import "../Main/index.ostw";

disabled rule: "283 Imperial warmech setup ================================================"
Event.OngoingPlayer
Team.Team2
Player.Dva
if (Bosssequencer == 3)
{
    CreateDummyBot(Hero.Dva, Team.Team2, 0, Vector(-80.776, -159.164, 59.549), Vector(0, 0, 0));
    omnicspawn[0] = SlotOf(PlayersInSlot(0, Team.Team2));
    # Imperial warmech
    SetKnockbackReceived(EventPlayer(), 0);
    SetMoveSpeed(EventPlayer(), 100);
    SetDamageDealt(EventPlayer(), 200);
    StartScalingPlayer(EventPlayer(), 3, true);
    StartForcingDummyBotName(EventPlayer(), "Imperial warmech ");
    Wait(3, WaitBehavior.IgnoreCondition);
    EventPlayer().warmachParts = [
        [Hero.WreckingBall, Vector(0, 6.1, 1), "Cannon"],
        [Hero.WreckingBall, Vector(2.15, 5.4, 1), "Cannon"],
        [Hero.WreckingBall, Vector(-2.15, 5.4, 1), "Cannon"],
        [Hero.Bastion, Vector(2, 3, 1), "Machine gun"],
        [Hero.Bastion, Vector(-2, 3, 1), "Machine gun"]
    ];
    for (EventPlayer().warmachPartIndex = 0; CountOf(EventPlayer().warmachParts); 1)
    {
        CreateDummyBot(EventPlayer().warmachParts[EventPlayer().warmachPartIndex][0], Team.Team2, -1, EventPlayer(), Vector(0, 0, 0));
        Wait(1, WaitBehavior.IgnoreCondition);
        AttachPlayers(LastCreatedEntity(), FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), EventPlayer().warmachParts[EventPlayer().warmachPartIndex][1]);
        LastCreatedEntity().Part = EventPlayer().warmachParts[EventPlayer().warmachPartIndex][2];
        if (EventPlayer().warmachPartIndex == 4)
        {
            AddHealthPoolToPlayer(EventPlayer(), HealthType.Armor, 9999, true, true);
        }
        StartFacing(LastCreatedEntity(), FacingDirectionOf(EventPlayer()), 1000, Relative.ToWorld, FacingRev.DirectionAndTurnRate);
        if (EventPlayer().warmachPartIndex < 4)
        {
            MinWait();
        }
    }
    WaitUntil(IsDead(EventPlayer()), 99999);
    RemoveAllHealthPoolsFromPlayer(EventPlayer());
}

disabled rule: "284 Cannon stats"
Event.OngoingPlayer
Team.Team2
Player.WreckingBall
if (Part == "Cannon")
{
    SetHealingReceived(EventPlayer(), 0);
    SetMaxHealth(EventPlayer(), 500);
    StartForcingDummyBotName(EventPlayer(), "Homing Cannon");
    Wait(0.35, WaitBehavior.IgnoreCondition);
    WaitUntil(IsDead(EventPlayer()), 99999);
    SetStatus(PlayersWithinRadius(EventPlayer(), 5, TeamOf(EventPlayer()), RadiusLOS.Off), null, Status.Stunned, 2);
}

disabled rule: "285 Cannon shoot"
Event.OngoingPlayer
Team.Team2
Player.WreckingBall
if (IsButtonHeld(FirstOf(PlayersOnHero(Hero.Dva, Team.Team2)), Button.PrimaryFire) == true)
{
    CreateHomingProjectile(ProjectileType.SigmaHypersphere, EventPlayer(), null, null, Relative.ToWorld, ModifyHealthType.Damage, OppositeTeamOf(TeamOf(EventPlayer())), 75, 0, 5, PlayEffect.BastionTankCannonExplosionEffect, PlayEffect.BastionTankCannonExplosionSound, 0.1, 30, 5, 5, FirstOf(SortedArray(FilteredArray(AllLivingPlayers(OppositeTeamOf(TeamOf(EventPlayer()))), HasSpawned(ArrayElement()) && ArrayElement() != EventPlayer()), AngleBetweenVectors(FacingDirectionOf(EventPlayer()), ArrayElement() - EyePosition(EventPlayer())))), 0.5);
    PlayEffect(AllPlayers(Team.All), PlayEffect.CassidyFlashbangExplosionSound, Color.White, EyePosition(EventPlayer()), 100);
    PlayEffect(AllPlayers(Team.All), PlayEffect.BadExplosion, Color.Gray, EventPlayer(), 2);
    Wait(1, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

disabled rule: "286 Machine gun stats"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (IsDummyBot(EventPlayer()) == true)
if (Part == "Machine gun")
{
    SetDamageDealt(EventPlayer(), 100);
    StartScalingPlayer(EventPlayer(), 1.25, true);
    SetMaxHealth(EventPlayer(), 1000);
    StartForcingDummyBotName(EventPlayer(), "Machine gun");
    ForceThrottle(EventPlayer(), 1, 1, 0, 1, 0, 1);
    Wait(0.35, WaitBehavior.IgnoreCondition);
    WaitUntil(IsDead(EventPlayer()), 99999);
    SetStatus(PlayersWithinRadius(EventPlayer(), 5, TeamOf(EventPlayer()), RadiusLOS.Off), null, Status.Stunned, 2);
}

disabled rule: "287 Machine gun keep form"
Event.OngoingPlayer
Team.Team2
Player.Bastion
if (IsUsingAbility1(EventPlayer()) == false)
if (IsDummyBot(EventPlayer()) == true)
{
    SetAbilityCooldown(EventPlayer(), Button.Ability1, 0);
    PressButton(EventPlayer(), Button.Ability1);
    Wait(0.25, WaitBehavior.IgnoreCondition);
