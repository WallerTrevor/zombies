rule: "23 Initiate Health, Damage, and Healing Variables"
Event.OngoingPlayer
Team.Team1
# outdated rule need new variable names and more variables here for all perks
if (HasSpawned(EventPlayer()) == true)
if (healthmax == false)
{
    healthmax = 50;
    damagevariable = 100;
    healvariable = 100;
}

rule: "55  starting hero set"
Event.OnPlayerJoin
{
    ForcePlayerHero(EventPlayer(), Hero.Cassidy);
}

rule: "58  Single player lives mechanic"
Event.OnDeath
Team.Team1
if (NumberOfPlayers(Team.Team1) == 1)
if (singlelives < 3)
{
    Resurrect(EventPlayer());
    Wait(0.05, WaitBehavior.IgnoreCondition);
    SetStatus(EventPlayer(), null, Status.KnockedDown, 2);
    SetStatus(EventPlayer(), null, Status.PhasedOut, 10);
    singlelives += 1;
}

rule: "DAMAGE Melee does more damage"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Melee) == true)
{
    Wait(0.05, WaitBehavior.IgnoreCondition);
    SetDamageDealt(EventPlayer(), 350);
    # the reason this is toggled, is to allow a few frames before the melee animation starts, so the damage can be applied
    AllowButton(EventPlayer(), Button.Melee);
    PressButton(EventPlayer(), Button.Melee);
    Wait(0.5, WaitBehavior.IgnoreCondition);
    SetDamageDealt(EventPlayer(), damagevariable);
    # i did try a direct set damage, but it was not working, so this is the best way to do it, as it allows the damage to be applied only for melee attacks
    DisallowButton(EventPlayer(), Button.Melee);
}

rule: "67 solo play mode effect"
Event.OnPlayerJoin
Team.Team1
if (NumberOfPlayers(Team.Team1) < 2)
if (extraVar[3] == 1)
{
    # might make this a perk that the player can buy, instead of just having
    Wait(15, WaitBehavior.IgnoreCondition);
    AbortIfConditionIsFalse();
    BigMessage(AllPlayers(Team.All), "SOLO MODE: YOU NOW HAVE 3 LIVES TOTAL");
}

rule: "switch between 2 heros (needs ultimates, followers, ammo, systems working)"
Event.OngoingPlayer
Team.Team1
if (IsButtonHeld(EventPlayer(), Button.Crouch) == true)
if (IsAlive(EventPlayer()) == true)
{
    if (ServerLoad() < 245)
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearSound, Color.White, EventPlayer(), 200);
        RemoveAllHealthPoolsFromPlayer(EventPlayer());
        if (currentswap == false)
        {
            swapvar = [1, 0, 0, 1, 2];
            MinWait();
            Subheroswap();
        }
        else if (currentswap == 1)
        {
            swapvar = [0, 1, 3, 4, 5];
            MinWait();
            Subheroswap();
        }
        ForcePlayerHero(EventPlayer(), heroswap[currentswap]);
        SetPlayerHealth(EventPlayer(), herohp[FirstOf(swap)]);
        SetAbilityCooldown(EventPlayer(), Button.Ability1, abilitycooldown[swap[2]]);
        SetAbilityCooldown(EventPlayer(), Button.Ability2, abilitycooldown[swap[3]]);
        SetAbilityCooldown(EventPlayer(), Button.SecondaryFire, abilitycooldown[swap[4]]);
        SetUltimateCharge(EventPlayer(), currentultcharge);
        MinWait();
        AttachPlayers(PlayersInSlot(SlotOf(EventPlayer()) + 4, Team.Team1), EventPlayer(), Vector(-0.5, 1.8, -0.2));
        Wait(0.1, WaitBehavior.IgnoreCondition);
        PlayEffect(AllPlayers(Team.All), PlayEffect.MoiraFadeDisappearEffect, Color.White, EventPlayer(), 1);
        Wait(1, WaitBehavior.IgnoreCondition);
    }
    else
    {
        SmallMessage(EventPlayer(), <"<0> Error: <1> Not on my watch! (--ANTICRASHSYS--)", HeroIconString(Hero.Ramattra), RandomInteger(10, 1000)>);
        Wait(6, WaitBehavior.IgnoreCondition);
    }
}

rule: "18 Get out of Spawn"
Event.OngoingPlayer
Team.Team1
# need to make sure this doesnt conflict with soft restart\n@Condition eventPlayer.isInSpawnRoom() == true
if (outofpsawn == 1)
{
    Wait(1, WaitBehavior.IgnoreCondition);
    getoutofspawn();
}


rule: "gain points on final blow"
Event.OnFinalBlow
Team.Team1
if (ArrayContains([Hero.Venture, Hero.Mauga, Hero.Sigma], HeroOf(EventPlayer())) == true)
if (Packapunch >= 1)
if ((IsUsingAbility1(EventPlayer()) || IsUsingAbility2(EventPlayer()) || IsUsingUltimate(EventPlayer()) || IsFiringPrimary(EventPlayer()) || IsFiringSecondary(EventPlayer()) || IsMeleeing(EventPlayer())) == true)
{
    if (HeroOf(Attacker()) == Hero.Venture)
    {
        if (IsMeleeing(EventPlayer()))
        {
            PlayEffect(AllPlayers(Team.All), PlayEffect.GoodExplosion, Color.Blue, Victim(), 5);
            Damage(PlayersWithinRadius(Victim(), 5, Team.All, RadiusLOS.Off), Attacker(), 800);
        }
    }
    else if (HeroOf(Attacker()) == Hero.Mauga)
    {
        SetAbilityCooldown(EventPlayer(), Button.Ability1, 0);
        SetAbilityCooldown(EventPlayer(), Button.Ability2, 0);
    }
    else if (HeroOf(Attacker()) == Hero.Sigma)
    {
        points += 50;
    }
}

