rule: "create barricade effect"
# and globalSpawnNetworkDirty == 1
if (extraVar[3] == 1)
if (CountOf(extraVar[65]) > null)
{
    # destroy previous effects if any
    for (botspawnindex = 0; CountOf(extraVar[67]); true)
    {
        # Destroying the old visual entities first prevents stale breach effects from lingering after the network changes to a new set of pathfinding nodes.
        DestroyEffect(extraVar[67][botspawnindex]);
    }
    # Reset the effect handle list to match the newly selected breach state.
    extraVar[67] = [];
    # Reset health values alongside the effects so each breach starts with its current network state instead of leftover values from the previous area.
    extraVar[68] = [];
    for (botspawnindex = 0; CountOf(extraVar[65]); true)
    {
        # Each chosen pathfinding node becomes one visible breach marker for the current area.
        extraVar[44] = extraVar[65][botspawnindex];
        ModifyVariable(extraVar[68], Operation.AppendToArray, 100);
        # effect color indicates health (start green)\nGreen indicates a healthy breach that is still intact and not yet weakened by zombie spawn attempts.
        extraVar[53] = Append(Append(ArraySlice(extraVar[53], false, botspawnindex), [CustomColor(0, 255, 0, 255)]), ArraySlice(extraVar[53], botspawnindex + true, 999999999999));
        # The aura effect is placed slightly above the node so it visually marks the breach location as a barricade / window.
        CreateEffect(AllPlayers(Team.All), Effect.BadAura, extraVar[53][botspawnindex], extraVar[44] + 1.5 * Up(), true, EffectRev.VisibleToAndColor);
        ModifyVariable(extraVar[67], Operation.AppendToArray, LastCreatedEntity());
        # The audio effect keeps the breach readable as a clear point of interest even when the visual effect is replaced.
        CreateEffect(AllPlayers(Team.All), Effect.BadAuraSound, Color.White, extraVar[44], 50, EffectRev.VisibleToAndColor);
        ModifyVariable(extraVar[67], Operation.AppendToArray, LastCreatedEntity());
    }
}


rule: "barricade repair by players"
Event.OngoingPlayer
Team.Team1
if (IsAlive(EventPlayer()) == true)
if (IsButtonHeld(EventPlayer(), Button.Reload) == true)
if (IsTrueForAny(extraVar[65], [DistanceBetween(ArrayElement(), EventPlayer()) < 2]) == true)
{
    # repair amount per tick (per check)
    extraVar[54] = 25;
    for (botspawnindex = 0; CountOf(extraVar[65]); true)
    {
        if (botspawnindex < CountOf(extraVar[68]))
        {
            extraVar[44] = extraVar[65][botspawnindex];
            extraVar[55] = extraVar[68][botspawnindex];
            extraVar[68] = Append(Append(ArraySlice(extraVar[68], false, botspawnindex), [Min(100, extraVar[68][botspawnindex] + extraVar[54])]), ArraySlice(extraVar[68], botspawnindex + true, 999999999999));
            if (extraVar[68][botspawnindex] != extraVar[55])
            {
                extraVar[56] = extraVar[68][botspawnindex];
                if (extraVar[56] <= null)
                {
                    extraVar[53] = Append(Append(ArraySlice(extraVar[53], false, botspawnindex), [Color.Black]), ArraySlice(extraVar[53], botspawnindex + true, 999999999999));
                }
                else
                {
                    # use floating-point arithmetic; rgb() will handle the rounding
                    extraVar[57] = extraVar[56] / 100;
                    extraVar[53] = Append(Append(ArraySlice(extraVar[53], false, botspawnindex), [CustomColor(255 * (true - extraVar[57]), 255 * extraVar[57], 0, 255)]), ArraySlice(extraVar[53], botspawnindex + true, 999999999999));
                }
            }
        }
    }
}

rule: "get nearest nodes for spawning"
if (extraVar[3] == 1)
if ((extraVar[47] == null || DistanceBetween(extraVar[47], FirstOf(SortedArray(FilteredArray(AllLivingPlayers(Team.All), HasSpawned(ArrayElement())), DistanceBetween(ArrayElement(), PositionOf(teamPlayers[botspawnindex]))))) > 10) == true)
{
    # This gathers the current living attackers so the breach network can follow where the team is actually fighting.
    teamPlayers = AllLivingPlayers(Team.Team1);
    # Reset the average before calculating it again.\nWe start from zero so the team center can be computed from the sum of player positions instead of reusing stale data.
    extraVar[47] = Left() + Right();
    # Calculate the average position of all living players.
    for (botspawnindex = 0; CountOf(teamPlayers); true)
    {
        ModifyVariable(extraVar[47], Operation.Add, PositionOf(teamPlayers[botspawnindex]));
    }
    # Dividing by the player count produces the center of the squad, which is what the pathfinding search uses to choose breach nodes.
    ModifyVariable(extraVar[47], Operation.Divide, CountOf(teamPlayers));
    extraVar[59] = FilteredArray(pfLoadedMap_nodes, DistanceBetween(extraVar[47], ArrayElement()) < 35);
    # Select up to 8 unique random nodes.\nResetting the breach list means each recalculation creates a fresh set of active breach nodes for the current area.
    extraVar[65] = [];
    # Keeping only eight active breaches prevents the map from becoming crowded with too many simultaneous spawn points.
    extraVar[60] = 8;
    # This guarantees we never try to select more breach nodes than the graph actually has available.
    extraVar[61] = Min(CountOf(extraVar[59]), extraVar[60]);
    for (botspawnindex = 0; extraVar[61]; true)
    {
        # Randomizing the chosen nodes keeps the network varied and avoids a fixed, predictable row of breaches.
        extraVar[62] = RandomValueInArray(extraVar[59]);
        ModifyVariable(extraVar[65], Operation.AppendToArray, extraVar[62]);
        ModifyVariable(extraVar[59], Operation.RemoveFromArrayByValue, extraVar[62]);
    }
}

