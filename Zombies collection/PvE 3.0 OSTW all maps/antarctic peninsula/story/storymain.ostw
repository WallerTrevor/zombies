import "../Main/index.ostw";

rule: "starting voice lines"
if (start == 1)
{
    Wait(14, WaitBehavior.IgnoreCondition);
    cutscene = true;
    Character_Nr = 0;
    Wait(SlotOf(LocalPlayer()) * 0.16, WaitBehavior.IgnoreCondition);
    CreateHudText(LocalPlayer(), HeroIconString(Hero.Ramattra), null, <"­\n<0>", StringSlice(Dialogue_Text, 0, Character_Nr)>, Location.Top, 2, Color.White, Color.White, Color.Orange, HudTextRev.VisibleToAndString, Spectators.DefaultVisibility);
    ModifyVariable(hudappend, Operation.AppendToArray, LastTextID());
    Wait(10, WaitBehavior.IgnoreCondition);
    for (i = 0; CountOf(hudappend); 1)
    {
        DestroyHudText(hudappend[i]);
    }
    cutscene = false;
}

rule: "set dialogue text"
if (start == 1)
{
    Wait(3, WaitBehavior.IgnoreCondition);
    if (dialogueLines[startlines][1] == null)
    {
        Dialogue_Text = dialogueLines[startlines][0];
    }
    else
    {
        Dialogue_Text = <"<0><1><2>", dialogueLines[startlines][0], RandomInteger(100, 9999), dialogueLines[startlines][1]>;
    }
}

rule: "Dialogue - Text scrolling Function"
if (cutscene == true)
{
    Character_Nr += 1;
    if (!(Character_Nr % 3))
    {
        PlayEffect(AllPlayers(Team.All), PlayEffect.SombraTranslocatorReappearSound, FirstOf(AllPlayers(Team.All)), EyePosition(FirstOf(AllPlayers(Team.All))), 100);
    }
    Wait(ArrayContains([".", "!", "?", "-"], CharInString(Dialogue_Text, Character_Nr)) ? 0.35 : 0.05, WaitBehavior.IgnoreCondition);
    WaitUntil(Character_Nr <= StringLength(Dialogue_Text), 99999);
    LoopIfConditionIsTrue();
}