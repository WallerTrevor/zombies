rule: "global bank interest gain every round"
if (numberOfZombies <= 0)
if (bankPoints > 0)
if (start == 1)
{
    Wait(0.16, WaitBehavior.IgnoreCondition);
    bankPoints += bankPoints * bankTiers[bankTier].InterestRate;
}

rule: "global bank tier upgrade"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), bankButtons[BankButton.Upgrade]) < 1)
if (bankTier < bankTiers.Length - 1)
{

    if (bankPoints >= bankTiers[bankTier + 1].Cost)
    {
        bankPoints -= bankTiers[bankTier + 1].Cost;
        bankTier += 1;
        SmallMessage(AllPlayers(Team.All), <"You have permanently upgraded your bank to tier <0>", bankTier>);
        PlayEffect(AllPlayers(Team.All), PlayEffect.BuffExplosionSound, Color.White, EventPlayer(), 70);
    }
    else
    {
        SmallMessage(AllPlayers(Team.All), <"You need <0> points in the bank to upgrade!", bankTiers[bankTier + 1].Cost>);
    }
}

Number BankStepSize(Number firstAmount): TotalTimeElapsed() - bankHoldStart < 2 ? firstAmount : (TotalTimeElapsed() - bankHoldStart < 5 ? 1000 : 10000);

void ShowBankedPoints()
{
    StopChasingVariable(points2);
    points2 = points;
}

rule: "global bank withdraw button"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), bankButtons[BankButton.Withdraw]) < 1)
{

    WaitUntil(ServerLoad() < 230, 3);
    bankHoldStart = TotalTimeElapsed();

    while (bankPoints > 0)
    {

        bankStep = Min(BankStepSize(250), bankPoints);
        bankPoints -= bankStep;
        points += bankStep;
        ShowBankedPoints();
        if (withdrawNotif == 0)
        {
            withdrawNotif = 1;
        }
        Wait(0.25, WaitBehavior.AbortWhenFalse);
    }
    SmallMessage(EventPlayer(), "The bank is out of funds!");
}

rule: "global bank deposit button"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), bankButtons[BankButton.Deposit]) < 1)
{

    WaitUntil(ServerLoad() < 230, 3);
    bankHoldStart = TotalTimeElapsed();

    while (points > 0)
    {

        bankStep = Min(BankStepSize(200), points);
        bankPoints += bankStep;
        points -= bankStep;
        ShowBankedPoints();
        if (depNotif == 0)
        {
            depNotif = 1;
        }
        Wait(0.25, WaitBehavior.AbortWhenFalse);
    }
    SmallMessage(EventPlayer(), "You don't have enough points to deposit!");
}

rule: "property damage easter egg"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), bankButtons[BankButton.PropertyDamage]) < 1)
{
    SmallMessage(EventPlayer(), <"<0> You have caused $<1> damage to my army!", HeroIconString(Hero.Ramattra), ramPoints>);
}

rule: "credit card system"
Event.OngoingPlayer
if (IsButtonHeld(EventPlayer(), Button.Interact) == true)
if (IsAlive(EventPlayer()) == true)
if (DistanceBetween(EventPlayer(), bankButtons[BankButton.CreditCardOffice]) < 1)
if (creditTier < creditCardTiers.Length - 1)
{

    WaitUntil(ServerLoad() < 230, 3);

    if (points >= creditCardTiers[creditTier + 1].Cost)
    {
        points -= creditCardTiers[creditTier + 1].Cost;
        ChaseVariableAtRate(points2, EvaluateOnce(points), 1000, RateChaseReevaluation.DestinationAndRate);
        creditTier += 1;
        creditcardlimit = creditCardTiers[creditTier].Limit;
        cashback = creditCardTiers[creditTier].Cashback;
        SmallMessage(EventPlayer(), <"Your credit card is now tier <0>", creditTier>);
        Wait(4, WaitBehavior.IgnoreCondition);
        SmallMessage(EventPlayer(), "Hold spacebar to see credit card details");
    }
    else if (creditTier == 0)
    {
        SmallMessage(EventPlayer(), <"You need <0> points buy a credit card!", creditCardTiers[1].Cost>);
    }
    else
    {
        SmallMessage(EventPlayer(), <"You need <0> points to upgrade!", creditCardTiers[creditTier + 1].Cost>);
    }
}

rule: "credit card interest"
Event.OngoingPlayer
if (points < 0)
if (numberOfZombies < 1)
if (creditTier > 0)
if (IsAlive(EventPlayer()) == true)
{
    ccInterest = points * creditCardTiers[creditTier].InterestRate;
    points += ccInterest;
    ChaseVariableAtRate(points2, EvaluateOnce(points), 1000, RateChaseReevaluation.DestinationAndRate);
    SmallMessage(EventPlayer(), <"You have incurred <0> interest on your credit card.", ccInterest>);
}

rule: "Reset deposit notif"
Event.OngoingPlayer
if (depNotif == 1)
{
    SmallMessage(EventPlayer(), <"Hold <0> to deposit: 200 at a time, then 1,000, then 10,000", InputBindingString(Button.Interact)>);
    Wait(4, WaitBehavior.IgnoreCondition);
    depNotif = 0;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "Reset withdraw notif"
Event.OngoingPlayer
if (withdrawNotif == 1)
{
    SmallMessage(EventPlayer(), <"Hold <0> to withdraw: 250 at a time, then 1,000, then 10,000", InputBindingString(Button.Interact)>);
    Wait(4, WaitBehavior.IgnoreCondition);
    withdrawNotif = 0;
    Wait(0.5, WaitBehavior.IgnoreCondition);
    LoopIfConditionIsTrue();
}

rule: "56  points loss for high roller"
Event.OnDeath
Team.Team1
{
    bankPoints += points * 0.2;
    points -= points * 0.3;
    points = RoundToInteger(points, Rounding.Up);
}
